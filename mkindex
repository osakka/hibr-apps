#!/usr/bin/env hibr
#
# mkindex -- rebuild index.json and index.html from what is in bundles/.
#
#   ./mkindex
#
# The index is derived, never written by hand: every field in it is read out
# of the bundle it describes, so the catalogue cannot drift from the code it
# offers. The title is the file's own `dt_app`, `cp_pane`, `cs_module` or
# `sv_saver` line, the summary is its `app` line, the prose under that is
# its header comment -- the same words the desktop's About box derives
# from -- and the sha256 is of the bundle as it will be fetched.
#
# The **kind** is the folder the bundle sits in, which `addapp` took from
# the scan root the source lived in. It is not guessed from what the file
# registers: an application and one of the desktop's own `system/` apps
# both register with `dt_app`, so nothing inside the file can tell them
# apart.
#
# The version is the thing's own, declared where it says what it is, and
# read out of the bundle like every other field (Gitea #218). A bundle's
# path is stable and holds the current version only: git is where a
# previous one lives, since nothing that installs has git and `apps
# install` cannot ask for an older version anyway (Gitea #230).

set -u

HERE=${BASH_SOURCE%/*}
[ -n "$HERE" ] || HERE=.
KINDS="apps system control-panel control-strip savers themes colours lang mods"
# The release whose desktop first looks in `$XDG_DATA_HOME/hibr/<kind>` for
# a theme, a colour scheme or a language. See the `hibr` field below.
DATAHIBR=0.99.187
# And the release whose `apps` reads an entry's **parts from the index**.
# Before it, parts travelled inside a tarball and an `apps` that met this
# index would fetch the bare file and place it **without its pane**, which
# is the bug that let eight applications install half of themselves
# (Gitea #217) arriving by a new route. An entry that brings parts says it
# needs this, so an older client refuses it with a reason instead.
PARTSHIBR=0.99.189
# And what a particular thing needs, where the rules above cannot say it.
# Both of those are derived from what an entry *is*; this is the
# publisher's own knowledge about one entry, so it is written down with
# its reason rather than inferred.
declare -A ENTHIBR
# The Catalogue window reads `catalogue list -j`, which is 0.99.190 -- and
# since 0.99.192 it draws its tree through `widgets/tree.hibr`, which an
# older desktop does not have: `dt_treepre` would be a command not found
# on every row. An older `apps` -- the command this was called before 0.99.195 -- also takes `-j` for the text to search
# for and answers prose, which the window names as the likely cause --
# honest, and still a window that lists nothing.
ENTHIBR["system/catalogue"]=0.99.193
# Blit's native Control Panel drag callbacks are validated against this release.
ENTHIBR["control-panel/blit"]=0.99.244
# And the release whose `apps` has a `mods` kind at all, and whose shell
# has a module directory of the person's own to put one in (ADR 0044,
# Gitea #221). Before it there was nowhere for a module to land and `apps`
# refused a `.so` by name, so an older client must decline rather than try.
MODSHIBR=0.99.191

fn die(...msg) {
	printf 'mkindex: %s\n' "${msg[*]}" >&2
	exit 1
}

# A bundle's name, with whichever extension it carries taken off: one
# stable path per thing now, overwritten when a new version is published,
# so there is no version in it to parse (Gitea #230).
fn nameof(path) {
	local b=${path##*/}

	b=${b%.tar.gz}
	b=${b%.hibr}
	b=${b%.so}
	b=${b%.json}
	ret "$b"
}

# The version the thing says it is: an app on its own `app` line, a theme,
# a colour scheme or a language in its own `version` field. Read from the
# bundle like every other field, rather than from a git log, so an app's
# version is the app's own and not the hibr release it last changed in
# (Gitea #218).
fn verof(path, kind) {
	local l
	local -A j

	case $kind in
	themes | colours | lang)
		if json parse j < "$path" 2> /dev/null; then
			[ -n "${j["version"]-}" ] && { ret "${j["version"]}"; return 0; }
		fi
		return 1 ;;
	esac
	while read -r l; do
		case $l in
		"app "*)
			if match "$l" '^app[ 	]+[A-Za-z0-9_]+[ 	]+"[^"]*"[ 	]+([0-9][0-9A-Za-z.+~-]*)'; then
				ret "${M[1]}"
				return 0
			fi ;;
		esac
	done < "$path"
	return 1
}

# What a kind calls its files. The five that are scripts are `.hibr`; a
# theme, a colour scheme and a language are data and are `.json` (ADR 0028
# for why they are not scripts).
fn kextof(kind) {
	case $kind in
	themes | colours | lang) ret ".json" ;;
	mods) ret ".so" ;;
	*) ret ".hibr" ;;
	esac
}

# Whether a kind is native code rather than something read or run by the
# shell. One kind is, and everything that differs about publishing a
# module hangs off this (ADR 0044).
fn isnative(kind) {
	[ "$kind" = mods ] && return 0
	return 1
}

# A module describes itself in its own descriptor, which `mod avail` reads
# **without calling its init** -- so name, version, ABI and description all
# come out of the object, the same rule every other kind follows: the
# catalogue says what the thing says.
#
# Scanned in a folder of its own so `mod avail` reads this one object and
# not whatever else sits beside it.
MOD_NM=; MOD_VER=; MOD_ABI=; MOD_DSC=
fn modof(path) {
	local d l nm ver abi st p prov bi dsc

	MOD_NM=; MOD_VER=; MOD_ABI=; MOD_DSC=
	d=${TMPDIR:-/tmp}/mkindex-mod-$$
	rm -rf "$d"; mkdir -p "$d" || die "cannot make $d"
	cp -- "$path" "$d/" || die "$path: cannot copy it to read it"
	# Picked out by path: `mod avail` lists the whole search path and
	# the install directory is always the last of it, so taking the
	# last line read whichever module sorts last.
	while IFS=$'\t' read -r nm ver abi st p prov bi dsc; do
		case $p in "$d"/*) ;; *) continue ;; esac
		MOD_NM=$nm; MOD_VER=$ver; MOD_ABI=$abi; MOD_DSC=$dsc
	done <<< "$(HIBR_MODPATH=$d hibr -c 'mod avail' 2> /dev/null)"
	rm -rf "$d"
	# A name is not enough. `mod avail` lists a candidate it cannot
	# open at all -- the name comes from the filename and every other
	# column is `-` -- so an object built for another machine looks
	# answered and is not. The ABI is the field that can only come
	# from the descriptor, so that is the one to insist on.
	#
	# This is the real constraint of a per-architecture catalogue and
	# it is worth stating plainly: reading a module's descriptor means
	# `dlopen`ing it, which only works for objects built for the
	# machine doing the reading. A catalogue that carries builds for
	# several architectures has to have `mkindex` run **on** each of
	# them, or by a pipeline that does; there is no way to learn a
	# foreign object's ABI here, and writing `-` into the index would
	# be recording a non-answer as an answer (ADR 0045).
	[ -n "$MOD_NM" ] || return 1
	case $MOD_ABI in
	"" | *[!0-9]*) return 1 ;;
	esac
	return 0
}

# The machine a shared object is built for, spelled the way `uname -sm`
# lowercased and joined spells it, which is what `apps` compares it
# against. Read out of the file's own header rather than taken from the
# machine running this, because the publisher is not always the builder.
#
# ELF is read as linux: hibr builds on Linux and macOS, and macOS is
# Mach-O, so the two magics tell them apart. A third ELF platform would
# need the EI_OSABI byte as well, and there is no bundle for one.
# archof lives in archof.hibr, which addapp reads too.
. "$HERE/archof.hibr"

# Whether a file in a kind's folder is an entry of its own, or a **part** of
# one. A theme brings a picture, and it lives beside the theme in the same
# folder -- `themes/construction.png` is where `cp_themeread`'s own `image`
# looks for it -- so the folder holds both. Only a file with the kind's own
# extension is an entry; anything else is something an entry brings, named
# in that entry's `parts` and fetched with it (Gitea #231).
fn isentry(kind, path) {
	local e l

	e := kextof "$kind"
	case $path in
	*"$e") ;;
	*) return 1 ;;
	esac
	# A file some entry brings is that entry's part, never an entry of its
	# own: installing it alone puts a pane in place with no app behind it
	# (hibr Gitea #271, ADR 0047). Every bundle is in the folder of the kind
	# it lands as, so being in bundles/control-panel/ says where a file
	# goes, not who it belongs to.
	[ -z "${CLAIMED["${path#"$HERE/bundles/"}"]+x}" ] || return 1
	# A file that says `# platform:` in its header is part of the
	# desktop and never an entry (hibr ADR 0046) -- dropped here as well
	# as refused by addapp, so a bundle published before the rule cannot
	# linger in the index.
	[ "$e" = .hibr ] || return 0
	while IFS= read -r l; do
		case $l in "# platform:"*) return 1 ;; "#"*) ;; *) break ;; esac
	done < "$path"
	return 0
}

# Whether a kind is read rather than run.
fn isdata(kind) {
	case $kind in
	themes | colours | lang) return 0 ;;
	esac
	return 1
}

fn shaof(path) {
	local line

	line=$(command sha256sum "$path" 2> /dev/null) ||
		die "sha256sum is needed to describe a bundle"
	ret "${line%% *}"
}

# The file to read a bundle's description, version and parts out of, which
# is the bundle: every one is a plain file now. There were tarballs here
# until 0.99.189 -- a .tar.gz carrying an app.json, for an entry that
# brings a Control Panel pane or a picture with it -- and that was a binary
# blob in git holding a manifest of files, which is what the index already
# is (Gitea #231). The archive module is not needed to read this catalogue
# any more.
fn readable(bundle, name, kind) {
	ret "$bundle"
}

# What an entry brings with it, as `kind/file` words. Read from the bundle
# itself, exactly as `addapp` reads it from the source, so nothing is kept
# in step by hand: a script says `# part: control-panel/mailset.hibr` in
# its own header, and a theme cannot -- JSON has no comments -- so its
# picture is read from its own `image` field.
fn partsof(path, kind) {
	local l out= img
	local -A j

	case $kind in
	themes)
		if json parse j < "$path" 2> /dev/null; then
			img=${j["image"]-}
			[ -n "$img" ] && out="themes/$img"
		fi
		ret "$out"
		return 0 ;;
	colours | lang)
		ret ""
		return 0 ;;
	esac
	while read -r l; do
		case $l in
		"# part: "*)
			l=${l#"# part: "}
			out="$out${out:+ }$l" ;;
		esac
	done < "$path"
	ret "$out"
}

# The modules an entry needs before it can run: a `# modules:` line in its
# own header, beside the `# part:` lines, naming them with blanks between.
#
# A **part** and a **module** are different relations and this is the one
# that had no way to be said. A part is a file the entry *owns and brings*
# -- a Control Panel pane, a Control Strip module, a theme's picture --
# published here as a file of its own and removed with its owner,
# refcounted so a pane two apps both bring survives the removal of one. A
# module is owned by nobody: `pim` serves Calendar, Contacts and anybody's
# script, and one that came with hibr is not an app's to delete. So a
# module cannot be a part, and until now nothing in a bundle could say an
# app needed one -- Contacts needs `pim` and `dav`, Mail needs `email`,
# `html`, `img` and `db`, and the failure was a module error at the app's
# first `need`, naming the module and never the app that wanted it.
#
# `apps` has read an index field called `modules` since it was written,
# checks it in `cat_needs` and refuses by name with the right sentence --
# and **nothing had ever written it**: 0 of 85 entries. This is the half
# that was missing, which is why it is five lines rather than a mechanism.
fn modsof(path, kind) {
	local l out=

	# Only a script has a header to say it in. A theme, a colour scheme
	# or a language is data and runs nothing; a module's own
	# requirements are its business and `hibr_require` resolves them.
	case $kind in
	themes | colours | lang | mods)
		ret ""
		return 0 ;;
	esac
	while read -r l; do
		case $l in
		"# modules: "*)
			l=${l#"# modules: "}
			out="$out${out:+ }$l" ;;
		esac
	done < "$path"
	ret "$out"
}

# The folder a bundle sits in *inside* its kind, which `addapp` took from
# where the thing lives in hibr's own tree: `bundles/apps/Internet/mail.hibr`
# gives `Internet`, and `catalogue install` then places it as
# `apps/Internet/mail.hibr` so `dt_apps` gives it the submenu a shipped
# desktop has (Gitea #233). Derived from the path exactly as the kind is,
# so the two cannot disagree.
fn dirof(path, kind) {
	local rel

	rel=${path#"$HERE/bundles/$kind/"}
	case $rel in
	*/*) ret "${rel%/*}" ;;
	*) ret "" ;;
	esac
}

# What the thing calls itself: its own registration line, whichever of the
# four it is. A later `dt_app` is a dialog of its own (Write declares
# `wrfile` for its file box), so the first is the thing. A Control Strip
# module and a saver name themselves without quotes, which is why there are
# two patterns rather than one.
fn titleof(path, name) {
	local l

	while read -r l; do
		if match "$l" '(dt_app|cp_pane)[ 	]+[a-z0-9_]+[ 	]+"([^"]+)"'; then
			ret "${M[2]}"
			return 0
		fi
		if match "$l" '(cs_module|sv_saver)[ 	]+[a-z0-9_]+[ 	]+"?([A-Za-z][A-Za-z ]*[A-Za-z])"?'; then
			ret "${M[2]}"
			return 0
		fi
	done < "$path"
	ret "$name"
}

# The one-line description the file declares with the `app` builtin -- the
# line the desktop's own About box reads (dt_appline), authored for exactly
# this and better than anything derived from a comment.
fn appline(path) {
	local l

	while read -r l; do
		case $l in
		"app "*)
			if match "$l" '^app[ 	]+[a-z0-9_]+[ 	]+"([^"]+)"'; then
				ret "${M[1]}"
				return 0
			fi ;;
		esac
	done < "$path"
	return 1
}

# The file's own header comment: the `-- what it is` line's own paragraph,
# and the one under it. Read as the About box reads it, so what the
# catalogue says and what the thing says are the same words.
fn aboutof(path) {
	local l out= par= on=0 np=0

	while read -r l; do
		case $l in
		"#!"*) continue ;;
		esac
		if [ "$on" = 0 ]; then
			case $l in
			"#"*" -- "*)
				par=${l#*" -- "}
				on=1 ;;
			esac
			continue
		fi
		case $l in
		"#")
			[ -z "$par" ] && continue
			out="$out${out:+

}$par"
			par=
			np=$((np + 1))
			[ "$np" -ge 2 ] && break ;;
		"#"*)
			l=${l#\#}
			l=${l# }
			par="$par${par:+ }$l" ;;
		*) break ;;
		esac
	done < "$path"
	[ -n "$par" ] && out="$out${out:+

}$par"
	ret "$out"
}

declare -g D_TITLE=
declare -g D_ABOUT=

# What a theme, a colour scheme or a language calls itself, into D_TITLE and
# D_ABOUT. The two a person picks from a list say so themselves -- `title`
# and `about`, the words the Appearance pane shows -- so the catalogue and
# the desktop read one sentence rather than two. A language says neither and
# cannot be made to: `tools/strings.py --write` rewrites the pseudo-locales
# whole, so a field added to one would be gone the next time the list of
# strings moved. Its own `name` is the title, and what it is -- the tag, how
# many strings it carries, which way it is read -- is the description.
fn dataof(path, kind, name) {
	local n d tag
	local -A j

	D_TITLE=$name
	D_ABOUT=
	json parse j < "$path" 2> /dev/null ||
		die "$kind/$name: $path does not parse as JSON"
	case $kind in
	lang)
		[ -n "${j["name"]-}" ] && D_TITLE=${j["name"]}
		n := json len j .strings 2> /dev/null || n=0
		case ${j["dir"]-ltr} in
		rtl) d="read right to left" ;;
		*) d="read left to right" ;;
		esac
		# The tag only when the name does not already carry it: a
		# pseudo-locale calls itself `Pseudo (xx)`, and `Pseudo (xx)
		# (xx)` is the sort of thing a derived field does when
		# nobody reads what comes out.
		tag=" (${j["language"]-$name})"
		case $D_TITLE in
		*"(${j["language"]-}"*) tag= ;;
		esac
		D_ABOUT="The desktop's own words in $D_TITLE$tag: $n strings, $d." ;;
	*)
		[ -n "${j["title"]-}" ] && D_TITLE=${j["title"]}
		D_ABOUT=${j["about"]-} ;;
	esac
}

# One row of the page, escaped: a summary is prose from a file nobody here
# wrote, so it cannot be put in HTML as it stands.
fn htesc(s) {
	local t

	t := str replace "$s" "&" "&amp;"
	t := str replace "$t" "<" "&lt;"
	t := str replace "$t" ">" "&gt;"
	ret "$t"
}

# What a kind is called on the page, in the order the desktop presents them.
fn kindname(k) {
	case $k in
	apps) ret "Applications" ;;
	system) ret "The desktop's own" ;;
	control-panel) ret "Control Panel panes" ;;
	control-strip) ret "Control Strip modules" ;;
	savers) ret "Screen savers" ;;
	themes) ret "Themes" ;;
	colours) ret "Colour schemes" ;;
	lang) ret "Languages" ;;
	*) ret "$k" ;;
	esac
}

declare -gA IX
declare -gA SEEN
declare -gA DUP
declare -gA NSEEN
declare -gA CLAIMED
TMP=$(command mktemp -d) || die "cannot make a temporary folder"
rows=
n=0

# Which names mean more than one thing, found before anything is written: a
# name is unique inside a scan root and nowhere else, so `clock` is an
# application and a screen saver. Such a name cannot go in the older
# `apps` section at all -- whichever was written last would be the only one
# there, and that silent overwrite is how this was found: 54 bundles in, 53
# entries out (Gitea #222).
#
# And which files are some entry's parts, before either: isentry asks. A
# module brings nothing, and is not text to read for `# part:` lines.
for kind in $KINDS; do
	[ -d "$HERE/bundles/$kind" ] || continue
	[ "$kind" = mods ] && continue
	ke := kextof "$kind"
	for b in "$HERE/bundles/$kind"/**; do
		[ -f "$b" ] || continue
		case $b in *"$ke") ;; *) continue ;; esac
		pl := partsof "$b" "$kind"
		for p in $pl; do
			CLAIMED["$p"]=1
		done
	done
done
for kind in $KINDS; do
	[ -d "$HERE/bundles/$kind" ] || continue
	for b in "$HERE/bundles/$kind"/**; do
		[ -f "$b" ] || continue
		isentry "$kind" "$b" || continue
		name := nameof "$b"
		if [ -n "${NSEEN["$name"]+x}" ]; then
			DUP["$name"]=1
			printf 'note: %s is %s and %s -- named by its id only\n' \
				"$name" "${NSEEN["$name"]}" "$kind"
		fi
		NSEEN["$name"]=$kind
	done
done

for kind in $KINDS; do
	[ -d "$HERE/bundles/$kind" ] || continue
	krows=
	for bundle in "$HERE/bundles/$kind"/**; do
		[ -f "$bundle" ] || continue
		isentry "$kind" "$bundle" || continue
		name := nameof "$bundle"
		sha := shaof "$bundle"
		src := readable "$bundle" "$name" "$kind"
		# Read before the fields are written, since whether this
		# entry brings parts decides the `hibr` it declares.
		pl0=
		ml0=
		march=
		# A property of where the bundle sits, so it is read for
		# every kind rather than inside the script branch below.
		dr0 := dirof "$bundle" "$kind"
		if isnative "$kind"; then
			# A module carries no parts and says everything about
			# itself in its descriptor, which `mod avail` reads
			# without running it.
			modof "$src" ||
				die "$kind/$name: hibr here cannot read its descriptor.
Reading one means dlopening the object, which works only for this
machine's own architecture -- and this is $bundle. A catalogue with
builds for several machines has mkindex run on each of them."
			march := archof "$src" ||
				die "$kind/$name: its header names no machine hibr builds for"
			ver=$MOD_VER
			[ -n "$ver" ] ||
				die "$kind/$name: its descriptor declares no version"
			title=$MOD_NM
			about=$MOD_DSC
			sum=$MOD_DSC
		else
			pl0 := partsof "$src" "$kind"
			ml0 := modsof "$src" "$kind"
			ver := verof "$src" "$kind" ||
				die "$kind/$name: it declares no version -- an app says so on its \`app\` line, a theme in its own \"version\""
		fi
		# A script describes itself in its own header comment and
		# its `app` line; a theme, a colour scheme or a language has
		# no comments to hold either, so its words come from the
		# fields it already carries (Gitea #224); and a module says
		# it in the descriptor read above.
		if isnative "$kind"; then
			:
		elif isdata "$kind"; then
			dataof "$src" "$kind" "$name"
			title=$D_TITLE
			about=$D_ABOUT
			sum=${about%%$'\n'*}
		else
			title := titleof "$src" "$name"
			about := aboutof "$src"
			if sum := appline "$src"; [ -n "$sum" ]; then
				# Almost every file says the same sentence
				# twice -- once on its `app` line and once
				# after the `--` in its header, which is where
				# the About box has always read it from. Put
				# both in and the catalogue opens with "Eat,
				# grow, and do not bite yourself / eat, grow,
				# and do not bite yourself."
				#
				# So where the header's first paragraph *is*
				# the declaration, or is the declaration and
				# then more, the header's own sentence wins and
				# the declaration is dropped: "clear the field
				# without stepping on anything" says more than
				# "Clear the field", and dropping the longer of
				# the two to remove a repetition loses what was
				# being said. Capitalised, because it follows
				# `name --` in the file and is written in lower
				# case for that. Where the two genuinely
				# differ, both are kept, declaration first.
				# This catalogue loop is at file scope, not inside a function.
				first=; rest=; a=; b=
				first=${about%%$'\n'*}
				rest=${about#"$first"}
				rest=${rest#$'\n'}
				rest=${rest#$'\n'}
				a=${sum,,}; a=${a%.}
				b=${first,,}
				case $b in
				"$a" | "$a "* | "$a,"* | "$a:"* | "$a."*)
					about="${first^}${rest:+

}$rest" ;;
				*) about="$sum${about:+

}$about" ;;
				esac
			else
				sum=${about%%$'\n'*}
			fi
		fi

		# Two sections, deliberately (Gitea #222). `entries` is keyed
		# by the id, kind/name, because the desktop has eight
		# namespaces and a name is only unique inside one of them --
		# `clock` is an application and a screen saver. `apps` is
		# kept keyed by name for an `apps` older than 0.99.184, which
		# then gets every entry whose name is unique and misses only
		# the one it could not have named anyway.
		#
		# A data kind is left out of that older section altogether,
		# because an `apps` from before 0.99.186 would install one
		# *wrongly* rather than not at all: its `cat_dest` is
		# `$CAT_DATA/$kind/$name.hibr` for every kind, so a theme
		# would land as `themes/construction.hibr`, which nothing
		# reading themes ever looks for -- an install that reports
		# success and does nothing. Missing from an old client's list
		# is the honest failure (Gitea #224).
		id=$kind/$name
		# A module is one entry with a build per machine, so the
		# same id is reached once per architecture and that is not
		# the duplicate this guard is for -- `mods/mermaid` built
		# for linux-x86_64 and for darwin-arm64 is one thing a
		# client chooses from, not two things with one name. The
		# clash that matters is two files claiming the same id for
		# the same machine, which is what the arch in the key
		# catches (ADR 0045).
		if isnative "$kind"; then
			[ -z "${SEEN["$id/$march"]+x}" ] ||
				die "$id for $march is in the catalogue twice: ${SEEN["$id/$march"]} and $bundle"
			SEEN["$id/$march"]=$bundle
		else
			[ -z "${SEEN["$id"]+x}" ] ||
				die "$id is in the catalogue twice: ${SEEN["$id"]} and $bundle"
			SEEN["$id"]=$bundle
		fi
		# A data kind carries `hibr`, which an application deliberately
		# does not. The README's reason for leaving it off stands for a
		# script -- which release it needs is whatever desktop API it
		# calls, which is written nowhere, so a number there would be a
		# guess -- and does not stand here, because this one is known
		# exactly: `catalogue install` could place a theme from 0.99.186 and
		# the Appearance pane did not look in the data folder until
		# **0.99.187**, so an older client would fetch it, verify it,
		# put it where it belongs and show nothing. `cat_needs` refuses
		# it with a reason instead, which is the difference between a
		# catalogue that is honest about one thing it knows and one that
		# guesses about everything (Gitea #224).
		for f in title version kind bundle sha256 about licence author \
			 name hibr arch abi modules dir; do
			case $f in
			title) v=$title ;;
			version) v=$ver ;;
			kind) v=$kind ;;
			bundle) v="bundles/$kind${dr0:+/$dr0}/${bundle##*/}" ;;
			sha256) v=$sha ;;
			about) v=$about ;;
			licence) v="MIT" ;;
			author) v="Omar Sakka" ;;
			name) v=$name ;;
			hibr) v=; isdata "$kind" && v=$DATAHIBR
			      [ -n "$pl0" ] && v=$PARTSHIBR
			      isnative "$kind" && v=$MODSHIBR
			      [ -n "${ENTHIBR["$id"]-}" ] &&
				      v=${ENTHIBR["$id"]} ;;
			# Only a module has either, and both are a refusal
			# rather than a note: an object built for another
			# machine or another ABI cannot be loaded at all, so
			# `apps` declines it before the fetch (ADR 0044).
			arch) v=$march ;;
			abi) v=; isnative "$kind" && v=$MOD_ABI ;;
			# What this entry needs loaded before it can run,
			# from its own `# modules:` line. `apps` has read
			# this field and refused by name on it since it was
			# written; nothing had ever filled it in.
			modules) v=$ml0 ;;
			# Where inside its kind it lands, from the bundle's
			# own path (Gitea #233). Only `apps` has folders
			# today; every other root is scanned flat.
			dir) v=$dr0 ;;
			esac
			case $f in
			hibr | arch | abi | modules | dir) [ -n "$v" ] || continue ;;
			esac
			# A module's bundle, hash, machine and ABI belong to
			# **one build** of it, not to the entry: the entry is
			# `mods/mermaid` and it has one of these per machine
			# it was built for. Everything else -- the title, the
			# version, what it is -- is the same whichever build
			# you take, so it stays where it was and is simply
			# written again by each pass (ADR 0045).
			#
			# `dir` is dropped for a module outright: the folder
			# in its bundle path is the architecture, which says
			# where the *bundle* lives and nothing about where
			# the module is installed, and a client reading it
			# as a destination would put mermaid.so in
			# `mods/linux-x86_64/`.
			if isnative "$kind"; then
				case $f in
				dir) continue ;;
				bundle | sha256 | arch | abi)
					IX["entries"]["$id"]["builds"]["$march"]["$f"]=$v
					continue ;;
				esac
			fi
			IX["entries"]["$id"]["$f"]=$v
			# A name that means two things cannot go in the older
			# section at all: whichever was written last would be
			# the only one there, which is the bug this fixes.
			[ -n "${DUP["$name"]+x}" ] && continue
			isdata "$kind" && continue
			IX["apps"]["$name"]["$f"]=$v
		done

		# What this entry brings with it, each as a plain file of its
		# own with its own sha256, where a tarball used to carry them
		# with an app.json inside it (Gitea #231). `catalogue install`
		# fetches every one and verifies them all before it places
		# any, which is the promise the tarball made by being a single
		# object.
		#
		# `as` is the filename a part lands as, not a name with its
		# kind's extension appended: a theme's picture is a .png in
		# the themes folder, which a name could not say (Gitea #224).
		pl=$pl0
		if [ -n "$pl" ]; then
			pn=0
			read -ra pws <<< "$pl"
			for pw in "${pws[@]}"; do
				pk=${pw%%/*}
				pf=${pw#*/}
				pp="bundles/$pk/$pf"
				[ -r "$HERE/$pp" ] ||
					die "$kind/$name says it brings $pw, and $pp is not in this catalogue -- publish it, or stop saying so"
				psha := shaof "$HERE/$pp"
				IX["entries"]["$id"]["parts"]["$pn"]["kind"]=$pk
				IX["entries"]["$id"]["parts"]["$pn"]["as"]=$pf
				IX["entries"]["$id"]["parts"]["$pn"]["path"]=$pp
				IX["entries"]["$id"]["parts"]["$pn"]["sha256"]=$psha
				pn=$((pn + 1))
			done
			printf '   %s brings %s\n' "$kind/$name" "$pl"
		fi
		[ -n "$ml0" ] &&
			printf '   %s needs %s\n' "$kind/$name" "$ml0"

		t := htesc "$title"
		s := htesc "$sum"
		krows="$krows<tr><td><code>$id</code></td><td>$t</td><td>$ver</td><td>$s</td></tr>
"
		n=$((n + 1))
		printf '%-14s %-12s %-10s %s\n' "$kind" "$name" "$ver" "${bundle##*/}"
	done
	if [ -n "$krows" ]; then
		kn := kindname "$kind"
		rows="$rows<tr><th colspan=\"4\">$kn</th></tr>
$krows"
	fi
done

command rm -rf "$TMP"
[ "$n" -gt 0 ] || die "bundles/ has nothing in it"

j := json emit IX -p || die "cannot emit the index"
printf '%s\n' "$j" > "$HERE/index.json" || die "cannot write index.json"

cat > "$HERE/index.html" <<HTML || die "cannot write index.html"
