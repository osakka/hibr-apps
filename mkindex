# Sign it. The apt repository's own key, because this project publishes two
# things and one key is one key to keep rather than two to lose; the index
# already holds every bundle's sha256, so a signature over it covers every
# bundle without signing each. `apps` pins the fingerprint and refuses to
# install a **module** from a catalogue it cannot verify -- a script it
# installs with a warning, since the sha256 and TLS are its stated trust
# model and a script is a file you can read (ADR 0044).
#
# Not having the secret key is not an error here: anyone may run mkindex
# over their own copy, and what they get is an unsigned catalogue, which
# is what the catalogue was until today.
APTKEY=${APT_KEY:-A1E3CA788A8FB02052DA22B413035BE1B1674431}
APTHOME=${APT_GNUPGHOME:-$HOME/.local/share/hibr-apt/gnupg}
if GNUPGHOME=$APTHOME command gpg --list-secret-keys "$APTKEY" \
   > /dev/null 2>&1; then
	rm -f index.json.asc
	GNUPGHOME=$APTHOME command gpg --batch --yes --local-user "$APTKEY" \
		--armor --detach-sign -o index.json.asc index.json ||
		die "the index could not be signed"
	printf '== signed index.json.asc with %s\n' "$APTKEY"
else
	rm -f index.json.asc
	printf '== no secret key %s here: index.json.asc not written\n' \
		"$APTKEY"
fi

printf '\n== %d entries in index.json and index.html\n' "$n"
