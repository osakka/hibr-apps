#!/usr/bin/env hibr
#
# stale -- which bundles here are behind the tree they were taken from.
#
#   ./stale [path/to/hibr]
#
# A bundle is a copy of a file in hibr's own tree, so the catalogue can
# fall behind it silently: nothing fetches, nothing fails, and a person
# who installs an app gets the version of it that was current whenever
# `addapp` last ran. That cost nothing while hibr's package shipped the
# applications as well -- most people never fetched one -- and it is the
# whole story since 0.99.194 (Gitea #220), where the catalogue is the
# only route and a restore from a stale catalogue is a downgrade.
#
# Ten were behind when this was first run, including the four apps the
# search sweep had rewritten two releases earlier.
#
# The comparison is `cmp`: a bundle is published byte for byte, so
# anything else would be a second opinion about what "the same" means.
# Modules are skipped -- a `.so` is built, not copied -- and so is
# anything the tree no longer has, which is a bundle to think about
# rather than to refresh.
#
# A thing this reports needs more than `./addapp` on it: republishing at
# the same version reaches nobody who already installed the old copy, so
# bump the thing's own version in the tree first.

set -u

HERE=${BASH_SOURCE%/*}
[ -n "$HERE" ] || HERE=.
TREE=${1:-$HERE/../hibr}
DESK=$TREE/programs/desktop

[ -d "$DESK" ] || {
	printf 'stale: %s is not a hibr tree\n' "$TREE" >&2
	exit 1
}

n=0
gone=0
moved=0
# `**` rather than `*/*`: an application is published into the folder it
# lives in -- `bundles/apps/Internet/mail.hibr` -- since 0.99.195
# (Gitea #233), and a one-level glob reads those folders as entries and
# reports four of them "gone".
for b in "$HERE"/bundles/**; do
	[ -f "$b" ] || continue
	rel=${b#"$HERE"/bundles/}
	kind=${rel%%/*}
	file=${rel##*/}
	[ "$kind" = mods ] && continue

	# An application may live in a folder of its own inside the scan
	# root -- Accessories, Office, Internet, Games -- so it is found
	# by name rather than at a path. Every other kind is flat.
	if [ "$kind" = apps ]; then
		t := find "$DESK/apps" -name "$file"
		t=${t%%$'\n'*}
	else
		t=$DESK/$kind/$file
	fi

	if [ -z "$t" ] || [ ! -f "$t" ]; then
		printf 'gone     %-30s nothing in the tree is called this\n' "$rel"
		gone=$((gone + 1))
		continue
	fi

	# Where an app lives is as much a part of it as what is inside it:
	# the folder is its submenu, and `mkindex` takes the index's `dir`
	# from the bundle's own path. Finding it by name matches it in any
	# folder, so a comparison of bytes alone cannot see a **move** --
	# an app shifted between submenus read as current while the index
	# went on naming the folder it had left, and anybody installing it
	# got it in the wrong place. That is the #233 class of bug the
	# `dir` field exists to prevent, and this is the check that is
	# supposed to catch it (Gitea #245).
	bdir=${rel#"$kind"/}
	bdir=${bdir%/*}
	[ "$bdir" = "$file" ] && bdir=
	tdir=${t#"$DESK/$kind/"}
	tdir=${tdir%/*}
	[ "$tdir" = "$file" ] && tdir=
	if [ "$bdir" != "$tdir" ]; then
		printf 'moved    %-30s now at %s\n' \
			"$rel" "$kind/${tdir:+$tdir/}$file"
		moved=$((moved + 1))
		continue
	fi
	cmp -s "$b" "$t" && continue
	printf 'stale    %-30s %s\n' "$rel" "$t"
	n=$((n + 1))
done

# And the direction this never looked: a file in the tree that was never
# published at all. Every check above walks `bundles/**`, so the
# catalogue could only ever be wrong about something it already had --
# a pane added to the desktop and never added here was invisible, which
# is how `control-panel/screenshots` and `control-panel/wallpaper` sat
# unpublished while this printed "every bundle matches the tree".
#
# What is deliberately not publishable, each with its reason, because a
# list like this is the thing that silently grows wrong: the savers'
# shared library is not a saver; `strings.txt` is the string catalogue
# rather than a language; `xx` and `xy` are tools/strings.py's
# pseudo-locales, a translator's instrument; and a theme's picture is
# carried as part of that theme's own bundle rather than as an entry.
never=0
for t in "$DESK"/apps/**/*.hibr "$DESK"/system/*.hibr \
	 "$DESK"/control-panel/*.hibr "$DESK"/control-strip/*.hibr \
	 "$DESK"/savers/*.hibr "$DESK"/themes/*.json \
	 "$DESK"/colours/*.json "$DESK"/lang/*.json; do
	[ -f "$t" ] || continue
	rel=${t#"$DESK"/}
	# Something with no `app` line declares no version, so it is not a
	# thing the catalogue can carry at all -- it is a part of
	# something else. control-panel/screenshots is rows of the Desktop
	# pane, and control-panel/wallpaper is a dialog Appearance opens;
	# both say so in their own first lines. Reading the file is what
	# tells them apart from a pane somebody forgot, which is the whole
	# point of this direction: counting files in a folder and calling
	# each one a pane is what made me report these two as missing.
	case $rel in
	savers/saver.hibr | lang/strings.txt | lang/xx.json | lang/xy.json)
		continue ;;
	esac
	case $rel in
	*.hibr) grep -q '^app ' "$t" || continue ;;
	esac
	[ -f "$HERE/bundles/$rel" ] && continue
	printf 'never    %-30s in the tree, never published\n' "$rel"
	never=$((never + 1))
done

if [ "$n" = 0 ] && [ "$gone" = 0 ] && [ "$moved" = 0 ] && [ "$never" = 0 ]; then
	printf '== every bundle matches the tree, and the tree has nothing unpublished\n'
	exit 0
fi
[ "$never" -gt 0 ] &&
	printf '== %s in the tree that was never published\n' "$never"
printf '== %s behind, %s moved, %s with no file in the tree\n' \
	"$n" "$moved" "$gone"
exit 1
