#!/usr/bin/env hibr
#
# addapp -- put something installable into this catalogue as a bundle.
#
#   ./addapp ../hibr/examples/desktop/apps/Games/snake.hibr
#   ./addapp ../hibr/examples/desktop/control-panel/keyboard.hibr
#   ./addapp ../hibr/examples/desktop/apps/Internet/mail.hibr 0.99.177
#
# Anything the desktop scans for can be published: an application, one of
# the desktop's own `system/` apps, a Control Panel pane, a Control Strip
# module, a screen saver, a theme, a colour scheme or a language. The
# **kind** is the scan root the file lives in, taken from its path rather
# than guessed from what it registers -- a `system/` app and an application
# both register with `dt_app`, so nothing inside the file can tell them
# apart -- and the kind decides the extension, `.hibr` for the five that
# are scripts and `.json` for the three that are data.
#
# A theme's own picture is read out of the theme (`image`) rather than
# declared, because JSON has no comments to declare it in.
#
# A file that brings other files with it says so in its own header, under
# the `app` line that gives its description:
#
#   app mail "Email, offline, labels and conversations as Gmail has them" 1.0
#   # part: control-panel/mailset.hibr
#
# and each part is published as a plain file of its own, at the path its own
# kind gives it. A Control Panel pane is scanned from another root, so it
# cannot travel as a resource under the app's own -- which is why eight of
# the applications installed half of themselves until hibr 0.99.183 (Gitea
# #217) -- and the index is what says which parts belong to which entry.
# There are no tarballs here: a .tar.gz carrying an app.json was a container
# for a manifest of files, which is what the index already is, and a binary
# blob in git that nothing can diff (Gitea #231).
#
# The version is the thing's own, declared where it says what it is: an app
# and a pane on their `app` line, a theme, a colour scheme or a language in
# their own `version` field. Not the hibr release it last changed in, which
# is what this read from a git log until 0.99.189 -- `0.99.126` said nothing
# about whether Calculator was new, mature or abandoned (Gitea #218). Give
# a version as the second argument to override it.
#
# Nothing is published here: this writes bundles/KIND/NAME.{hibr,json} and
# leaves the index alone. `./mkindex` rebuilds the index, and `git push` is
# what publishes.

set -u

HERE=${BASH_SOURCE%/*}
[ -n "$HERE" ] || HERE=.
KINDS="apps system control-panel control-strip savers themes colours lang mods"

fn die(...msg) {
	printf 'addapp: %s\n' "${msg[*]}" >&2
	exit 1
}

# The version the thing says it is -- an app on its own `app` line, a theme,
# a colour scheme or a language in its own `version` field. Not the hibr
# release it last changed in, which is what this read from a git log until
# 0.99.189: nobody could tell from `0.99.126` whether Calculator was new,
# mature or abandoned, and it read as hibr's version printed in an app's row
# (Gitea #218). A thing that declares none is refused rather than given a
# number nobody chose.
fn verof(path, kind) {
	local l v= nm ver abi st p prov bi dsc d
	local -A j

	case $kind in
	mods)
		# A module says it in its own descriptor, which `mod avail`
		# reads without calling its init. Copied to a folder of its
		# own first and then picked out **by path**: `mod avail`
		# lists the whole search path, and the install directory is
		# always the last of it, so taking the last line read
		# whichever module sorts last and gave every module the
		# same version.
		d=${TMPDIR:-/tmp}/addapp-mod-$$
		rm -rf "$d"; mkdir -p "$d" || die "cannot make $d"
		cp -- "$path" "$d/" || die "$path: cannot copy it to read it"
		while IFS=$'\t' read -r nm ver abi st p prov bi dsc; do
			case $p in "$d"/*) v=$ver ;; esac
		done <<< "$(HIBR_MODPATH=$d hibr -c 'mod avail' 2> /dev/null)"
		rm -rf "$d"
		[ -n "$v" ] ||
			die "$path: hibr cannot read a module descriptor in it"
		ret "$v"
		return 0 ;;
	themes | colours | lang)
		json parse j < "$path" 2> /dev/null ||
			die "$path: does not parse as JSON"
		v=${j["version"]-}
		[ -n "$v" ] ||
			die "$path: no \"version\" in it -- add one, since the catalogue cannot invent it"
		ret "$v"
		return 0 ;;
	esac
	while read -r l; do
		case $l in
		"app "*)
			if match "$l" '^app[ 	]+[A-Za-z0-9_]+[ 	]+"[^"]*"[ 	]+([0-9][0-9A-Za-z.+~-]*)'; then
				ret "${M[1]}"
				return 0
			fi
			die "$path: its \`app\` line declares no version -- app NAME \"what it is\" 1.0" ;;
		esac
	done < "$path"
	die "$path: no \`app\` line, so it cannot say what version it is"
}

# The release a file last changed in, from the git log of the tree it lives
# in: a commit subject in hibr is "0.99.183: what it did", so the version is
# that subject's first word, less its colon. Kept for `--built`, which
# answers "when was this last touched" -- a different question from "which
# version is this", and this codebase has paid for answering two with one.
# The pathspec is the file's own name, resolved against `-C "$dir"` -- a
# path relative to *this* process's directory means something else there,
# and `git log` over nothing exits 0 with no output, so a relative source
# read as an empty version rather than as an error.
fn relof(path) {
	local dir base sub v

	dir=${path%/*}
	base=${path##*/}
	[ "$dir" = "$path" ] && dir=.
	sub=$(command git -C "$dir" log -1 --format=%s -- "$base" 2> /dev/null) ||
		die "$path: not in a git tree, so give the version yourself"
	[ -n "$sub" ] ||
		die "$path: git knows no commit that touched it, so give the version yourself"
	v=${sub%%:*}
	case $v in
	[0-9]*.[0-9]*) ;;
	*) die "$path: '$sub' does not begin with a version, so give one" ;;
	esac
	ret "$v"
}

# The scan root a file lives in, and the desktop folder above it: a path
# like .../desktop/apps/Games/snake.hibr is kind `apps`, root .../desktop.
fn kindof(path) {
	local p rest k

	p=$path
	while [ "$p" != "/" ] && [ "$p" != "." ] && [ -n "$p" ]; do
		rest=${p##*/}
		p=${p%/*}
		[ "$p" = "$path" ] && break
		for k in $KINDS; do
			if [ "$rest" = "$k" ]; then
				DESKTOP=$p
				ret "$k"
				return 0
			fi
		done
	done
	return 1
}

# What the file says it brings with it: `# part: control-panel/mailset.hibr`
# lines in its own header, each one a path under the desktop folder.
#
# A theme cannot say that -- JSON has no comments -- so its picture is
# **read from the theme itself**: `image` is the file `cp_themeread` looks
# for beside the theme, which makes the part discovered rather than
# declared twice (Gitea #224).
fn partsof(path, kind) {
	local l out= img
	local -A j

	case $kind in
	themes)
		if json parse j < "$path" 2> /dev/null; then
			img=${j["image"]-}
			[ -n "$img" ] && out="themes/$img"
		fi
		ret "$out"
		return 0 ;;
	colours | lang)
		ret ""
		return 0 ;;
	esac
	while read -r l; do
		case $l in
		"# part: "*)
			l=${l#"# part: "}
			out="$out${out:+ }$l" ;;
		esac
	done < "$path"
	ret "$out"
}

# What a kind calls its files, which is also what a bundle of one is named.
fn kextof(kind) {
	case $kind in
	themes | colours | lang) ret ".json" ;;
	mods) ret ".so" ;;
	*) ret ".hibr" ;;
	esac
}

# A version nobody bumps is a lie, and the previous publish is right here to
# compare against: the index records what version was published and the
# sha256 of the bytes it was published as. Changed content under an
# unchanged version is refused, because without this check a hand-kept
# version is a worse scheme than reading a git log rather than a better one
# (Gitea #218). `--same` is the deliberate override, for replacing a bundle
# that went out wrong.
fn samecheck(id, ver, int same, file) {
	local got old oldsha
	local -A ix

	[ "$same" = 1 ] && return 0
	[ -r "$HERE/index.json" ] || return 0
	json parse ix < "$HERE/index.json" 2> /dev/null || return 0
	old=${ix["entries"]["$id"]["version"]-}
	oldsha=${ix["entries"]["$id"]["sha256"]-}
	[ -n "$old" ] && [ -n "$oldsha" ] || return 0
	[ "$old" = "$ver" ] || return 0
	got := shaof "$file"
	[ "$got" = "$oldsha" ] && return 0
	die "$id $ver is already published and its content differs.
  published $oldsha
  this is   $got
Bump the version where the thing declares it, or pass --same to replace
what is there under the same version."
}

fn shaof(path) {
	local line

	line=$(command sha256sum "$path" 2> /dev/null) ||
		die "sha256sum is needed to compare a bundle with the published one"
	ret "${line%% *}"
}

[ $# -ge 1 ] || die "usage: addapp [--same] PATH-TO-FILE.hibr [VERSION]"
same=0
args=()
for a in "$@"; do
	case $a in
	--same) same=1 ;;
	*) args+=("$a") ;;
	esac
done
[ "${#args[@]}" -ge 1 ] || die "usage: addapp [--same] PATH-TO-FILE.hibr [VERSION]"
src=${args[0]}
ver=${args[1]-}
DESKTOP=

[ -r "$src" ] || die "$src: cannot be read"
case $src in
*.hibr | *.json | *.so) ;;
*) die "$src: an installable file is a .hibr, a .json for a theme, a colour scheme or a language, or a .so for a module" ;;
esac

name=${src##*/}
name=${name%.hibr}
name=${name%.json}
name=${name%.so}
# An underscore as well as a dash, because a name here is a *filename* the
# desktop already reads -- `retro_car.json` is the theme's name wherever
# anybody has chosen it, and renaming it to suit this script would change
# what their own settings file says.
case $name in
*[!a-z0-9_-]*) die "$name: a name is lower case letters, digits, dashes and underscores" ;;
esac

kind := kindof "$src" ||
	die "$src: not under one of the desktop's scan roots ($KINDS)"
ext := kextof "$kind"
case $src in
*"$ext") ;;
*) die "$src: a $kind file is a $ext, and this is not one" ;;
esac
[ -n "$ver" ] || ver := verof "$src" "$kind"

parts := partsof "$src" "$kind"
# One stable path per thing, overwritten when a new version is published:
# the version is the app's own now and lives in the index, not in a
# filename, and git holds every previous version for whoever wants to
# revert. The cost is named rather than hidden -- a static host caches the
# index and the bundle independently, so for a few minutes after a publish
# a client can pair an old index with a new bundle and `apps install`
# refuses on the sha256. Measured on GitHub Pages: ten minutes each, a
# query string is not part of the cache key, and `Cache-Control: no-cache`
# is ignored, so no client can ask for a fresh one and a retry would fetch
# the same bytes (Gitea #230).
# The folder the thing sits in *inside* its scan root, carried into the
# bundle's own path so `mkindex` can read it back the way it already
# reads the kind. `kindof` set DESKTOP to the folder above the root
# while it was walking up, which is what makes this two lines.
#
# Only `apps` has them -- the desktop scans every other root flat -- but
# nothing here needs to know that: a kind with no subfolders simply
# never produces one.
sub=${src#"$DESKTOP/$kind/"}
case $sub in
*/*) sub=${sub%/*} ;;
*) sub= ;;
esac
dir="$HERE/bundles/$kind${sub:+/$sub}"
mkdir -p "$dir" || die "cannot make $dir"

if [ -z "$parts" ]; then
	out="$dir/$name$ext"
	# The published bytes of a bare bundle *are* the source file, so the
	# comparison needs no temporary copy.
	samecheck "$kind/$name" "$ver" "$same" "$src"
	command cp -f "$src" "$out" || die "cannot write $out"
	printf '== %-14s %-10s %s\n' "$kind/$name" "$ver" "${out#$HERE/}"
	printf '   now ./mkindex, then commit and push\n'
	exit 0
fi

# No tarball. A part is a plain file at its own stable path, and the index
# says which parts belong to an entry -- a manifest of files is precisely
# what the index already is, so a .tar.gz carrying an app.json was a
# container for something that belongs there. What that buys: every file in
# the catalogue is plain, diffable and readable in a browser, git holds the
# history of each, no app.json exists to go wrong, and the reproducible-tar
# dance this needed (--sort=name --mtime=@0 and gzip -n, so identical
# content did not hash differently every run) is gone with it.
#
# `apps install` fetches each part and verifies every one of them *before*
# it places any, which keeps the promise a tarball made structurally: a bad
# bundle is refused whole rather than half-installed.
#
# A part that is itself an installable thing of another kind -- a Control
# Panel pane -- lands at exactly the path its own `addapp` run would write,
# because both copy the same source file. So the two agree by construction
# rather than by being kept in step.
samecheck "$kind/$name" "$ver" "$same" "$src"
out="$dir/$name$ext"
command cp -f "$src" "$out" || die "cannot write $out"
read -ra plist <<< "$parts"
for p in "${plist[@]}"; do
	pk=${p%%/*}
	pf=${p#*/}
	case $pf in
	*/*) die "$name: part '$p' is not <kind>/<file>" ;;
	esac
	[ -r "$DESKTOP/$p" ] || die "$name: part $p is not in $DESKTOP"
	mkdir -p "$HERE/bundles/$pk" || die "cannot make $HERE/bundles/$pk"
	command cp -f "$DESKTOP/$p" "$HERE/bundles/$pk/$pf" ||
		die "cannot copy $DESKTOP/$p"
done
printf '== %-14s %-10s %s\n' "$kind/$name" "$ver" "${out#$HERE/}"
printf '   parts: %s\n' "$parts"
printf '   now ./mkindex, then commit and push\n'
