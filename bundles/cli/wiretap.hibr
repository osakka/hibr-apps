#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# wiretap -- the command. It starts and stops the engine through the module's `wt` builtin and shows what the engine sees:
# who is talking (top, usage), how much (graph), and whether it can see at all (show, doctor). Read-only: nothing here
# changes a firewall (that is M2). See docs/CLI.md.

# What the catalogue reads before it fetches this: the name, a description, the version, and the module it needs.
app wiretap "See every byte: a network monitor for the hibr desktop" 0.5.0
# modules: wiretap

strict

SELF_VERSION=${WIRETAP_SELF_VERSION:-0.5.0}	# this script's version: the catalogue's. The engine is the package's, and a running node has its own.

# Where the node's control socket is: WT_SOCK; else the system service's; else this user's own.
fn wt_findsock() {
	if [ -n "${WT_SOCK:-}" ]; then
		ret "$WT_SOCK"
	elif [ -S /run/wiretap/ctl ]; then
		ret /run/wiretap/ctl
	elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
		ret "$XDG_RUNTIME_DIR/wiretap/ctl"
	else
		ret "$HOME/.wiretap/ctl"
	fi
}
WT_SOCK := wt_findsock
export WT_SOCK

mod load "${WT_MOD:-wiretap}" || { echo "wiretap: the wiretap module is not installed" >&2; exit 1; }

# wt reports failures in $ERRMSG; say them the way a command would.
fn run(...cmd) {
	"${cmd[@]}" || { echo "wiretap: ${ERRMSG:-failed}" >&2; exit 1; }
}

fn usage() {
	cat <<EOF
usage: wiretap <command>

  (nothing)                  turn it on if it is off, then say how it is
  on                         start the node in the background (a service machine starts it for you)
  off | down                 stop the node
  show                       how the node is, in a few lines
  top [N]                    who is talking now: the busiest N programs (default 10), by their last five seconds
  usage [N]                  who has used the most since the node started
  hosts [N] [--names]        who it is talking to: the biggest N remote addresses (default 20), with the program, bytes and how long ago
  graph [SECONDS] [ROWS]     a graph of the last SECONDS (default 60), download above the line, upload below
  watch                      top, refreshed every second (Ctrl-C leaves; the node goes on)
  status                     the raw status (JSON)
  fw [list]                  the firewall rules, numbered;  fw block|allow HOST [PORT] [--tcp|--udp] [--in] [--uid N] [--cgroup /P] [--first]
                             adds one, fw rm N removes one, fw on | off turns the firewall on or off (asks for an administrator; docs/CLI.md)
  doctor                     say whether it can see everything, and what is out of step
  version                    this script's version, the installed engine's, and the running node's

  --json after top, usage, hosts, graph or show prints the node's JSON instead
EOF
}

# 1234 -> 1.2K, 5300000 -> 5.0M
fn wt_human(int b) {
	if [ "$b" -ge 1073741824 ]; then
		echo "$((b / 1073741824)).$((b % 1073741824 * 10 / 1073741824))G"
	elif [ "$b" -ge 1048576 ]; then
		echo "$((b / 1048576)).$((b % 1048576 * 10 / 1048576))M"
	elif [ "$b" -ge 1024 ]; then
		echo "$((b / 1024)).$((b % 1024 * 10 / 1024))K"
	else
		echo "${b}B"
	fi
}

# Is a node answering? Fills WT_ST with its status.
declare -g WT_ST AJ SJ
fn wt_up() {
	local st

	if st := wt status 2> /dev/null && json parse WT_ST "$st" 2> /dev/null; then
		return 0
	fi
	return 1
}

fn wt_need() {
	wt_up || { echo "wiretap: it is not running. Start it with: wiretap on" >&2; exit 1; }
}

fn wt_on() {
	if wt_up; then
		echo "wiretap: already running"
		return 0
	fi
	local i
	local -a extra
	read -ra extra <<< "${WT_ARGS:-}"		# WT_ARGS: extra options for the engine, such as --no-capture
	# History is kept across restarts (ADR 0009) unless the person says otherwise: WT_STATE names the file, WT_STATE=none turns it off.
	case " ${extra[*]:-} " in
	*" --state "*) ;;
	*)
		local st=${WT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/wiretap/history}
		if [ "$st" != none ]; then
			mkdir -p -m 700 "${st%/*}" 2> /dev/null
			extra+=(--state "$st")
		fi ;;
	esac
	run wt start "${extra[@]}" > /dev/null
	for ((i = 0; i < 20; i++)); do
		wt_up && return 0
		sleep 0.1
	done
	echo "wiretap: started, but it does not answer yet (wiretap doctor)" >&2
	return 1
}

fn wt_show() {
	local v cap note pk dr un

	wt_need
	v := json get WT_ST .version
	cap := json get WT_ST .capture
	note := json get WT_ST .capture_note
	pk := json get WT_ST .packets
	dr := json get WT_ST .kernel_dropped
	un := json get WT_ST .processes_unreadable
	echo "wiretap $v is running ($WT_SOCK)"
	if [ "$cap" = true ]; then
		echo "  seeing packets: yes ($pk so far, $dr dropped by the kernel)"
	else
		echo "  seeing packets: NO: $note"
	fi
	[ "${un:-0}" -gt 0 ] && echo "  $un processes could not be read: their traffic shows as (root) or (user N)"
	return 0
}

# The apps, as parallel arrays, sorted by the key given: rate (the last five seconds) or total.
declare -ga A_NAME=() A_PID=() A_OK=() A_RX=() A_TX=() A_RX5=() A_TX5=()
fn wt_apps(by) {
	local j cnt A i k t
	local -a key

	A_NAME=(); A_PID=(); A_OK=(); A_RX=(); A_TX=(); A_RX5=(); A_TX5=(); key=()
	A := wt apps || return 1
	json parse AJ "$A" || return 1
	cnt := json len AJ .apps
	for ((i = 0; i < ${cnt:-0}; i++)); do
		A_NAME+=("$(json get AJ ".apps[$i].name")")
		A_PID+=("$(json get AJ ".apps[$i].pid")")
		A_OK+=("$(json get AJ ".apps[$i].attributed")")
		A_RX+=("$(json get AJ ".apps[$i].rx")")
		A_TX+=("$(json get AJ ".apps[$i].tx")")
		A_RX5+=("$(json get AJ ".apps[$i].rx5")")
		A_TX5+=("$(json get AJ ".apps[$i].tx5")")
	done
	# the node sends them biggest by total; for "by rate", sort here (a few dozen rows: an insertion sort is plenty)
	[ "$by" = rate ] || return 0
	for ((i = 0; i < ${#A_NAME[@]}; i++)); do key[$i]=$((A_RX5[i] + A_TX5[i])); done
	for ((i = 1; i < ${#A_NAME[@]}; i++)); do
		j=$i
		while [ "$j" -gt 0 ] && [ "${key[$((j - 1))]}" -lt "${key[$j]}" ]; do
			for k in A_NAME A_PID A_OK A_RX A_TX A_RX5 A_TX5 key; do
				eval "t=\${$k[$j]}; $k[$j]=\${$k[$((j - 1))]}; $k[$((j - 1))]=\$t"
			done
			j=$((j - 1))
		done
	done
	return 0
}

fn wt_table(by, int n) {
	local i shown=0 mark tot

	wt_apps "$by" || { echo "wiretap: $ERRMSG" >&2; exit 1; }
	printf '%-20s %7s %9s %9s %9s\n' APP PID DOWN/s UP/s TOTAL
	for ((i = 0; i < ${#A_NAME[@]} && shown < n; i++)); do
		tot=$((A_RX[i] + A_TX[i]))
		[ "$tot" -gt 0 ] || continue
		if [ "$by" = rate ] && [ $((A_RX5[i] + A_TX5[i])) -eq 0 ]; then continue; fi
		mark=
		[ "${A_OK[$i]}" = true ] || mark="  ?"
		printf '%-20s %7s %9s %9s %9s%s\n' "${A_NAME[$i]}" "${A_PID[$i]}" "$(wt_human "${A_RX5[$i]}")" "$(wt_human "${A_TX5[$i]}")" "$(wt_human "$tot")" "$mark"
		shown=$((shown + 1))
	done
	[ "$shown" -gt 0 ] || echo "(nothing talking just now)"
	return 0
}

# The remote addresses, biggest first: address, the program that last spoke to it, bytes down and up, and when it was last heard.
# --names also looks each one up (the service cannot: it has no IP sockets); a lookup that takes over two seconds is left as the address.
fn wt_hosts(int n, int names) {
	local H HJ i cnt a app rx tx last nm now

	wt_need
	H := wt hosts "$n" || { echo "wiretap: $ERRMSG" >&2; exit 1; }
	json parse HJ "$H"
	now := json get HJ .now
	cnt := json len HJ .hosts
	printf '%-40s %-14s %9s %9s %6s\n' ADDRESS APP DOWN UP AGO
	for ((i = 0; i < cnt; i++)); do
		a := json get HJ ".hosts[$i].addr"
		app := json get HJ ".hosts[$i].app"
		rx := json get HJ ".hosts[$i].rx"
		tx := json get HJ ".hosts[$i].tx"
		last := json get HJ ".hosts[$i].last"
		nm=$a
		if [ "$names" = 1 ]; then
			nm=$(timeout 2 getent hosts "$a" 2> /dev/null | { read -r _ x _; echo "${x:-}"; })
			nm=${nm:-$a}
		fi
		printf '%-40s %-14s %9s %9s %5ss\n' "$nm" "$app" "$(wt_human "$rx")" "$(wt_human "$tx")" "$((now - last))"
	done
	[ "$cnt" -gt 0 ] || echo "(no remote hosts yet)"
	return 0
}

# ---- the firewall (M2, ADR 0022-0026) -------------------------------------------------------------------------------
# The rules live in /etc/wiretap/rules (readable by anyone); only /usr/libexec/wiretap-rules, through pkexec, changes them.
WT_RULES=${WT_RULES:-/etc/wiretap/rules}

# wt_fw_priv VERB: the root helper, rules (if any) on this function's standard input. WT_RULES_HELPER names another program (a test,
# or your own); it is run as you, so it grants nothing.
fn wt_fw_priv(v) {
	local h
	h=${WT_RULES_HELPER:-/usr/libexec/wiretap-rules}
	[ -x "$h" ] || { echo "wiretap: the firewall helper is not installed ($h)" >&2; return 1; }
	if [ -n "${WT_RULES_HELPER:-}" ] || [ "$(id -u)" = 0 ]; then
		"$h" "$v"
	elif command -v pkexec > /dev/null 2>&1; then
		pkexec "$h" "$v"
	else
		echo "wiretap: changing the firewall needs polkit (pkexec), or run this as root" >&2
		return 1
	fi
}

fn wt_fw_text() {
	[ -r "$WT_RULES" ] && cat "$WT_RULES"
	return 0
}

# the rules numbered, comments and blank lines left out
fn wt_fw_list() {
	local l t n
	n=0
	while IFS= read -r l; do
		t=${l%%#*}
		[ -n "${t//[[:space:]]/}" ] || continue
		n=$((n + 1))
		printf '%3d  %s\n' "$n" "$t"
	done < <(wt_fw_text)
	[ "$n" -gt 0 ] || echo "(no rules: everything is allowed)"
	return 0
}

# wt_fw_set TEXT: check the whole text with the engine first (so a mistake costs no password), then hand it to the helper
fn wt_fw_set(text) {
	local f
	f=$(mktemp) || return 1
	printf '%s\n' "$text" > "$f"
	if ! wt fwrender "$f" > /dev/null; then
		echo "wiretap: ${ERRMSG:-the rules are not valid}" >&2
		rm -f "$f"
		return 1
	fi
	rm -f "$f"
	printf '%s\n' "$text" | wt_fw_priv apply || return 1
	echo "wiretap: firewall rules applied"
}

# fw block|allow HOST [PORT] [--tcp|--udp] [--in] [--uid N] [--cgroup /PATH] [--first]
fn wt_fw_add(...a) {
	local act host port proto dir who first rule old i x hostset
	hostset=0; act=${a[0]}; host=any; port=any; proto=any; dir=out; who=any; first=0
	for ((i = 1; i < ${#a[@]}; i++)); do
		x=${a[$i]}
		case $x in
		--tcp) proto=tcp ;;
		--udp) proto=udp ;;
		--in) dir=in ;;
		--first) first=1 ;;
		--uid) i=$((i + 1)); who=uid:${a[$i]:-} ;;
		--cgroup) i=$((i + 1)); who=cgroup:${a[$i]:-} ;;
		-*) echo "wiretap: fw $act: unknown option $x" >&2; return 2 ;;
		*)
			if [ "$hostset" = 0 ]; then host=$x; hostset=1
			else port=$x; fi ;;
		esac
	done
	rule="$act $dir $proto $who $host $port"
	old=$(wt_fw_text)
	if [ -z "$old" ]; then wt_fw_set "$rule"
	elif [ "$first" = 1 ]; then wt_fw_set "$rule
$old"
	else wt_fw_set "$old
$rule"; fi
}

# fw rm N: take the Nth rule out
fn wt_fw_rm(n) {
	local l t k out
	case $n in ''|*[!0-9]*) echo "wiretap: fw rm N: N is the rule's number from  wiretap fw" >&2; return 2 ;; esac
	k=0; out=""
	while IFS= read -r l; do
		t=${l%%#*}
		if [ -n "${t//[[:space:]]/}" ]; then
			k=$((k + 1))
			[ "$k" = "$n" ] && continue
		fi
		out="$out$l
"
	done < <(wt_fw_text)
	[ "$n" -ge 1 ] && [ "$n" -le "$k" ] || { echo "wiretap: there is no rule $n" >&2; return 1; }
	wt_fw_set "$out"
}

fn wt_fw(...a) {
	case ${a[0]:-list} in
	list | "") wt_fw_list ;;
	block | allow) wt_fw_add "${a[@]}" ;;
	rm) wt_fw_rm "${a[1]:-}" ;;
	on) wt_fw_priv on < /dev/null && echo "wiretap: firewall on" ;;
	off) wt_fw_priv off < /dev/null && echo "wiretap: firewall off (the rules are kept; wiretap fw on)" ;;
	render) wt fwrender "$WT_RULES" || { echo "wiretap: ${ERRMSG:-failed}" >&2; return 1; } ;;
	*) echo "usage: wiretap fw [list | block|allow HOST [PORT] [--tcp|--udp] [--in] [--uid N] [--cgroup /PATH] [--first] | rm N | on | off | render]" >&2; return 2 ;;
	esac
}

declare -ga BLK=(" " "▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")

# A mirrored graph of the last `secs` seconds: download above the line, upload below it, hung from it.
fn wt_graph(int secs, int rows) {
	local S i r max=1 v e cnt line half
	local -a din dout
	local g_in= g_out= rev= off= rst=

	wt_need
	S := wt series 1 "$secs" || { echo "wiretap: $ERRMSG" >&2; exit 1; }
	json parse SJ "$S"
	cnt := json len SJ .in
	for ((i = 0; i < cnt; i++)); do
		din[$i]="$(json get SJ ".in[$i]")"
		dout[$i]="$(json get SJ ".out[$i]")"
		[ "${din[$i]}" -gt "$max" ] && max=${din[$i]}
		[ "${dout[$i]}" -gt "$max" ] && max=${dout[$i]}
	done
	if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
		g_in=$'\e[32m'; g_out=$'\e[36m'; rev=$'\e[7m'; off=$'\e[27m'; rst=$'\e[0m'
	fi
	printf 'down %s/s   up %s/s   scale %s/s   last %ds\n' "$(wt_human "${din[$((cnt - 1))]}")" "$(wt_human "${dout[$((cnt - 1))]}")" "$(wt_human "$max")" "$cnt"
	for ((r = rows - 1; r >= 0; r--)); do
		line=
		for ((i = 0; i < cnt; i++)); do
			e=$((din[i] * rows * 8 / max - r * 8))
			[ "$e" -gt 8 ] && e=8
			[ "$e" -lt 0 ] && e=0
			line+="${BLK[$e]}"
		done
		printf '%s%s%s\n' "$g_in" "$line" "$rst"
	done
	line=
	for ((i = 0; i < cnt; i++)); do line+="─"; done
	printf '%s\n' "$line"
	for ((r = 0; r < rows; r++)); do
		line=
		for ((i = 0; i < cnt; i++)); do
			e=$((dout[i] * rows * 8 / max - r * 8))
			[ "$e" -gt 8 ] && e=8
			[ "$e" -lt 0 ] && e=0
			if [ "$e" -eq 0 ]; then line+=" "; else line+="$rev${BLK[$((8 - e))]}$off"; fi
		done
		printf '%s%s%s\n' "$g_out" "$line" "$rst"
	done
	return 0
}

fn wt_doctor() {
	local mod run cap un bad=0 note

	echo "script    $SELF_VERSION"
	if mod := wt version 2> /dev/null; then
		echo "engine    $mod (the installed module)"
		[ "$mod" = "$SELF_VERSION" ] || { echo "          out of step with the script"; bad=1; }
	else
		echo "engine    NOT FOUND: install the wiretap package"
		bad=1
	fi
	if wt_up; then
		run := json get WT_ST .version
		cap := json get WT_ST .capture
		un := json get WT_ST .processes_unreadable
		note := json get WT_ST .capture_note
		echo "node      $run, answering on $WT_SOCK"
		[ "$run" = "$mod" ] || { echo "          the running node is not the installed engine: turn it off and on"; bad=1; }
		if [ "$cap" = true ]; then
			echo "packets   being captured"
		else
			echo "packets   NOT captured: $note"
			echo "          (the service has CAP_NET_RAW; a node you start yourself does not)"
			bad=1
		fi
		if [ "${un:-0}" -gt 0 ]; then
			echo "processes $un could not be read: that traffic is shown as (root) or (user N)"
			echo "          (the service has CAP_SYS_PTRACE and CAP_DAC_READ_SEARCH; a node you start yourself does not)"
		else
			echo "processes all readable"
		fi
	else
		echo "node      not running ($WT_SOCK)"
		if [ -S /run/wiretap/ctl ]; then
			echo "          the service's socket is there but you cannot use it: join the group (usermod -aG wiretap \$USER) and log in again"
		elif command -v systemctl > /dev/null 2>&1 && [ -e /usr/lib/systemd/system/wiretap.service ]; then
			echo "          start the service for the whole machine:  sudo systemctl enable --now wiretap"
			echo "          (or just for you, without per-app names:  wiretap on)"
		else
			echo "          start one for you:  wiretap on"
		fi
		bad=1
	fi
	[ "$bad" = 0 ] && echo "all well"
	return $bad
}

json=0
names=0
args=()
for a in "$@"; do
	case $a in
	--json) json=1 ;;
	--names) names=1 ;;
	*) args+=("$a") ;;
	esac
done
cmd=${args[0]:-}

case $cmd in
"")
	wt_up || wt_on || exit 1
	wt_show ;;
on) wt_on ;;
off | down)
	run wt stop > /dev/null
	echo "wiretap: stopped" ;;
status) wt_need; run wt status ;;
show)
	if [ "$json" = 1 ]; then wt_need; run wt status; else wt_show; fi ;;
top)
	wt_need
	if [ "$json" = 1 ]; then run wt apps; else wt_table rate "${args[1]:-10}"; fi ;;
usage)
	wt_need
	if [ "$json" = 1 ]; then run wt apps; else wt_table total "${args[1]:-10}"; fi ;;
hosts)
	if [ "$json" = 1 ]; then wt_need; run wt hosts "${args[1]:-20}"; else wt_hosts "${args[1]:-20}" "$names"; fi ;;
graph)
	if [ "$json" = 1 ]; then wt_need; run wt series 1 "${args[1]:-60}"; else wt_graph "${args[1]:-60}" "${args[2]:-5}"; fi ;;
watch)
	wt_need
	while :; do
		printf '\e[H\e[2J'
		wt_table rate 20
		sleep 1
	done ;;
fw) wt_fw "${args[@]:1}" ;;
doctor) wt_doctor ;;
version)
	echo "wiretap $SELF_VERSION"
	if v := wt version 2> /dev/null; then echo "engine  $v"; fi
	if wt_up; then r := json get WT_ST .version; echo "node    $r"; fi ;;
help | -h | --help) usage ;;
*) usage >&2; exit 2 ;;
esac
