#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# video-tubi -- Tubi (tubitv.com) for the Video player (apps/video): what only Tubi knows. A provider lib (kind `lib`): it adds itself to VIDEO_SITES,
# and the app calls its functions by their prefix, vt_. Tubi's lists (the home page, a search, a series and its seasons) are read from the page's own
# links; a title is Tubi's page for it, cut down to its one <video> once that holds data. A title that Tubi protects with DRM cannot be played by this
# engine, and the player says so rather than waiting.

strict

app video-tubi "Video: Tubi, a site for the Video player" 1.0

VIDEO_TUBI_LIBDONE=1

declare -gA VIDEO_SITES VIDEO_NAMES VIDEO_KEYS VIDEO_API
declare -ga VIDEO_ORDER
VIDEO_SITES["tubi"]=vt_
VIDEO_API["tubi"]=1
VIDEO_NAMES["tubi"]="Tubi"
VIDEO_KEYS["tubi"]=t
VIDEO_ORDER+=(tubi)

VT_BASE="${VT_BASE-https://tubitv.com}"

# The consent wall Tubi puts up first: its accept-all button, pressed.
VT_CONSENT='var b=Array.from(document.querySelectorAll("button")).find(function(x){return /accept all/i.test(x.textContent)});if(b)b.click();'

# The titles a page lists: films and series on a home page or a search, the
# episodes of a series' page (then only those), each with the words under
# its poster. Empty until the page has made them. `seasons` is the count of
# the season tabs.
VT_RJS='(function(){'"$VT_CONSENT"'var seen={},out=[],eps=[];function tx(s){return (s||"").replace(/\s+/g," ").trim()}Array.from(document.querySelectorAll("a[href*=\"/movies/\"],a[href*=\"/series/\"],a[href*=\"/tv-shows/\"]")).forEach(function(a){var h=a.getAttribute("href").replace(/^https?:\/\/[^\/]*/,"");if(seen[h])return;var m=h.match(/^\/(movies|series|tv-shows)\//);if(!m)return;seen[h]=1;var im=a.querySelector("img"),t=tx(a.textContent),k=m[1]=="movies"?"movie":m[1]=="series"?"series":"episode";if(k!="episode"&&im&&im.alt)t=tx(im.alt);if(!t)t=tx(a.getAttribute("aria-label"));var sub="",ln="";if(k=="episode"){t=t.replace(/^Play Icon/i,"");var e=t.match(/^(S\d+:E\d+)\s*-?\s*(.*)$/i);if(e){sub=e[1];t=e[2]||e[1]}var d=t.match(/^(.*?)(\d+ ?h(?:r)?(?: ?\d+ ?min)?|\d+ ?min)/);if(d&&d[1]){t=d[1].trim();ln=d[2]}}var o={kind:k,id:h,title:t.slice(0,80),ch:sub,len:ln};(k=="episode"?eps:out).push(o)});var l=eps.length?eps:out;if(!l.length)return "";var h1=document.querySelector("h1");var ss=Array.from(document.querySelectorAll("[role=tab],button")).filter(function(x){return /^season\s*\d+/i.test(tx(x.textContent))});return JSON.stringify({head:h1?tx(h1.textContent):"",list:l,seasons:ss.length})})()'

# The page set aside and the video laid over it, edge to edge. Not the cut the
# YouTube app makes (everything that does not hold the video hidden): Tubi takes
# that for the player having left the screen and tears it down after a few seconds.
VT_CSS='html,body{overflow:hidden!important;background:#000!important}video{position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;max-width:none!important;max-height:none!important;z-index:2147483647!important;object-fit:contain!important;background:#000!important;border-radius:0!important}'

# The address of a list: the home page, a search, or a series' page.
fn vt_url(int id, kind, arg) {
	case $kind in
	home) ret "$VT_BASE/" ;;
	search) ret "$VT_BASE/search/${arg// /%20}" ;;
	series) ret "$VT_BASE$arg" ;;
	*) ret "" ;;
	esac
}

# The script that reads a loaded list page into rows.
fn vt_rjs() {
	ret "$VT_RJS"
}

# The address to load for a title: its page; the number in its path is what the player's own page is told by.
fn vt_start(int id, key, part) {
	local n

	n := vt_num "$key"
	VP[$id]["num"]=$n
	ret "$VT_BASE$key"
}

# Its page on the site, for Copy.
fn vt_address(key) {
	ret "$VT_BASE$key"
}

# What the heading of a series' list says (its seasons, when it has several).
fn vt_heading(int id, kind) {
	local h=${VP[$id]["head"]} s=

	case $kind in
	series)
		[ "${VP[$id]["seasons"]:-0}" -gt 1 ] && s="  (season ${VP[$id]["season"]} of ${VP[$id]["seasons"]}, left and right)"
		ret "${h:-Series}$s" ;;
	*) ret "$h" ;;
	esac
}

# The keys a list has of its own: left and right are the seasons of a series.
fn vt_listkey(int id, key) {
	case $key in
	left) vt_season "$id" -1 ;;
	right) vt_season "$id" 1 ;;
	*) return 1 ;;
	esac
}

# Start the player once the page has it: the consent cleared, the player's own play button pressed once
# if nothing starts by itself, and -- only once a video holds data, since Tubi rebuilds its player if it
# is touched before -- the page cut down, the volume set and the video started. "ok" when it is going.
fn vt_startjs(v, num) {
	ret "(function(){if(location.pathname.indexOf(\"$num\")<0)return \"\";${VT_CONSENT}if(b&&!window.hibrVtC){window.hibrVtC=1;return \"\"}var v=document.querySelector(\"video\");if(!v||v.readyState<2){var b=document.querySelector(\"button[aria-label^='Play keyboard']\");if(b&&!window.hibrVtClicked){window.hibrVtClicked=1;b.click()}return \"\"}if(!document.getElementById(\"hibr-tu\")){var c=document.createElement(\"style\");c.id=\"hibr-tu\";c.textContent=\"$VT_CSS\";document.head.appendChild(c)}for(var q=v.parentElement;q&&q!==document.body;q=q.parentElement){[\"transform\",\"filter\",\"contain\",\"clip-path\",\"perspective\"].forEach(function(k){q.style.setProperty(k,\"none\",\"important\")});q.style.setProperty(\"overflow\",\"visible\",\"important\")}for(var u=v;u&&u!==document.body;u=u.parentElement){Array.from(u.parentElement.children).forEach(function(o){if(o!==u&&o.tagName!==\"STYLE\"&&o.tagName!==\"SCRIPT\")o.style.setProperty(\"display\",\"none\",\"important\")})}v.muted=false;v.volume=$v/100;if(v.paused)v.play();return \"ok\"})()"
}

# The number in a title's path (/movies/100039855/the-baxter): Tubi's id for it.
fn vt_num(path) {
	local n=${path#/*/}

	ret "${n%%/*}"
}

# Another season of a series: its tab pressed in the page, the list read again.
fn vt_season(int id, int dir) {
	local n=${VP[$id]["seasons"]:-0} s=${VP[$id]["season"]:-1}

	[ "${VP[$id]["view"]}" = list ] && [ "${VP[$id]["kind"]}" = series ] && [ "$n" -gt 1 ] || return 0
	s=$((s + dir))
	[ "$s" -lt 1 ] && s=1
	[ "$s" -gt "$n" ] && s=$n
	[ "$s" = "${VP[$id]["season"]}" ] && return 0
	VP[$id]["season"]=$s
	vp_send "${VP[$id]["st"]}" "(function(){var t=Array.from(document.querySelectorAll(\"[role=tab],button\")).filter(function(x){return /^season\s*\d+/i.test(x.textContent.trim())});if(t[$((s - 1))])t[$((s - 1))].click()})()"
	VP[$id]["n"]=0
	VP[$id]["sel"]=0
	VP[$id]["top"]=0
	VP[$id]["err"]=
	VP[$id]["searching"]=$EPOCHSECONDS
	VP[$id]["settle"]=$EPOCHSECONDS
}

# The shortest title whose end is believed: Tubi's adverts are short clips, and the end of one reads as the title's.
fn vt_minlen() {
	ret 40
}
