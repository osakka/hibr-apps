#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# video-bilibili -- Bilibili (bilibili.com) for the Video player (apps/video): what only Bilibili knows. A provider lib (kind `lib`): it adds itself to
# VIDEO_SITES, and the app calls its functions by their prefix, vb_. Bilibili's lists are its own public pages of data (the popular list, a search),
# which the engine loads like any page and the app reads, after one visit to the site in the window (a search is refused without its cookies). A video is
# looked up in two steps -- its part, then its file, an MP4 of 720p or 360p that expires, so it is asked for each time one starts -- and played in a small
# page of this lib's own with one <video> in it. A file the engine cannot reach or play never says so (it stalls): the player gives a title up after
# thirty seconds. Only ids that look like Bilibili's (BV and letters and digits) are played.

strict

app video-bilibili "Video: Bilibili, a site for the Video player" 1.2

VIDEO_BILIBILI_LIBDONE=1

declare -gA VIDEO_SITES VIDEO_NAMES VIDEO_KEYS VIDEO_API
declare -ga VIDEO_ORDER
VIDEO_SITES["bilibili"]=vb_
VIDEO_API["bilibili"]=1
VIDEO_NAMES["bilibili"]="Bilibili"
VIDEO_KEYS["bilibili"]=b
VIDEO_ORDER+=(bilibili)

# Where the site's pages are.
# The resolution asked for (Bilibili's anonymous links have 720p and 360p, and 480p between on some): kept for next time, applied to the next title opened.
VB_QUALITIES=(720p 480p 360p)
VB_QUALITY="${VB_QUALITY-720p}"
command -v dt_keep > /dev/null && dt_keep VB_QUALITY

VB_BASE="${VB_BASE-https://www.bilibili.com}"
VB_API="${VB_API-https://api.bilibili.com}"

# The titles a data page lists, as the rows the lists draw: kind id title channel length. The page is JSON text; "" until it is one (the page before is
# still there for a moment after a go). A search's titles carry <em> markup and entities, its durations are 1:02 and the popular list's are seconds.
VB_RJS='(function(){var j;try{j=JSON.parse(document.body.innerText)}catch(e){var q=document.body?document.body.innerText:"";if(/412/.test(q)&&q.length<600)return JSON.stringify({list:[],err:"the site refused the request (412)"});return ""}if(!j||typeof j.code!=="number")return "";if(j.code!==0||!j.data)return JSON.stringify({list:[],err:String(j.message||j.code)});var l=j.data.list||j.data.result||[];function tx(s){return String(s||"").replace(/<[^>]*>/g,"").replace(/&amp;/g,"&").replace(/&lt;/g,"<").replace(/&gt;/g,">").replace(/&quot;/g,"\"").replace(/&#39;/g,"\x27").replace(/\s+/g," ").trim()}function secs(d){if(typeof d==="number")return d;var s=0;String(d||"0").split(":").forEach(function(x){s=s*60+(Number(x)||0)});return s}function hms(n){var h=Math.floor(n/3600),m=Math.floor(n%3600/60),s=n%60;return h?h+":"+("0"+m).slice(-2)+":"+("0"+s).slice(-2):m+":"+("0"+s).slice(-2)}return JSON.stringify({list:l.filter(function(x){return x.bvid}).map(function(x){return {kind:"video",id:x.bvid,title:tx(x.title),ch:tx(x.author||(x.owner&&x.owner.name)),len:hms(secs(x.duration))}})})})()'

# A video's part (the first, or the one asked for; how many there are, and its own name), and then its file's address: each from its own data page
# (the page before is told by its address).
VB_URLJS='(function(){if(location.href.indexOf("playurl")<0)return "";var j;try{j=JSON.parse(document.body.innerText)}catch(e){return ""}if(!j||typeof j.code!=="number")return "";if(j.code!==0||!j.data||!j.data.durl||!j.data.durl[0])return "err:"+(j.message||j.code);var d=j.data.durl[0];return [d.url].concat(d.backup_url||[]).join("|")})()'

# The address of a list: the popular list, or a search (the engine percent-encodes what it must; the few characters that mean something in an address
# are done here).
fn vb_url(int id, kind, arg) {
	local q

	case $kind in
	home) ret "$VB_API/x/web-interface/popular?ps=20&pn=1" ;;
	search)
		q=${arg//%/%25}
		q=${q//&/%26}
		q=${q//#/%23}
		q=${q//+/%2B}
		q=${q// /%20}
		ret "$VB_API/x/web-interface/search/type?search_type=video&page=1&keyword=$q"
		;;
	*) ret "" ;;
	esac
}

# A first visit to the site, for the cookies its data pages ask for.
fn vb_warm_url(int id) {
	ret "$VB_BASE/"
}

# The script that reads a loaded list page into rows.
fn vb_rjs() {
	ret "$VB_RJS"
}

# The address to load first for a title: its first lookup (the parts of the video); the lookups after it are vb_step's.
fn vb_start(int id, key, part) {
	VP[$id]["rstep"]=cid
	ret "$VB_API/x/player/pagelist?bvid=$key"
}

# Its page on the site, for Copy.
fn vb_address(key) {
	ret "$VB_BASE/video/$key"
}

# Whether a key is what Bilibili's own ids look like: BV and letters and digits. It reaches a file name, an address and a script, so nothing else is let
# through, whether it came from its list, the history file or a `play:` argument.
fn vb_validkey(key) {
	case $key in
	BV* | bv*) ;;
	*) return 1 ;;
	esac
	case $key in
	*[!0-9A-Za-z]*) return 1 ;;
	esac
	return 0
}

fn vb_cidjs(p) {
	ret "(function(){if(location.href.indexOf(\"pagelist\")<0)return \"\";var j;try{j=JSON.parse(document.body.innerText)}catch(e){return \"\"}if(!j||typeof j.code!==\"number\")return \"\";if(j.code!==0||!j.data||!j.data[0])return \"err:\"+(j.message||j.code);var i=Math.min(Math.max($p,1),j.data.length)-1;return JSON.stringify({cid:String(j.data[i].cid),n:j.data.length,p:i+1,part:String(j.data[i].part||\"\")})})()"
}

# Start the player once the video holds data: the volume set and the video started. "ok" when it is going.
fn vb_startjs(v, num) {
	ret "(function(){if(location.pathname.indexOf(\"$num\")<0)return \"\";var v=document.querySelector(\"video\");if(!v||v.readyState<2)return \"\";v.muted=false;v.volume=$v/100;if(v.paused)v.play();return \"ok\"})()"
}

# Looking a video up, two data pages in the player tab: its first part, then the address of its file (and of the site's other servers for it); then the player
# is given them (vp_playlinks: a small page of the app's own with that one <video> in it, the next address if one is refused, the first from a page of the site
# itself as a last try) and starts from it as it would from any page. A step that says no (the page's own words), or does not answer, ends in the window.
fn vb_step(int id) {
	local t=${VP[$id]["pt"]} js key=${VP[$id]["vid"]} q qn
	local -A r

	web loading "$t" 2> /dev/null && return 0
	if [ "${VP[$id]["rstep"]}" = cid ]; then
		q := vb_cidjs "${VP[$id]["part"]:-1}"
		js := web eval "$t" "$q" 2> /dev/null
		[ -n "$js" ] || return 0
		case $js in
		err:*) VP[$id]["err"]="Bilibili said: ${js#err:}"; vp_stop "$id"; return 0 ;;
		esac
		json parse r <<< "$js" 2> /dev/null || r=()
		[ -n "${r["cid"]}" ] || return 0
		VP[$id]["parts"]=${r["n"]:-1}
		VP[$id]["part"]=${r["p"]:-1}
		VP[$id]["ptitle"]=${r["part"]}
		VP[$id]["rstep"]=url
		qn := vb_qn
		web go "$t" "$VB_API/x/player/playurl?bvid=$key&cid=${r["cid"]}&qn=$qn&fnval=1&platform=html5" 2> /dev/null
		return 0
	fi
	js := web eval "$t" "$VB_URLJS" 2> /dev/null
	[ -n "$js" ] || return 0
	case $js in
	err:*) VP[$id]["err"]="Bilibili said: ${js#err:}"; vp_stop "$id"; return 0 ;;
	esac
	vp_playlinks "$id" "$js"
	return 0
}

# A page of the site itself, for the last try at a file (a file server may want the Referer the site's own player sends).
fn vb_origin(int id) {
	ret "$VB_BASE/robots.txt"
}

# The number the playurl API takes for the resolution asked for.
fn vb_qn() {
	case $VB_QUALITY in
	480p) ret 32 ;;
	360p) ret 16 ;;
	*) ret 64 ;;
	esac
}

# Step the resolution on or back, and say so: it is the next title that has it, since a link is fetched for one resolution.
fn vb_quality(int id = 0, int dir = 1) {
	local i=0 q

	for i in "${!VB_QUALITIES[@]}"; do
		[ "${VB_QUALITIES[$i]}" = "$VB_QUALITY" ] && break
	done
	q=${VB_QUALITIES[$(( (i + dir + ${#VB_QUALITIES[@]}) % ${#VB_QUALITIES[@]} ))]}
	vb_setquality "$q"
	dt_notep low "Quality %s, from the next video" "$q"
	return 0
}
fn vb_setquality(q) {
	VB_QUALITY=$q
	command -v dt_save > /dev/null && dt_save
	return 0
}
fn vb_key(int id, key) {
	case $key in
	q) vb_quality "$id"; return 0 ;;
	Q) vb_quality "$id" -1; return 0 ;;
	esac
	return 1
}
# Its menu items, at the end of the Picture menu and in the player's right-click menu.
fn vb_menus(int id) {
	local q on x

	for q in "${VB_QUALITIES[@]}"; do
		on=0
		[ "$VB_QUALITY" = "$q" ] && on=1
		x := dt_tr "Quality %s" "$q"
		dt_mark "$x" "" "$on" vb_setquality "$q"
	done
	return 0
}
# Its rows in Control Panel > Video.
fn vb_settings() {
	ret "quality|choice|Quality Fetched|${VB_QUALITIES[*]}"
}
fn vb_setget(key) {
	ret "$VB_QUALITY"
}
fn vb_setset(key, value) {
	vb_setquality "$value"
}
