#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# video-bilibilitv -- Bilibili TV (bilibili.tv, the international site) for the Video player (apps/video): what only it knows. A provider lib (kind `lib`): it
# adds itself to VIDEO_SITES, and the app calls its functions by their prefix, vq_. Its lists (the home page, a search) are the site's own pages, read from their
# links: a title's id is the number in the link and its words are its picture's text. A video is looked up in one step, the site's own data service (the page
# the site's player asks it for, loaded in the player tab as a page and read): it answers with the address of an MP4 file, which is played in a small page of this
# lib's own with one <video> in it. (The site's own player, in a window that is not shown, does not start; the file itself plays and seeks.) A file that does not
# come is given up on by the player after twenty-five seconds, one that does not play after thirty, and the window says so. Only ids that are numbers are played.

strict

app video-bilibilitv "Video: Bilibili TV, a site for the Video player" 1.0

VIDEO_BILIBILITV_LIBDONE=1

declare -gA VIDEO_SITES VIDEO_NAMES VIDEO_KEYS VIDEO_API
declare -ga VIDEO_ORDER
VIDEO_SITES["bilibilitv"]=vq_
VIDEO_API["bilibilitv"]=1
VIDEO_NAMES["bilibilitv"]="Bilibili TV"
VIDEO_KEYS["bilibilitv"]=v
VIDEO_ORDER+=(bilibilitv)

# Where the site's pages are, and where the pages this lib writes for the player are kept.
VQ_BASE="${VQ_BASE-https://www.bilibili.tv}"
VQ_API="${VQ_API-https://api.bilibili.tv}"
VQ_PLAYDIR="${VQ_PLAYDIR-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/hibr-bilibilitv-$UID}"

# The titles a loaded page lists, as the rows the lists draw: kind id title channel length. Each is a link to /video/NUMBER; its words are its picture's text (or
# its own title or words). "" until the page has made some.
VQ_RJS='(function(){var seen={},out=[];Array.from(document.querySelectorAll("a[href*=\"/video/\"]")).forEach(function(a){var m=(a.getAttribute("href")||"").match(/\/video\/(\d+)/);if(!m||seen[m[1]])return;var im=a.querySelector("img");var t=((im&&im.alt)||a.getAttribute("title")||a.textContent||"").replace(/\s+/g," ").trim();if(!t)return;seen[m[1]]=1;out.push({kind:"video",id:m[1],title:t.slice(0,100),ch:"",len:""})});return out.length?JSON.stringify({list:out}):""})()'

# What the site's data service answered, read from its page: the address of the MP4 file, or `err:` and its words. "" until the page is its answer (the page
# before is still there for a moment after a go).
VQ_URLJS='(function(){if(location.href.indexOf("playurl")<0)return "";var j;try{j=JSON.parse(document.body.innerText)}catch(e){return ""}if(!j||typeof j.code!=="number")return "";if(j.code!==0)return "err:"+(j.message||j.code);var p=j.data&&j.data.playurl,v=p&&p.video&&p.video[0]&&p.video[0].video_resource;return v&&v.url?v.url:"err:no file for this video"})()'

# The address of a list: the home page, or a search (what means something in an address is done here).
fn vq_url(int id, kind, arg) {
	local q

	case $kind in
	home) ret "$VQ_BASE/en/" ;;
	search)
		q=${arg//%/%25}
		q=${q//&/%26}
		q=${q//#/%23}
		q=${q//+/%2B}
		q=${q// /%20}
		ret "$VQ_BASE/en/search-result?q=$q"
		;;
	*) ret "" ;;
	esac
}

# The script that reads a loaded list page into rows.
fn vq_rjs() {
	ret "$VQ_RJS"
}

# The address to load first for a title: the site's data service asked for its file (it answers as a page of JSON); vq_step reads the file's address out of it.
fn vq_start(int id, key, part) {
	ret "$VQ_API/intl/gateway/web/playurl?s_locale=en_US&platform=web&aid=$key&tk=&qn=64&type=0&device=wap&tf=0&force_container=2"
}

# Its page on the site, for Copy.
fn vq_address(key) {
	ret "$VQ_BASE/en/video/$key"
}

# The page written for the playing, with the file's signed address in it, taken away when the playing stops.
fn vq_cleanup(int id) {
	[ -n "${VP[$id]["vid"]-}" ] && command rm -f -- "$VQ_PLAYDIR/${VP[$id]["vid"]}.html" 2> /dev/null
	return 0
}

# Whether a key is what the site's own ids look like: a number. It reaches a file name, an address and a script, so nothing else is let through, whether it
# came from its list, the history file or a `play:` argument.
fn vq_validkey(key) {
	case $key in
	"" | *[!0-9]*) return 1 ;;
	esac
	[ "${#key}" -ge 5 ] && [ "${#key}" -le 20 ]
}

# Start the player once the file holds data: the volume set and the video started. "ok" when it is going.
fn vq_startjs(v, num) {
	ret "(function(){if(location.pathname.indexOf(\"$num\")<0)return \"\";var v=document.querySelector(\"video\");if(!v||v.readyState<2)return \"\";v.muted=false;v.volume=$v/100;if(v.paused)v.play();return \"ok\"})()"
}

# Looking a video up: the data service's answer is in the player tab; its file's address is read out, a small page with that one <video> in it is written and
# gone to, and the player starts from it as it would from any page. An answer that says no (the site's own words) ends in the window.
fn vq_step(int id) {
	local t=${VP[$id]["pt"]} key=${VP[$id]["vid"]} js u f

	web loading "$t" 2> /dev/null && return 0
	js := web eval "$t" "$VQ_URLJS" 2> /dev/null
	[ -n "$js" ] || return 0
	case $js in
	err:*) VP[$id]["err"]="Bilibili TV said: ${js#err:}"; vp_stop "$id"; return 0 ;;
	esac
	u=${js//&/&amp;}
	u=${u//\"/&quot;}
	f="$VQ_PLAYDIR/$key.html"
	command mkdir -p -- "$VQ_PLAYDIR" 2> /dev/null
	printf '<!doctype html><meta charset=utf-8><title>%s</title><style>%s</style><video src="%s" autoplay muted playsinline></video>\n' "$key" "$VP_CSS" "$u" > "$f" 2> /dev/null || {
		VP[$id]["err"]="Cannot write the player's page"
		vp_stop "$id"
		return 0
	}
	VP[$id]["state"]=loading
	VP[$id]["since"]=$EPOCHSECONDS
	web go "$t" "file://$f" 2> /dev/null
	return 0
}
