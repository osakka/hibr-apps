#!/usr/bin/env hibr
#
# steamerset -- the Control Panel pane for Steamer: your Steam ID, the Steam
# folder, and the Web API key. The key is kept in its own file, never in the
# settings, and this pane shows only whether it is set.

strict

app steamerset "The Control Panel pane for Steamer" 0.5.2
command -v cp_pane > /dev/null && cp_pane steamerset "Steamer" "▶" app

# Shared with apps/Games/steamer.hibr; defaults kept when that is loaded first.
declare -g STM_ID="${STM_ID-}" STM_ROOT="${STM_ROOT-$HOME/.local/share/Steam}"
command -v dt_keep > /dev/null && dt_keep STM_ID STM_ROOT
declare -g STM_KEYFILE="${XDG_CONFIG_HOME:-$HOME/.config}/hibr/steamer-key"
declare -g STM_WIN="${STM_WIN-}"
STM_LINUXONLY="${STM_LINUXONLY-0}"
command -v dt_keep > /dev/null && dt_keep STM_LINUXONLY

# A setting changed: an open Steamer window lists the games again.
stm_changed() {
	[ -n "$STM_WIN" ] && dt_has stm_start && stm_start
	return 0
}

fn steamerset_rows(int w) {
	local n=0

	dt_has steamer_draw || { cp_absent "$w" Steamer; ret 1; }
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Steam ID"
	CP[$w][$n]["val"]="${STM_ID:-not set}"; CP[$w][$n]["key"]=id
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="API Key"
	CP[$w][$n]["val"]="not set"
	[ -s "$STM_KEYFILE" ] && CP[$w][$n]["val"]="set"
	CP[$w][$n]["key"]=key
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Steam Folder"
	CP[$w][$n]["val"]="$STM_ROOT"; CP[$w][$n]["key"]=root
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Linux Playable Only"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$STM_LINUXONLY" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=STM_LINUXONLY
	n=$((n + 1))
	ret "$n"
}

# A Steam ID: 17 digits. Kept only when it is one.
fn stm_setid(v, int id) {
	if [[ "$v" =~ ^[0-9]{17}$ ]]; then
		STM_ID=$v
		cp_save
		stm_changed
		return 0
	fi
	dt_notep high "A Steam ID is 17 digits"
	return 1
}

# The Steam folder, which must exist.
fn stm_setroot(v, int id) {
	[ -d "$v" ] || { dt_notep high "That folder does not exist"; return 1; }
	STM_ROOT=$v
	cp_save
	stm_changed
	return 0
}

# The key, written under umask 077 so it is never readable by others. It is
# not printed, and not kept in the settings.
fn stm_setkey(v, int id) {
	[ -n "$v" ] || { dt_notep high "The key was empty"; return 1; }
	mkdir -p "${STM_KEYFILE%/*}" 2> /dev/null
	( umask 077; printf '%s\n' "$v" > "$STM_KEYFILE" )
	dt_notep low "API key saved"
	stm_changed
	return 0
}

# A click on a row's value opens its box at once.
fn steamerset_drop(int? w = "", int? r = "", int? c = "", k = "") {
	steamerset_do "$w" "$k"
}

fn steamerset_do(int? w = "", k = "", int? dir = "") {
	case $k in
	id) dt_ask "Steam ID" "SteamID64 (17 digits):" "$STM_ID" stm_setid ;;
	key) dt_ask "API Key" "Steam Web API key:" "" stm_setkey "" 1 ;;
	root) dt_ask "Steam Folder" "Folder:" "$STM_ROOT" stm_setroot ;;
	STM_LINUXONLY) cp_toggle "$k"; cp_save; stm_changed ;;
	esac
}
