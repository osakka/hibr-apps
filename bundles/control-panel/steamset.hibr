#!/usr/bin/env hibr
#
# steamset -- the Control Panel pane for the Steam window (apps/steamwin):
# whether the bridge is installed, what the window runs, whether it takes the
# keys, and the refresh rate. Named steamset, not steamwin, because the app owns
# the steamwin_ prefix and the panel asks dt_has "<pane>_draw". The bridge itself
# has no settings: its size comes from the window, its refresh from the display,
# and Blit's own pane lists its version and how frames arrive. See docs/decisions/0025.

strict

app steamset "The Control Panel pane for the Steam window" 0.6.0
command -v cp_pane > /dev/null && cp_pane steamset "Steam" "▶" app

# Shared with apps/Games/steamwin.hibr; these defaults hold when the pane loads first.
declare -g STW_MODE="${STW_MODE-Big Picture}" STW_KEYS="${STW_KEYS-1}" STW_REFRESH="${STW_REFRESH-The display's}"
command -v dt_keep > /dev/null && dt_keep STW_MODE STW_KEYS STW_REFRESH

SS_MODES=("Big Picture" "Desktop")
SS_REFRESH=("The display's" "30 Hz" "50 Hz" "60 Hz" "75 Hz" "90 Hz" "100 Hz" "120 Hz" "144 Hz" "165 Hz" "240 Hz")

fn steamset_rows(int w) {
	local n=0 b=

	dt_has steamwin_open || { cp_absent "$w" Steam; ret 1; }
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Bridge"
	if b := stw_bridge; then
		CP[$w][$n]["val"]="installed: $b"
	else
		CP[$w][$n]["val"]="not installed: install blit-gamescope"
	fi
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Runs"
	CP[$w][$n]["val"]="$STW_MODE"; CP[$w][$n]["key"]=mode
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Keys to the Game"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$STW_KEYS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=STW_KEYS
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Refresh"
	CP[$w][$n]["val"]="$STW_REFRESH"; CP[$w][$n]["key"]=refresh
	n=$((n + 1))
	ret "$n"
}

fn cp_set_stwmode(int? id = "", value = "") { STW_MODE=$value; cp_save; }
fn cp_set_stwrefresh(int? id = "", value = "") { STW_REFRESH=$value; cp_save; }

# A change reaches a window the next time one starts: a running Steam is not restarted.
fn steamset_do(int? w = "", k = "", int? dir = "") {
	local v

	case $k in
	mode) v := cp_next "$STW_MODE" "$dir" "${SS_MODES[@]}"; STW_MODE=$v ;;
	refresh) v := cp_next "$STW_REFRESH" "$dir" "${SS_REFRESH[@]}"; STW_REFRESH=$v ;;
	STW_KEYS) cp_toggle "$k" ;;
	esac
	cp_save
}

fn steamset_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	mode) dt_droplist "$w" "$r" "$c" cp_set_stwmode "${SS_MODES[@]}" ;;
	refresh) dt_droplist "$w" "$r" "$c" cp_set_stwrefresh "${SS_REFRESH[@]}" ;;
	esac
}
