#!/usr/bin/env hibr
# blit -- API configuration and diagnostics for the Blit display server.
#
# Auxiliary Apply
# changes the running policy; Save as Default writes Blit's existing settings
# resource with revision protection. Login preferences take effect at restart.
# Font changes use Blit's live-and-saved font API. Hibr Displays continues to
# own native desktop arrangement after initial attachment.
# Every network request is hibr's own dav request, in a bounded background
# job of the desktop's (dt_job); no curl, and the token never on a command
# line. The connection token is kept in a private user file, is masked in its
# editor, and is excluded from configuration exports. The privileged updater
# token is never requested. The source of this pane is this file, in the
# hibr catalogue (itdlabs/hibr-apps), not the Blit tree.
strict
app blit "API configuration and diagnostics for the Blit display server" 0.1.35
command -v cp_pane > /dev/null && cp_pane blit "Blit" "▦" hardware
command -v cp_pane > /dev/null && cp_pane blit_mouse "Blit Mouse" "◎" hardware
command -v cp_pane > /dev/null && cp_pane blit_keyboard "Blit Keyboard" "⌨" hardware
command -v cp_pane > /dev/null && cp_pane blit_effects "Blit Effects" "◐" hardware

BCP_URL=${BCP_URL:-${BLIT_CP_URL:-http://127.0.0.1:8080}}
command -v dt_keep > /dev/null && dt_keep BCP_URL
BCP_TOKEN=
BCP_CREDENTIAL_STATUS=
BCP_CONNECTION_READY=0
BCP_CREDENTIAL_URL=
BCP_FONT_SIZE_PENDING=
BCP_FONT_SIZE_REQUESTED=
# A font size chosen while the slider is still held, and the window holding
# it: applied once the slider is let go (#368).
BCP_FONT_HELD=
BCP_FONT_HELDW=
# Blit Effects: a held slider's window, a change waiting for the request in
# flight, and conflict retries left.
BCP_FX_HELDW=
BCP_FX_PENDING=
BCP_FX_RETRIES=0
BCP_FX_BASE=
# The performance panel: the revision its last change was written over, and
# an opacity held on the slider with its window, applied once let go.
BCP_HUD_BASE=
BCP_HUD_HELD=
BCP_HUD_HELDW=
# A zoom held on a display's slider, its display and window, applied once
# let go.
BCP_ZOOM_HELD=
BCP_ZOOM_HELDID=
BCP_ZOOM_HELDW=
# The settings document the draft was based on, to tell Blit saving the
# pane's own font change from somebody else changing the settings (#364).
BCP_BASE_DOC=
# Program windows (Blit ADR 0228): blit-compositor's and Xwayland's versions
# on this computer, asked once ("" until asked, "-" when not installed), and
# whether the compositor runs, asked again after BCP_COMP_ASKED + 5 s.
BCP_COMPOSITOR_VERSION=
BCP_XWAYLAND_VERSION=
BCP_COMP_RUNNING=
BCP_COMP_ASKED=0
BCP_POINTER_ID=
BCP_KEYBOARD_ID=
# The keyboards (layouts): the one being added and its variant (Blit's
# list, the system's layouts and that layout's variants are BCP_KBLIVE,
# BCP_KBAVAIL and BCP_KBVARS).
BCP_KBADD_LAYOUT=
BCP_KBADD_VARIANT=
BCP_KBL=()
BCP_KBV=()
BCP_KBC=0
BCP_DIR=
BCP_BUSY=0
BCP_STATUS="Connect to read the server"
BCP_LAST=0
BCP_NEXT=0
BCP_FAILURES=0
BCP_REFRESH_SECONDS=15
BCP_DIRTY=0
BCP_BASE_REV=-1
BCP_OPERATION=
BCP_HTTP_CODE=000
BCP_INVALID=0
BCP_REPLY=
BCP_EDITKEY=
DAV_CODE=
declare -gA BCP_SNAPSHOT BCP_LIVE BCP_DRAFT BCP_HTTP BCP_EFFECTS BCP_FX BCP_ZAP BCP_KBLIVE BCP_KBAVAIL BCP_KBVARS
declare -gA BCP_DROP_KEY
declare -ga BCP_CHOICES
BCP_CHOICE_CURRENT=
json parse BCP_SNAPSHOT '{}'
json parse BCP_LIVE '{}'
json parse BCP_DRAFT '{}'
json parse BCP_EFFECTS '{}'
json parse BCP_ZAP '{}'
json parse BCP_KBLIVE '{}'
json parse BCP_KBAVAIL '{}'
json parse BCP_KBVARS '{}'
json parse BCP_FX '{}'

# Desktop settings use executable text and no secret permissions. Keep only
# the URL there; this data-only credential is scoped to that exact URL.
fn blit_cp_credentials(load = "1") {
    local dir=${XDG_CONFIG_HOME:-$HOME/.config}/hibr/blit file tmp mode
    local -A saved
    file=$dir/connection.json
    BCP_CREDENTIAL_STATUS=
    BCP_CONNECTION_READY=1
    BCP_CREDENTIAL_URL=$BCP_URL
    if [ "$load" = 1 ]; then
        BCP_TOKEN=
        [ -e "$file" ] || return 0
        if [ -L "$dir" ] || [ -L "$file" ] || [ ! -O "$dir" ] || [ ! -O "$file" ]; then
            BCP_CREDENTIAL_STATUS="Unsafe credential owner or symlink"; return 1
        fi
        mode := blit_cp_mode "$dir" || mode=
        if [ "${mode:0:10}" != drwx------ ]; then
            BCP_CREDENTIAL_STATUS="Credential permissions must be 0700/0600"; return 1
        fi
        mode := blit_cp_mode "$file" || mode=
        if [ "${mode:0:10}" != -rw------- ]; then
            BCP_CREDENTIAL_STATUS="Credential permissions must be 0700/0600"; return 1
        fi
        json parse saved < "$file" 2> /dev/null || { BCP_CREDENTIAL_STATUS="Invalid connection credential file"; return 1; }
        [ "${saved[url]}" != "$BCP_URL" ] || BCP_TOKEN=${saved[token]}
        return 0
    fi
    # Made under umask 077, so the folder is 0700 and the file 0600 with no
    # chmod; a folder that already exists with another mode is the one case
    # that needs one. The file is written new (noclobber) and moved over.
    (
        umask 077
        [ ! -L "$dir" ] && [ ! -L "$file" ] || exit 1
        mkdir -p "$dir" && [ -O "$dir" ] || exit 1
        mode := blit_cp_mode "$dir" || exit 1
        [ "${mode:0:10}" = drwx------ ] || command chmod 0700 "$dir" || exit 1
        tmp="$dir/.connection-$$-$RANDOM"
        json parse saved '{}'
        json set saved .url "$BCP_URL" -s
        json set saved .token "$BCP_TOKEN" -s
        set -C
        if json emit saved > "$tmp" && mv -f "$tmp" "$file"; then exit 0; fi
        rm -f "$tmp"
        exit 1
    ) || { BCP_CREDENTIAL_STATUS="Could not save API token"; return 1; }
    BCP_CREDENTIAL_STATUS="API token saved privately"
    return 0
}

# A file's mode as ls -l writes it (drwx------), from hibr's own ls module:
# in this process, and the same on Linux and macOS, where stat(1) is not.
fn blit_cp_mode(path) {
    local l
    need ls 2> /dev/null || return 1
    blit_cp_ready || return 1
    ls -ld "$path" > "$BCP_DIR/mode" 2> /dev/null || return 1
    read -r l _ < "$BCP_DIR/mode"
    ret "$l"
}
# cp_panes loads this bundle before dt_open calls dt_load. Read credentials
# on first use, after the saved URL exists, never against a guessed default.

fn blit_cp_ready() {
    [ -n "$BCP_DIR" ] && [ -d "$BCP_DIR" ] && return 0
    BCP_DIR=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/hibr-blit-$UID/$$
    ( umask 077; mkdir -p "$BCP_DIR" ) 2> /dev/null || return 1
}

# One request, through hibr's dav module: the token is a header on a
# builtin, so no command line ever holds it. HIBR_DAV_TIMEOUT bounds the
# connect and every read; the job that calls this sets it. The reply is in
# BCP_HTTP, its status in BCP_HTTP_CODE (000 when no server answered).
fn blit_cp_http(method, path, body = "", revision = "") {
    local -a o
    o=(-H "Content-Type: application/json")
    [ -z "$BCP_TOKEN" ] || o+=(-H "Authorization: Bearer $BCP_TOKEN")
    [ -z "$revision" ] || o+=(-H "If-Match: $revision")
    [ "$method" != POST ] || o+=(-H "Idempotency-Key: blit-panel-$$-$EPOCHREALTIME")
    [ -z "$body" ] || o+=(-d "$body")
    DAV_CODE=
    BCP_REPLY=
    BCP_INVALID=0
    json parse BCP_HTTP '{}'
    BCP_REPLY := dav request "${o[@]}" "$method" "$BCP_URL$path" 2> /dev/null || :
    # dav says 0 when no server answered at all, which is 000 here.
    case ${DAV_CODE:-0} in 0 | 000) BCP_HTTP_CODE=000; return 1 ;; esac
    BCP_HTTP_CODE=$DAV_CODE
    json parse BCP_HTTP "${BCP_REPLY:-"{}"}" 2> /dev/null || { BCP_INVALID=1; json parse BCP_HTTP '{}'; return 1; }
    case $BCP_HTTP_CODE in 2??) return 0 ;; *) return 1 ;; esac
}

# The job's own work, in the background: the requests an operation makes,
# and one JSON document on standard output for blit_cp_done --
# {"ok":..,"code":..,"invalid":..,"reply":{..}}.
fn blit_cp_work(what, method = "GET", path = "", body = "", revision = "") {
    local ok=0 raw
    local -A envelope reply
    export HIBR_DAV_TIMEOUT=6
    json parse reply '{}'
    if [ "$what" = refresh ]; then
        if blit_cp_http GET /v1/diagnostics/observation; then
            raw := json emit BCP_HTTP
            json parse 'reply[snapshot]' "$raw"
            if blit_cp_http GET /v1/auxiliary-displays; then
                raw := json emit BCP_HTTP
                json parse 'reply[auxiliary]' "$raw"
                ok=1
                # Pane effects (Blit 0.2.27+): each live pane, by output and
                # ordinal. A server without them leaves the section empty
                # and the refresh still succeeds.
                json parse 'reply[effects]' '{}'
                if blit_cp_http GET /v1/effects; then
                    raw := json emit BCP_HTTP
                    json parse 'reply[effects]' "$raw"
                fi
                # The chord that stops Blit (Ctrl-Alt-Backspace by default).
                json parse 'reply[zap]' '{}'
                if blit_cp_http GET /v1/control/shutdown-key; then
                    raw := json emit BCP_HTTP
                    json parse 'reply[zap]' "$raw"
                fi
                # The keyboards (Blit 0.3.93, ADR 0231): the list as Blit
                # names them, and the layouts the system has. An older
                # server leaves both empty.
                json parse 'reply[keyboards]' '{}'
                json parse 'reply[layouts]' '{}'
                if blit_cp_http GET /v1/input/keyboards; then
                    raw := json emit BCP_HTTP
                    json parse 'reply[keyboards]' "$raw"
                    if blit_cp_http GET /v1/input/keyboards/available; then
                        raw := json emit BCP_HTTP
                        json parse 'reply[layouts]' "$raw"
                    fi
                fi
            fi
        fi
        if [ "$ok" = 0 ]; then raw := json emit BCP_HTTP; json parse reply "$raw"; fi
    else
        blit_cp_http "$method" "$path" "$body" "$revision" && ok=1
        raw := json emit BCP_HTTP
        json parse reply "$raw"
    fi
    json parse envelope '{}'
    json set envelope .ok "$ok"
    json set envelope .code "$BCP_HTTP_CODE" -s
    json set envelope .invalid "${BCP_INVALID:-0}"
    raw := json emit reply
    json parse 'envelope[reply]' "$raw"
    json emit envelope
}

fn blit_cp_schedule(failed = "0") {
    local seconds=$BCP_REFRESH_SECONDS i=1
    if [ "$failed" = 1 ]; then
        [ "$BCP_FAILURES" -ge 3 ] || BCP_FAILURES=$((BCP_FAILURES + 1))
        while [ "$i" -lt "$BCP_FAILURES" ]; do seconds=$((seconds * 2)); i=$((i + 1)); done
    else BCP_FAILURES=0; fi
    BCP_NEXT=$((EPOCHSECONDS + seconds))
}

fn blit_cp_start(what, method = "GET", path = "", body = "", revision = "", quiet = "0") {
    local n
    [ "$BCP_BUSY" = 0 ] || return 1
    # Schedule before validation too: a failed start must not retry per draw.
    BCP_NEXT=$((EPOCHSECONDS + BCP_REFRESH_SECONDS))
    if ! need dav 2> /dev/null; then BCP_STATUS="The dav module is required"; blit_cp_schedule 1; return 1; fi
    if ! command -v dt_job > /dev/null; then BCP_STATUS="Needs hibr 0.99.297 or later"; blit_cp_schedule 1; return 1; fi
    BCP_URL=${BCP_URL%/}
    if [ "$BCP_CONNECTION_READY" != 1 ] || [ "$BCP_CREDENTIAL_URL" != "$BCP_URL" ]; then
        blit_cp_credentials
    fi
    if ! match "$BCP_URL" '^https?://([A-Za-z0-9._-]+|\[[0-9A-Fa-f:]+\])(:[0-9]+)?$'; then
        BCP_STATUS="Use an http(s) server URL without a path"; blit_cp_schedule 1; return 1
    fi
    case "$BCP_TOKEN" in *[!a-zA-Z0-9._~+/=-]*) BCP_STATUS="Invalid bearer token characters"; blit_cp_schedule 1; return 1 ;; esac
    if ! n := dt_job blit "$what" blit_cp_done blit_cp_work "$what" "$method" "$path" "$body" "$revision"; then
        BCP_STATUS="Cannot create private job directory"; blit_cp_schedule 1; return 1
    fi
    BCP_BUSY=1
    BCP_OPERATION=$what
    [ "$quiet" = 1 ] || BCP_STATUS="Working: $what"
    command -v dt_want > /dev/null && dt_want 250
    return 0
}

# Finished work is handed on by the desktop's job runner after a frame; a
# caller with no desktop loop (a test) calls this to look now.
fn blit_cp_poll() {
    command -v dt_jobtick > /dev/null && dt_jobtick
    return 0
}

# A request has finished: what it read, into the pane.
fn blit_cp_done(int n, int st) {
    local ok code raw f
    local -A envelope reply
    BCP_BUSY=0
    BCP_LAST=$EPOCHSECONDS
    f := dt_jobfile "$n"
    if ! json parse envelope < "$f" 2> /dev/null; then
        blit_cp_schedule 1
        BCP_FONT_SIZE_PENDING=
        BCP_FONT_SIZE_REQUESTED=
        BCP_STATUS="HTTP 000: invalid JSON response"; return 0
    fi
    ok=${envelope[ok]}
    code=${envelope[code]:-000}
    raw := json get envelope .reply
    json parse reply "${raw:-"{}"}"
    if [ "${envelope[invalid]}" = 1 ]; then
        blit_cp_schedule 1
        BCP_FONT_SIZE_PENDING=
        BCP_FONT_SIZE_REQUESTED=
        BCP_STATUS="HTTP $code: invalid JSON response"; return 0
    fi
    if [ "$ok" != 1 ]; then
        BCP_FONT_SIZE_PENDING=
        BCP_FONT_SIZE_REQUESTED=
        # Effects written over a revision somebody else moved: read the
        # server again, then write them once more on top of it.
        if [ "$BCP_OPERATION" = effects ] && [ "$code" = 409 ] && [ "$BCP_FX_RETRIES" -lt 2 ]; then
            BCP_FX_RETRIES=$((BCP_FX_RETRIES + 1))
            BCP_FX_PENDING=1
            BCP_NEXT=0
            BCP_STATUS="Settings moved; applying effects again"
            return 0
        fi
        blit_cp_schedule 1
        if [ "$code" = 000 ]; then BCP_STATUS="Offline or request timed out";
        else BCP_STATUS="HTTP $code: ${reply[code]:-${reply[title]:-request failed}}"; fi
        return 0
    fi
    blit_cp_schedule
    case $BCP_OPERATION in
    refresh)
        raw := json get reply .snapshot
        json parse BCP_SNAPSHOT "$raw"
        raw := json get reply .auxiliary
        json parse BCP_LIVE "$raw"
        raw := json get reply .effects
        json parse BCP_EFFECTS "${raw:-"{}"}"
        raw := json get reply .zap
        json parse BCP_ZAP "${raw:-"{}"}"
        raw := json get reply .keyboards
        json parse BCP_KBLIVE "${raw:-"{}"}"
        raw := json get reply .layouts
        json parse BCP_KBAVAIL "${raw:-"{}"}"
        raw := json get BCP_SNAPSHOT .settings.document
        # This pane's effects follow the server's, unless a change of its
        # own is still on its way there.
        if [ -z "$BCP_FX_HELDW$BCP_FX_PENDING" ]; then
            local fx
            fx := json get BCP_SNAPSHOT .settings.document.effects 2> /dev/null || fx=
            [ -n "$fx" ] && [ "$fx" != null ] || fx='{}'
            json parse BCP_FX "$fx"
        fi
        if [ "$BCP_DIRTY" = 0 ]; then
            json parse BCP_DRAFT "$raw"
            BCP_BASE_REV=${BCP_SNAPSHOT[settings][revision]}
            BCP_BASE_DOC=$raw
        elif [ "$BCP_BASE_REV" != "${BCP_SNAPSHOT[settings][revision]}" ] &&
             blit_cp_liveonly "$BCP_BASE_DOC" "$raw"; then
            # Only the font or the effects moved: Blit saving a live change
            # these panes made. Rebase, keep the staged edits, and take the
            # effects as they now are.
            raw := json get BCP_SNAPSHOT .settings.document.effects 2> /dev/null || raw=
            if [ -n "$raw" ] && [ "$raw" != null ]; then json parse 'BCP_DRAFT[effects]' "$raw"
            else unset BCP_DRAFT["effects"]; fi
            # The keyboards are live too (Blit's switchers change them): the
            # draft takes them as they are, so a Save never puts back an old
            # list or an old current one.
            raw := json get BCP_SNAPSHOT .settings.document.keyboards 2> /dev/null || raw=
            if [ -n "$raw" ] && [ "$raw" != null ]; then json parse 'BCP_DRAFT[keyboards]' "$raw"
            else unset BCP_DRAFT["keyboards"]; fi
            BCP_BASE_REV=${BCP_SNAPSHOT[settings][revision]}
            BCP_BASE_DOC=$raw
        fi
        BCP_STATUS="Connected: ${BCP_SNAPSHOT[version][server_version]}"
        if [ "$BCP_DIRTY" = 1 ] && [ "$BCP_BASE_REV" != "${BCP_SNAPSHOT[settings][revision]}" ]; then
            BCP_STATUS="Saved settings changed; reload before saving"
        fi
        ;;
    zap)
        raw := json emit reply
        json parse BCP_ZAP "$raw"
        if [ "${BCP_ZAP[enabled]}" = true ]; then BCP_STATUS="Ctrl-Alt-Backspace now stops Blit"
        else BCP_STATUS="Ctrl-Alt-Backspace no longer stops Blit"; fi
        ;;
    zoom)
        BCP_STATUS="Zoom ${reply[configuration][zoom]:-set}% on ${reply[id]:-the display}"
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    restart)
        BCP_STATUS="Blit is restarting; log in again when the screen returns"
        BCP_CONNECTION_READY=0
        BCP_BASE_REV=-1
        BCP_NEXT=$((EPOCHSECONDS + 3))
        ;;
    apply | retry)
        raw := json emit reply
        json parse BCP_LIVE "$raw"
        BCP_STATUS="Apply accepted; inspect auxiliary state"
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    save)
        raw := json emit reply
        json parse 'BCP_SNAPSHOT[settings]' "$raw"
        raw := json get reply .document
        json parse BCP_DRAFT "$raw"
        BCP_BASE_REV=${reply[revision]}
        BCP_BASE_DOC=$raw
        BCP_DIRTY=0
        BCP_STATUS="Save: ${reply[storage][state]} (revision ${reply[storage][saved_revision]})"
        # Blit saves the document and applies what it can; a device it
        # refused is named, not reported as saved and in force.
        [ "${reply[refused]:-0}" = 0 ] || BCP_STATUS="Saved, but Blit refused ${reply[refused]}: ${reply[refusal]}"
        ;;
    effects)
        # Applied and saved. The settings now hold BCP_FX; a draft with no
        # staged edits follows them, one with edits is rebased on refresh.
        BCP_FX_RETRIES=0
        raw := json emit reply
        json parse 'BCP_SNAPSHOT[settings]' "$raw"
        raw := json get reply .document
        if [ "$BCP_DIRTY" = 0 ]; then
            json parse BCP_DRAFT "$raw"
            BCP_BASE_REV=${reply[revision]}
            BCP_BASE_DOC=$raw
        elif [ "$BCP_FX_BASE" = "$BCP_BASE_REV" ]; then
            # Written over the revision the staged edits are based on, so
            # the effects are all that moved: rebase now, keep the edits.
            BCP_BASE_REV=${reply[revision]}
            BCP_BASE_DOC=$raw
            raw := json emit BCP_FX
            json parse 'BCP_DRAFT[effects]' "$raw"
        fi
        BCP_STATUS="Effects applied"
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    hud)
        # Applied and saved, like the effects: a draft with no staged edits
        # follows the settings, one with edits keeps them and rebases.
        raw := json emit reply
        json parse 'BCP_SNAPSHOT[settings]' "$raw"
        raw := json get reply .document
        if [ "$BCP_DIRTY" = 0 ] || [ "$BCP_HUD_BASE" = "$BCP_BASE_REV" ]; then
            [ "$BCP_DIRTY" = 1 ] || json parse BCP_DRAFT "$raw"
            BCP_BASE_REV=${reply[revision]}
            BCP_BASE_DOC=$raw
            raw := json get reply .document.hud 2> /dev/null || raw=
            [ -z "$raw" ] || [ "$raw" = null ] || json parse 'BCP_DRAFT[hud]' "$raw"
        fi
        BCP_STATUS="Applied and saved"
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    kbput)
        raw := json emit reply
        json parse BCP_KBLIVE "$raw"
        BCP_STATUS="Keyboards: in use $(blit_kb_name "${BCP_KBLIVE[keyboards][${BCP_KBLIVE[current]}][layout]}" "${BCP_KBLIVE[keyboards][${BCP_KBLIVE[current]}][variant]}")"
        # The settings moved with it: read them, the draft rebased.
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    kbvariants)
        raw := json emit reply
        json parse BCP_KBVARS "$raw"
        BCP_STATUS="Connected: ${BCP_SNAPSHOT[version][server_version]}"
        ;;
    font)
        BCP_FONT_SIZE_REQUESTED=
        raw := json emit reply
        json parse 'BCP_SNAPSHOT[fonts]' "$raw"
        # Update only the font in the shared draft. Never rebase unrelated edits.
        local -A font_draft
        json parse font_draft '{}'
        json set font_draft .font_id "${reply[active][id]}" -s
        if [ "${reply[active][sizing]}" = pixels ]; then
            json set font_draft .size_px "${reply[active][size_px]}"
        else
            json set font_draft .scale "${reply[active][scale]}"
        fi
        raw := json emit font_draft
        json parse 'BCP_DRAFT[font]' "$raw"
        BCP_STATUS="Font applied; settings save queued"
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    esac
    if [ -n "$BCP_FX_PENDING" ] && [ -z "$BCP_FX_HELDW" ]; then
        blit_cp_effects_apply
        return 0
    fi
    if [ -n "$BCP_FONT_SIZE_PENDING" ]; then
        local wanted=$BCP_FONT_SIZE_PENDING
        BCP_FONT_SIZE_PENDING=
        blit_slide 0 font_size "$wanted"
    fi
    return 0
}

fn blit_cp_auxiliary_json() {
    local raw
    raw := json get BCP_DRAFT .auxiliary_displays 2> /dev/null || raw='[]'
    [ -n "$raw" ] && [ "$raw" != null ] || raw='[]'
    ret "$raw"
}

fn blit_cp_toggle(output, ordinal) {
    local i=0 raw n=0 found=0
    local -A old fresh
    raw := blit_cp_auxiliary_json
    json parse old "$raw"
    json parse fresh '[]'
    while [ -n "${old[$i][output]}" ]; do
        if [ "${old[$i][output]}" = "$output" ] && [ "${old[$i][pane_ordinal]}" = "$ordinal" ]; then
            found=1
        else
            raw := json get old ".[$i]"
            json parse "fresh[$n]" "$raw"
            n=$((n + 1))
        fi
        i=$((i + 1))
    done
    if [ "$found" = 0 ]; then
        json set fresh ".[$n].output" "$output" -s
        json set fresh ".[$n].pane_ordinal" "$ordinal"
    fi
    raw := json emit fresh
    json parse 'BCP_DRAFT[auxiliary_displays]' "$raw"
    BCP_DIRTY=1
}

fn blit_cp_row(int w, int n, kind, text, value = "", key = "", wtype = "") {
    CP[$w][$n][kind]=$kind; CP[$w][$n][text]=$text
    CP[$w][$n][val]=$value; CP[$w][$n][key]=$key; CP[$w][$n][wtype]=$wtype
}

# Whether a display offers pixel zoom: Blit 0.3.26 lists it in capabilities.
fn blit_cp_zoomable(int i) {
    local j=0
    while [ -n "${BCP_SNAPSHOT[displays][displays][$i][capabilities][$j]}" ]; do
        [ "${BCP_SNAPSHOT[displays][displays][$i][capabilities][$j]}" != zoom ] || return 0
        j=$((j + 1))
    done
    return 1
}

# A display's zoom as Blit has it now.
fn blit_cp_zoom_of(id) {
    local i=0
    while [ -n "${BCP_SNAPSHOT[displays][displays][$i][id]}" ]; do
        if [ "${BCP_SNAPSHOT[displays][displays][$i][id]}" = "$id" ]; then
            ret "${BCP_SNAPSHOT[displays][displays][$i][configuration][zoom]:-100}"; return 0
        fi
        i=$((i + 1))
    done
    ret 100
}

# A slider position as a zoom Blit takes: the nearest 25 % step from 100
# to 400.
fn blit_cp_zoom_snap(int value) {
    [ "$value" -ge 100 ] || value=100
    [ "$value" -le 400 ] || value=400
    ret $(( (value + 12) / 25 * 25 ))
}

# Whether two settings documents differ in nothing but what the panes apply
# live -- the font, the effects and the performance panel -- and the
# revision a save gave them.
fn blit_cp_liveonly(a, b) {
    local x y
    local -A da db
    [ -n "$a" ] && [ -n "$b" ] || return 1
    json parse da "$a" 2> /dev/null || return 1
    json parse db "$b" 2> /dev/null || return 1
    unset da["font"] da["revision"] da["effects"] da["hud"] da["keyboards"] \
        db["font"] db["revision"] db["effects"] db["hud"] db["keyboards"]
    x := json emit da
    y := json emit db
    [ "$x" = "$y" ]
}

fn blit_cp_tick(int w) {
    local left v
    # Hibr asks every pane for scratch rows during search; that is not a
    # visible pane and must not start I/O or wake the desktop.
    if [ "$w" != 999999 ]; then
        blit_cp_poll
        # A font size held on the slider is applied once it is let go.
        if [ -n "$BCP_FONT_HELD" ] && [ -z "${CP_MSLIDE[$BCP_FONT_HELDW]:-}" ]; then
            v=$BCP_FONT_HELD
            BCP_FONT_HELD=
            blit_slide 0 font_size "$v"
        fi
        if [ -n "$BCP_ZOOM_HELD" ] && [ -z "${CP_MSLIDE[$BCP_ZOOM_HELDW]:-}" ]; then
            blit_slide 0 "zoom:$BCP_ZOOM_HELDID" "$BCP_ZOOM_HELD"
        fi
        if [ -n "$BCP_HUD_HELD" ] && [ -z "${CP_MSLIDE[$BCP_HUD_HELDW]:-}" ]; then
            v=$BCP_HUD_HELD
            BCP_HUD_HELD=
            blit_slide 0 hud_opacity "$v"
        fi
        if [ -n "$BCP_FX_HELDW" ] && [ -z "${CP_MSLIDE[$BCP_FX_HELDW]:-}" ]; then
            BCP_FX_HELDW=
            blit_cp_effects_apply
        fi
        if [ "$BCP_BUSY" = 0 ] && [ "$EPOCHSECONDS" -ge "$BCP_NEXT" ]; then
            blit_cp_start refresh GET "" "" "" 1
        fi
        if [ "$BCP_BUSY" = 1 ]; then left=250;
        else
            left=$(((BCP_NEXT - EPOCHSECONDS) * 1000))
            [ "$left" -gt 0 ] || left=1000
        fi
        command -v dt_want > /dev/null && dt_want "$left"
    fi
    return 0
}

fn blit_rows(int w) {
    local n=0 i=0 j output ordinal pane on state raw left
    local -A desired
    blit_cp_tick "$w"
    blit_cp_row "$w" "$n" head Connection; n=$((n + 1))
    blit_cp_row "$w" "$n" action Server "$BCP_URL" url; n=$((n + 1))
    state=unset; [ -n "$BCP_TOKEN" ] && state=set
    blit_cp_row "$w" "$n" action "API Token (remembered)" "$state" token; n=$((n + 1))
    if [ -n "$BCP_CREDENTIAL_STATUS" ]; then
        blit_cp_row "$w" "$n" info "$BCP_CREDENTIAL_STATUS"; n=$((n + 1))
    fi
    blit_cp_row "$w" "$n" info "$BCP_STATUS"; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Reload (discard draft)" "" reload; n=$((n + 1))
    [ "$BCP_BASE_REV" -ge 0 ] || { ret "$n"; return 0; }
    blit_cp_row "$w" "$n" head "Per-display grid (Save applies)"; n=$((n + 1))
    i=0
    if [ -z "${BCP_SNAPSHOT[topology][outputs][0][layout][columns]}" ]; then
        blit_cp_row "$w" "$n" info "Independent grids require Blit 0.1.545"; n=$((n + 1))
    fi
    while [ -n "${BCP_SNAPSHOT[topology][outputs][0][layout][columns]}" ] &&
          [ -n "${BCP_SNAPSHOT[displays][displays][$i][id]}" ]; do
        output=${BCP_SNAPSHOT[displays][displays][$i][state][connector]:-${BCP_SNAPSHOT[displays][displays][$i][name]}}
        # Pixel zoom (Blit ADR 0204), live, on the display's own row: Blit
        # 0.3.26 lists it; an older one gets the plain heading.
        if blit_cp_zoomable "$i"; then
            local zid=${BCP_SNAPSHOT[displays][displays][$i][id]} zoom
            zoom=${BCP_SNAPSHOT[displays][displays][$i][configuration][zoom]:-100}
            [ "$BCP_ZOOM_HELDID" != "$zid" ] || [ -z "$BCP_ZOOM_HELD" ] || zoom=$BCP_ZOOM_HELD
            blit_cp_row "$w" "$n" set "$output zoom" "$zoom" "zoom:$zid" slider
            CP[$w][$n][min]=100; CP[$w][$n][max]=400; CP[$w][$n][after]="($zoom%)"
        else
            blit_cp_row "$w" "$n" info "$output"
        fi
        n=$((n + 1))
        blit_cp_row "$w" "$n" set Columns "${BCP_DRAFT[display_layouts][$output][columns]:-1}" "columns:$output" slider
        CP[$w][$n][after]="(${BCP_DRAFT[display_layouts][$output][columns]:-1})"
        CP[$w][$n][min]=1; CP[$w][$n][max]=8; n=$((n + 1))
        blit_cp_row "$w" "$n" set Rows "${BCP_DRAFT[display_layouts][$output][rows]:-1}" "rows:$output" slider
        CP[$w][$n][after]="(${BCP_DRAFT[display_layouts][$output][rows]:-1})"
        CP[$w][$n][min]=1; CP[$w][$n][max]=8; n=$((n + 1)); i=$((i + 1))
    done
    blit_cp_row "$w" "$n" head "Startup Login (save, then restart)"; n=$((n + 1))
    on=off; [ "${BCP_DRAFT[login][enabled]:-true}" = true ] && on=on
    blit_cp_row "$w" "$n" set "Login enabled" "$on" enabled bool; n=$((n + 1))
    blit_cp_row "$w" "$n" set "Preferred primary pane" "${BCP_DRAFT[login][preferred_pane_id]:-auto}" primary; n=$((n + 1))
    blit_cp_row "$w" "$n" set Fallback "${BCP_DRAFT[login][fallback]:-first_available}" fallback; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Native desktop" "${BCP_SNAPSHOT[login][desktop][state]}"; n=$((n + 1))
    blit_cp_row "$w" "$n" head "Auxiliary panes (staged)"; n=$((n + 1))
    raw := blit_cp_auxiliary_json; json parse desired "$raw"
    while [ -n "${BCP_SNAPSHOT[topology][panes][$i][id]}" ]; do
        pane=${BCP_SNAPSHOT[topology][panes][$i][id]}
        ordinal=${pane##*-}
        output=
        j=0
        while [ -n "${BCP_SNAPSHOT[displays][displays][$j][id]}" ]; do
            if [ "${BCP_SNAPSHOT[displays][displays][$j][id]}" = "${BCP_SNAPSHOT[topology][panes][$i][display_id]}" ]; then
                output=${BCP_SNAPSHOT[displays][displays][$j][state][connector]:-${BCP_SNAPSHOT[displays][displays][$j][name]}}
                break
            fi
            j=$((j + 1))
        done
        on=off; j=0
        while [ -n "${desired[$j][output]}" ]; do
            [ "${desired[$j][output]}" = "$output" ] && [ "${desired[$j][pane_ordinal]}" = "$ordinal" ] && on=on
            j=$((j + 1))
        done
        blit_cp_row "$w" "$n" set "$output pane $ordinal (${BCP_SNAPSHOT[topology][panes][$i][bounds][width]}x${BCP_SNAPSHOT[topology][panes][$i][bounds][height]})" "$on" "aux:$output:$ordinal" bool
        n=$((n + 1)); i=$((i + 1))
    done
    blit_cp_row "$w" "$n" action "Apply auxiliaries now" "" apply; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Retry stopped auxiliaries" "" retry; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Save as Default" "rev $BCP_BASE_REV" save; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Storage" "${BCP_SNAPSHOT[settings][storage][state]}"; n=$((n + 1))
    blit_cp_row "$w" "$n" head "Live auxiliary status"; n=$((n + 1))
    i=0
    while [ -n "${BCP_LIVE[bindings][$i][output]}" ]; do
        blit_cp_row "$w" "$n" info "${BCP_LIVE[bindings][$i][output]}/${BCP_LIVE[bindings][$i][pane_ordinal]}: ${BCP_LIVE[bindings][$i][state]}" "${BCP_LIVE[bindings][$i][reason]}"
        n=$((n + 1)); i=$((i + 1))
    done
    blit_cp_row "$w" "$n" head "Font (live with automatic save)"; n=$((n + 1))
    blit_cp_row "$w" "$n" set Font "${BCP_SNAPSHOT[fonts][active][id]}" font; n=$((n + 1))
    local size=${BCP_SNAPSHOT[fonts][active][size_px]}
    if [ -n "$size" ] && [ "$size" != null ]; then
        [ -z "$BCP_FONT_SIZE_PENDING" ] || size=$BCP_FONT_SIZE_PENDING
        [ -z "$BCP_FONT_HELD" ] || size=$BCP_FONT_HELD
        blit_cp_row "$w" "$n" set "Font size" "$size" font_size slider
        CP[$w][$n][min]=8; CP[$w][$n][max]=64; CP[$w][$n][after]="($size px)"
    else
        blit_cp_row "$w" "$n" info "Font size" "Not reported by server"
    fi
    n=$((n + 1))
    # How text is hinted (Blit 0.3.47+, ADR 0218 there); fitted icons ignore it.
    local hinting=${BCP_SNAPSHOT[fonts][active][hinting]}
    if [ -n "$hinting" ] && [ "$hinting" != null ]; then
        blit_cp_row "$w" "$n" set "Hinting" "$hinting" hinting; n=$((n + 1))
    fi
    blit_cp_row "$w" "$n" head Server; n=$((n + 1))
    if [ -n "${BCP_ZAP[enabled]}" ]; then
        on=off; [ "${BCP_ZAP[enabled]}" = true ] && on=on
        blit_cp_row "$w" "$n" set "Ctrl-Alt-Backspace stops Blit" "$on" zap bool; n=$((n + 1))
    fi
    # Restart after an update installed outside Blit's API (ADR 0205):
    # Blit 0.3.27 has the setting and says when one is waiting.
    if [ -n "${BCP_SNAPSHOT[settings][effective][restart_after_update]}" ]; then
        blit_cp_row "$w" "$n" set "Restart after update" "${BCP_SNAPSHOT[settings][effective][restart_after_update]}" update_restart; n=$((n + 1))
        if [ "${BCP_SNAPSHOT[diagnostics][update][restart_pending]}" = true ]; then
            blit_cp_row "$w" "$n" info "Update waiting" "${BCP_SNAPSHOT[diagnostics][update][installed_version]} installed, ${BCP_SNAPSHOT[diagnostics][update][running_version]} running"; n=$((n + 1))
        fi
    fi
    blit_cp_row "$w" "$n" action "Restart Blit${GL[ellipsis]:-...}" "" restart; n=$((n + 1))
    blit_cp_row "$w" "$n" head Diagnostics; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Measured frame rate" "${BCP_SNAPSHOT[runtime][performance][frame_rate_hz]} Hz"; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Last render" "${BCP_SNAPSHOT[runtime][performance][last_render_ms]} ms"; n=$((n + 1))
    n := blit_cp_hud_rows "$w" "$n"
    blit_cp_row "$w" "$n" head "Presentation (API settings own intent)"; n=$((n + 1))
    local backend=${BCP_SNAPSHOT[settings][effective][display_backend_active]}
    [ -n "$backend" ] || backend=${BCP_SNAPSHOT[server][display_backend][name]}
    blit_cp_row "$w" "$n" info "Active backend" "$backend"; n=$((n + 1))
    local source=${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_source]:-"Not reported by server"}
    blit_cp_row "$w" "$n" info "Backend source" "$source"; n=$((n + 1))
    local startup="Not reported by server"
    if [ "${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment_valid]}" = false ]; then
        startup="Invalid; display disabled"
    elif [ "${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment_valid]}" = true ]; then
        startup=${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment]}
        [ -n "$startup" ] && [ "$startup" != null ] || startup=unset
    fi
    blit_cp_row "$w" "$n" info "Startup default" "$startup"; n=$((n + 1))
    n := blit_cp_rendering_rows "$w" "$n"
    n := blit_cp_screens_rows "$w" "$n"
    blit_cp_row "$w" "$n" action "Export staged configuration" "" export; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Import configuration (stage only)" "" import; n=$((n + 1))
    ret "$n"
}

# Program Windows (Blit ADR 0228): read-only. blit-compositor, which shows
# programs in desktop windows: its version on this computer, whether it runs
# for this desktop and whether that is the installed build or an older one
# (replaced by an upgrade, until Restart Desktop); Xwayland for X programs;
# whether Blit offers GPU frames (dmabuf, ADR 0223); and for each pane
# showing frames by descriptor how they arrive -- by the GPU or copied --
# and whether its input route to the program is live.
fn blit_cp_screens_rows(int w, int n) {
    local i=0 pane accepted gpu copied state routes j events error text v pid exe
    blit_cp_row "$w" "$n" head "Program Windows"; n=$((n + 1))
    if [ -z "$BCP_COMPOSITOR_VERSION" ]; then
        BCP_COMPOSITOR_VERSION=-
        if command -v blit-compositor > /dev/null; then
            v=$(blit-compositor --version 2> /dev/null)
            v=${v#blit-compositor }
            BCP_COMPOSITOR_VERSION=${v:-installed}
        fi
        BCP_XWAYLAND_VERSION=-
        if command -v Xwayland > /dev/null; then
            v=$(Xwayland -version 2>&1 | sed -n 's/.*Version \([0-9][0-9.]*\).*/\1/p' | head -n 1)
            BCP_XWAYLAND_VERSION=${v:-installed}
        fi
    fi
    text="Not installed (blit-compositor)"
    [ "$BCP_COMPOSITOR_VERSION" = - ] || text="blit-compositor $BCP_COMPOSITOR_VERSION"
    blit_cp_row "$w" "$n" info "Compositor" "$text"; n=$((n + 1))
    if [ "$BCP_COMPOSITOR_VERSION" != - ]; then
        if [ -z "$BCP_COMP_RUNNING" ] || [ "$EPOCHSECONDS" -ge $((BCP_COMP_ASKED + 5)) ]; then
            BCP_COMP_ASKED=$EPOCHSECONDS
            BCP_COMP_RUNNING=no
            pid=$(pgrep -u "$(id -u)" -x blit-compositor 2> /dev/null | head -n 1)
            if [ -n "$pid" ]; then
                BCP_COMP_RUNNING=yes
                exe=$(readlink "/proc/$pid/exe" 2> /dev/null)
                case $exe in *" (deleted)") BCP_COMP_RUNNING=old ;; esac
            fi
        fi
        case $BCP_COMP_RUNNING in
        yes) text="Yes, $BCP_COMPOSITOR_VERSION" ;;
        old) text="An older build: Restart Desktop for $BCP_COMPOSITOR_VERSION" ;;
        *) text="No" ;;
        esac
        blit_cp_row "$w" "$n" info "Running" "$text"; n=$((n + 1))
    fi
    text="Not installed: X programs cannot open (xwayland)"
    [ "$BCP_XWAYLAND_VERSION" = - ] || text="Xwayland $BCP_XWAYLAND_VERSION"
    blit_cp_row "$w" "$n" info "X programs" "$text"; n=$((n + 1))
    case ${BCP_SNAPSHOT[diagnostics][graphics][frames][dmabuf][advertised]} in
    true) text="Offered" ;;
    false) text="Not offered: ${BCP_SNAPSHOT[diagnostics][graphics][frames][dmabuf][unavailable]:-no reason given}" ;;
    *) text="Not reported by server" ;;
    esac
    blit_cp_row "$w" "$n" info "GPU frames" "$text"; n=$((n + 1))
    while [ -n "${BCP_SNAPSHOT[sessions][sessions][$i][id]}" ]; do
        accepted=${BCP_SNAPSHOT[sessions][sessions][$i][frames][accepted]:-0}
        routes=${BCP_SNAPSHOT[sessions][sessions][$i][frames][input][routes][0][image]}
        if [ "$accepted" -gt 0 ] || [ -n "$routes" ]; then
            pane=${BCP_SNAPSHOT[sessions][sessions][$i][pane_id]:-session ${BCP_SNAPSHOT[sessions][sessions][$i][id]}}
            gpu=${BCP_SNAPSHOT[sessions][sessions][$i][frames][dmabuf][accepted]:-0}
            copied=$((accepted - gpu))
            blit_cp_row "$w" "$n" info "$pane frames" "$gpu by the GPU, $copied copied"; n=$((n + 1))
            state=none; j=0
            while [ -n "${BCP_SNAPSHOT[sessions][sessions][$i][frames][input][routes][$j][image]}" ]; do
                case ${BCP_SNAPSHOT[sessions][sessions][$i][frames][input][routes][$j][state]} in
                live) state=live ;;
                on) [ "$state" = live ] || state=on ;;
                off) [ "$state" != none ] || state=off ;;
                esac
                j=$((j + 1))
            done
            events=${BCP_SNAPSHOT[sessions][sessions][$i][frames][input][events]:-0}
            error=${BCP_SNAPSHOT[sessions][sessions][$i][frames][input][last_error]}
            case $state in
            live) text="Live" ;;
            on) text="On, waiting for focus" ;;
            off) text="Off" ;;
            *) text="None" ;;
            esac
            text="$text; $events events"
            [ -z "$error" ] || [ "$error" = null ] || text="$text; last: $error"
            blit_cp_row "$w" "$n" info "$pane input" "$text"; n=$((n + 1))
        fi
        i=$((i + 1))
    done
    ret "$n"
}

# What draws each display's frames (Blit 0.2.9+, ADR 0181): the GPU through
# GLES, or the CPU compositor (software); with why, when the GPU was asked
# for and is not drawing. Then the two settings that choose it: the
# compositor (saved, applies at Blit's next restart) and frame timing
# (0.2.20+, applies as soon as it is saved). A server that does not report
# a setting shows no control for it.
fn blit_cp_rendering_rows(int w, int n) {
    local i=0 id active requested reason renderer text value
    blit_cp_row "$w" "$n" head "Rendering"; n=$((n + 1))
    while [ -n "${BCP_SNAPSHOT[diagnostics][render][outputs][$i][display_id]}" ]; do
        id=${BCP_SNAPSHOT[diagnostics][render][outputs][$i][display_id]}
        active=${BCP_SNAPSHOT[diagnostics][render][outputs][$i][compositor][active]}
        requested=${BCP_SNAPSHOT[diagnostics][render][outputs][$i][compositor][requested]}
        reason=${BCP_SNAPSHOT[diagnostics][render][outputs][$i][compositor][reason]}
        renderer=${BCP_SNAPSHOT[diagnostics][render][outputs][$i][compositor][renderer]}
        renderer=${renderer%% (*}; renderer=${renderer%% |*}
        case $active in
        gles) text="GPU (GLES)"; [ -z "$renderer" ] || text="$text: $renderer" ;;
        cpu) text="Software (CPU)"
             if [ "$requested" = gles ] && [ -n "$reason" ] && [ "$reason" != null ]; then
                 text="$text; GPU unavailable: $reason"
             fi ;;
        *) text="Not reported by server" ;;
        esac
        blit_cp_row "$w" "$n" info "$id" "$text"; n=$((n + 1)); i=$((i + 1))
    done
    value=${BCP_SNAPSHOT[settings][effective][kms_compositor]}
    if [ -n "$value" ] && [ "$value" != null ]; then
        blit_cp_row "$w" "$n" set "Compositor (save, then restart)" "${BCP_DRAFT[server][kms_compositor]:-$value}" compositor; n=$((n + 1))
    fi
    value=${BCP_SNAPSHOT[settings][effective][kms_frame_timing]}
    if [ -n "$value" ] && [ "$value" != null ]; then
        blit_cp_row "$w" "$n" set "Frame timing (Save applies)" "${BCP_DRAFT[server][kms_frame_timing]:-$value}" frame_timing; n=$((n + 1))
    fi
    ret "$n"
}

# Blit Effects (Blit ADR 0186, 0187): its own pane, live. Every change is
# applied at once -- a slider when it is let go -- by writing Blit's current
# settings document with only `effects` replaced, so nothing another pane
# has staged is saved with it. BCP_FX is the effects object this pane shows
# and edits; it follows the server's whenever no change of its own is on its
# way. The rows come from Blit's own list of effects, so a newer Blit's
# effects appear here without a new pane, and an older one shows fewer.
fn blit_effects_rows(int w) {
    local n=0 i=0 output ordinal on reason raw
    local -A unavailable
    blit_cp_tick "$w"
    blit_cp_row "$w" "$n" head "Blit pane effects (live)"; n=$((n + 1))
    blit_cp_row "$w" "$n" action Server "$BCP_URL" url; n=$((n + 1))
    blit_cp_row "$w" "$n" action "API Token (remembered)" "" token; n=$((n + 1))
    blit_cp_row "$w" "$n" info "$BCP_STATUS"; n=$((n + 1))
    [ "$BCP_BASE_REV" -ge 0 ] || { ret "$n"; return 0; }
    if [ -z "${BCP_EFFECTS[available][0][name]}" ]; then
        blit_cp_row "$w" "$n" info "Pane effects" "Not reported by server"; n=$((n + 1))
        ret "$n"; return 0
    fi
    on=on; [ "${BCP_FX[enabled]:-true}" != false ] || on=off
    blit_cp_row "$w" "$n" set "Effects" "$on" fxall bool; n=$((n + 1))
    while [ -n "${BCP_EFFECTS[panes][$i][pane_id]}" ]; do
        output=${BCP_EFFECTS[panes][$i][output]}
        ordinal=${BCP_EFFECTS[panes][$i][pane_ordinal]}
        on=on; [ "${BCP_FX[$output][$ordinal][enabled]:-true}" != false ] || on=off
        blit_cp_row "$w" "$n" head "$output pane $ordinal"; n=$((n + 1))
        # Blit 0.3.34: a pane no session draws in shows nothing, whatever is
        # set for it (a held desktop is one session in one pane).
        if [ "${BCP_EFFECTS[panes][$i][has_view]}" = false ]; then
            blit_cp_row "$w" "$n" info "Nothing shown here" "effects apply when a session uses this pane"; n=$((n + 1))
        fi
        blit_cp_row "$w" "$n" set "On" "$on" "fxpane:$output:$ordinal" bool; n=$((n + 1))
        n := blit_cp_effect_sliders "$w" "$n" "$output" "$ordinal"
        # Any effect it cannot draw says why (Blit ADR 0207 added more).
        reason=; unavailable=()
        raw := json get BCP_EFFECTS ".panes[$i].unavailable" 2> /dev/null || raw='{}'
        json parse unavailable "${raw:-"{}"}"
        for raw in "${!unavailable[@]}"; do reason=${unavailable[$raw]}; break; done
        if [ -n "$reason" ]; then
            blit_cp_row "$w" "$n" info "Not drawn here" "$reason"; n=$((n + 1))
        fi
        i=$((i + 1))
    done
    ret "$n"
}
fn blit_effects_do(int w, key, int dir) { blit_do "$w" "$key" "$dir"; }
fn blit_effects_slide(int w, key, int value) { blit_slide "$w" "$key" "$value"; }
fn blit_effects_drop(int w, int r, int c, key) { blit_drop "$w" "$r" "$c" "$key"; }

# One slider per effect Blit lists, for one pane. Its range is Blit's own:
# brightness and contrast run -100..100 around 0 (Blit ADR 0207), the rest
# from 0, which Blit leaves unsaid. A colour (the phosphor) is a choice
# instead.
fn blit_cp_effect_sliders(int w, int n, output, ordinal) {
    local j=0 name param value label unit max min
    while [ -n "${BCP_EFFECTS[available][$j][name]}" ]; do
        name=${BCP_EFFECTS[available][$j][name]}
        param=${BCP_EFFECTS[available][$j][parameter]}
        max=${BCP_EFFECTS[available][$j][maximum]}
        min=${BCP_EFFECTS[available][$j][minimum]:-0}
        value=${BCP_FX[$output][$ordinal][$name][$param]:-0}
        unit=%; [ "$param" != radius_px ] || { unit=" px"; max=64; }
        # Blit's own title ("RGB shift").
        label=${BCP_EFFECTS[available][$j][title]:-${name^}}
        if [ "$param" = color ]; then
            value := blit_cp_phosphor_name "$value"
            blit_cp_row "$w" "$n" set "$label (with Chroma)" "$value" "fxcolor:$name:$output:$ordinal"
        elif [ "$param" = kind ]; then
            # Blit ADR 0209: the mask's type, a choice; it acts only with
            # the CRT mask's strength, which is drawn at the panel's own
            # pixels and does not grow with zoom.
            blit_cp_row "$w" "$n" set "$label (with CRT mask)" "${BCP_MASKS[$value]:-$value}" "fxkind:$name:$output:$ordinal"
        else
            blit_cp_row "$w" "$n" set "$label" "$value" "fx:$name:$output:$ordinal" slider
            CP[$w][$n][min]=$min; CP[$w][$n][max]=$max; CP[$w][$n][after]="($value$unit)"
            # Blit ADR 0208: a trail is gone 0.16 s + 1.44 s x amount/100
            # after a change; the time says more than the percentage.
            if [ "$name" = burn_in ] && [ "$value" -gt 0 ]; then
                CP[$w][$n][after]="($value%, fades in $(( (160 + 1440 * value / 100) / 1000 )).$(( (160 + 1440 * value / 100) % 1000 / 100 )) s)"
            fi
        fi
        n=$((n + 1)); j=$((j + 1))
    done
    ret "$n"
}

# The phosphor colours offered, as Blit stores them (0xRRGGBB; 0 is white,
# Blit ADR 0207), and the name shown for a stored value.
BCP_PHOSPHORS=(white:0 green:3407718 amber:16756736)
# The mask types Blit draws, by their kind number (ADR 0209; 0 is unset).
BCP_MASKS=("aperture grille" "slot mask" "shadow mask")
fn blit_cp_phosphor_name(int value) {
    local p
    for p in "${BCP_PHOSPHORS[@]}"; do
        [ "${p#*:}" != "$value" ] || { ret "${p%%:*}"; return 0; }
    done
    ret "$(printf '#%06x' "$value")"
}

# The parameter and the slider's range ("param min max") for an effect Blit
# lists.
fn blit_cp_effect_spec(name) {
    local j=0
    while [ -n "${BCP_EFFECTS[available][$j][name]}" ]; do
        if [ "${BCP_EFFECTS[available][$j][name]}" = "$name" ]; then
            if [ "${BCP_EFFECTS[available][$j][parameter]}" = radius_px ]; then
                ret "radius_px 0 64"
            else
                ret "${BCP_EFFECTS[available][$j][parameter]} ${BCP_EFFECTS[available][$j][minimum]:-0} ${BCP_EFFECTS[available][$j][maximum]}"
            fi
            return 0
        fi
        j=$((j + 1))
    done
    return 1
}

# A change to BCP_FX: an effect's value (key fx:name:output:ordinal), a
# pane's switch (fxpane:output:ordinal) or the master switch (fxall, with
# value 0/1). An effect at 0 is left out of the pane's entry.
fn blit_cp_effect(int w, key, int value) {
    local rest output ordinal name spec param min max raw
    local -A entry
    case $key in
    fxall)
        if [ "$value" = 1 ]; then json set BCP_FX .enabled true; else json set BCP_FX .enabled false; fi ;;
    fxpane:* | fx:* | fxcolor:* | fxkind:*)
        rest=${key#*:}
        if [ "${key%%:*}" != fxpane ]; then name=${rest%%:*}; rest=${rest#*:}; fi
        ordinal=${rest##*:}; output=${rest%:*}
        # Connector names never hold a dot, so the plain path reaches them.
        raw := json get BCP_FX ".$output.$ordinal" 2> /dev/null || raw=
        [ -n "$raw" ] && [ "$raw" != null ] || raw='{}'
        json parse entry "$raw"
        if [ -z "$name" ]; then
            if [ "$value" = 1 ]; then unset entry["enabled"]; else json set entry .enabled false; fi
        else
            spec := blit_cp_effect_spec "$name" || return 0
            param=${spec%% *}; max=${spec##* }; min=${spec#* }; min=${min% *}
            [ "$value" -ge "$min" ] && [ "$value" -le "$max" ] || return 0
            if [ "$value" = 0 ]; then unset entry["$name"]
            else json set entry ".$name.$param" "$value"; fi
        fi
        raw := json emit entry
        json parse "BCP_FX[$output][$ordinal]" "$raw" ;;
    *) return 0 ;;
    esac
    # A slider still held shows the value; letting go applies it (#368).
    if [ "$w" != 0 ] && [ -n "${CP_MSLIDE[$w]:-}" ]; then
        BCP_FX_HELDW=$w
        command -v dt_want > /dev/null && dt_want 50
        return 0
    fi
    blit_cp_effects_apply
}

# Write BCP_FX into Blit's current settings document. One request at a
# time; a change made meanwhile is applied when it returns.
fn blit_cp_effects_apply() {
    local raw body
    local -A doc payload
    if [ "$BCP_BUSY" = 1 ]; then BCP_FX_PENDING=1; return 0; fi
    BCP_FX_PENDING=
    raw := json get BCP_SNAPSHOT .settings.document 2> /dev/null || raw='{}'
    json parse doc "${raw:-"{}"}"
    raw := json emit BCP_FX
    json parse 'doc[effects]' "$raw"
    raw := json emit doc
    json parse payload '{}'; json parse 'payload[document]' "$raw"
    body := json emit payload
    BCP_FX_BASE=${BCP_SNAPSHOT[settings][revision]}
    blit_cp_start effects PUT /v1/settings "$body" "$BCP_FX_BASE"
}

# The performance panel (Blit ADR 0203): drawn by Blit over everything, its
# switch here. Applied live, like the effects.
fn blit_cp_hud_rows(int w, int n) {
    local on=off hibr=off
    if [ -z "${BCP_SNAPSHOT[settings][effective][hud][hz]}" ]; then
        blit_cp_row "$w" "$n" info "Performance panel" "Not reported by server"; n=$((n + 1))
        ret "$n"; return 0
    fi
    [ "${BCP_SNAPSHOT[settings][effective][hud][enabled]}" != true ] || on=on
    blit_cp_row "$w" "$n" set "Performance panel" "$on" hud bool; n=$((n + 1))
    blit_cp_row "$w" "$n" set "Panel corner" "${BCP_SNAPSHOT[settings][effective][hud][corner]:-top-right}" hud_corner; n=$((n + 1))
    blit_cp_hud_has hibr && hibr=on
    blit_cp_row "$w" "$n" set "Hibr section" "$hibr" hud_hibr bool; n=$((n + 1))
    local opacity=${BCP_HUD_HELD:-${BCP_SNAPSHOT[settings][effective][hud][opacity]:-100}}
    blit_cp_row "$w" "$n" set "Panel opacity" "$opacity" hud_opacity slider
    CP[$w][$n][min]=10; CP[$w][$n][max]=100; CP[$w][$n][after]="($opacity%)"; n=$((n + 1))
    ret "$n"
}

# Whether the panel shows a section, as Blit has it now.
fn blit_cp_hud_has(which) {
    local i=0
    while [ -n "${BCP_SNAPSHOT[settings][effective][hud][sections][$i]}" ]; do
        [ "${BCP_SNAPSHOT[settings][effective][hud][sections][$i]}" != "$which" ] || return 0
        i=$((i + 1))
    done
    return 1
}

# The sections as a JSON list, with one switched in or out.
fn blit_cp_hud_sections(which) {
    local s i=0 out= have=0
    while [ -n "${BCP_SNAPSHOT[settings][effective][hud][sections][$i]}" ]; do
        s=${BCP_SNAPSHOT[settings][effective][hud][sections][$i]}; i=$((i + 1))
        if [ "$s" = "$which" ]; then have=1; continue; fi
        out="$out,\"$s\""
    done
    [ "$have" = 1 ] || out="$out,\"$which\""
    ret "[${out#,}]"
}

# Write one string field of a settings section into Blit's current
# document, applied and saved at once like the panel's.
fn blit_cp_live_apply(section, field, value) {
    local raw body
    local -A doc payload
    raw := json get BCP_SNAPSHOT .settings.document 2> /dev/null || raw='{}'
    json parse doc "${raw:-"{}"}"
    json set doc ".$section.$field" "$value" -s
    raw := json emit doc
    json parse payload '{}'; json parse 'payload[document]' "$raw"
    body := json emit payload
    BCP_HUD_BASE=${BCP_SNAPSHOT[settings][revision]}
    blit_cp_start hud PUT /v1/settings "$body" "$BCP_HUD_BASE"
}

# Write one field of the panel into Blit's current settings document: a
# string, a JSON value (a list), or as is (true, false, a number). json set
# stores what it is given as a string unless it reads as one of the last.
fn blit_cp_hud_apply(field, value, kind = "") {
    local raw body
    local -A doc payload
    raw := json get BCP_SNAPSHOT .settings.document 2> /dev/null || raw='{}'
    json parse doc "${raw:-"{}"}"
    case $kind in
    string) json set doc ".hud.$field" "$value" -s ;;
    json) json parse "doc[hud][$field]" "$value" ;;
    *) json set doc ".hud.$field" "$value" ;;
    esac
    raw := json emit doc
    json parse payload '{}'; json parse 'payload[document]' "$raw"
    body := json emit payload
    BCP_HUD_BASE=${BCP_SNAPSHOT[settings][revision]}
    blit_cp_start hud PUT /v1/settings "$body" "$BCP_HUD_BASE"
}

# One choice source and selection path for native popups and keyboard stepping.
fn blit_cp_choices(key) {
    local i=0 raw rest name
    local -A cfg
    BCP_CHOICES=(); BCP_CHOICE_CURRENT=
    case $key in
    primary)
        BCP_CHOICES=(auto)
        while [ -n "${BCP_SNAPSHOT[topology][panes][$i][id]}" ]; do
            BCP_CHOICES+=("${BCP_SNAPSHOT[topology][panes][$i][id]}"); i=$((i + 1))
        done
        BCP_CHOICE_CURRENT=${BCP_DRAFT[login][preferred_pane_id]:-auto}
        [ "$BCP_CHOICE_CURRENT" != null ] || BCP_CHOICE_CURRENT=auto ;;
    fallback) BCP_CHOICES=(first_available wait); BCP_CHOICE_CURRENT=${BCP_DRAFT[login][fallback]:-first_available} ;;
    update_restart)
        BCP_CHOICES=(at-login-screen manual)
        BCP_CHOICE_CURRENT=${BCP_SNAPSHOT[settings][effective][restart_after_update]:-at-login-screen} ;;
    fxcolor:*)
        rest=${key#fxcolor:}; name=${rest%%:*}; rest=${rest#*:}
        for raw in "${BCP_PHOSPHORS[@]}"; do BCP_CHOICES+=("${raw%%:*}"); done
        BCP_CHOICE_CURRENT := blit_cp_phosphor_name "${BCP_FX[${rest%:*}][${rest##*:}][$name][color]:-0}" ;;
    fxkind:*)
        rest=${key#fxkind:}; name=${rest%%:*}; rest=${rest#*:}
        BCP_CHOICES=("${BCP_MASKS[@]}")
        BCP_CHOICE_CURRENT=${BCP_MASKS[${BCP_FX[${rest%:*}][${rest##*:}][$name][kind]:-0}]} ;;
    hud_corner)
        BCP_CHOICES=(top-right top-left bottom-right bottom-left)
        BCP_CHOICE_CURRENT=${BCP_SNAPSHOT[settings][effective][hud][corner]:-top-right} ;;
    compositor)
        BCP_CHOICES=(gles cpu)
        BCP_CHOICE_CURRENT=${BCP_DRAFT[server][kms_compositor]:-${BCP_SNAPSHOT[settings][effective][kms_compositor]}} ;;
    frame_timing)
        BCP_CHOICES=(late immediate)
        BCP_CHOICE_CURRENT=${BCP_DRAFT[server][kms_frame_timing]:-${BCP_SNAPSHOT[settings][effective][kms_frame_timing]}} ;;
    font)
        while [ -n "${BCP_SNAPSHOT[fonts][profiles][$i][id]}" ]; do
            [ "${BCP_SNAPSHOT[fonts][profiles][$i][available]}" != true ] || BCP_CHOICES+=("${BCP_SNAPSHOT[fonts][profiles][$i][id]}")
            i=$((i + 1))
        done
        BCP_CHOICE_CURRENT=${BCP_SNAPSHOT[fonts][active][id]} ;;
    hinting) BCP_CHOICES=(full light none); BCP_CHOICE_CURRENT=${BCP_SNAPSHOT[fonts][active][hinting]:-full} ;;
    shape) BCP_CHOICES=(arrow hand precision); BCP_CHOICE_CURRENT=${BCP_DRAFT[pointer][shape]:-arrow} ;;
    palette) BCP_CHOICES=(pearl obsidian neon amber); BCP_CHOICE_CURRENT=${BCP_DRAFT[pointer][palette]:-pearl} ;;
    device)
        i := blit_mouse_index
        i=0
        while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" ]; do
            if blit_mouse_is_pointer "$i"; then BCP_CHOICES+=("${BCP_SNAPSHOT[input_devices][devices][$i][id]}"); fi
            i=$((i + 1))
        done
        BCP_CHOICE_CURRENT=$BCP_POINTER_ID ;;
    kbdevice)
        i=0
        while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" ]; do
            if blit_keyboard_is_keyboard "$i"; then BCP_CHOICES+=("${BCP_SNAPSHOT[input_devices][devices][$i][id]}"); fi
            i=$((i + 1))
        done
        i := blit_keyboard_index
        BCP_CHOICE_CURRENT=$BCP_KEYBOARD_ID ;;
    capsboot | numboot)
        i := blit_keyboard_index; [ "$i" -ge 0 ] || return 0
        raw := blit_keyboard_raw "$i"; json parse cfg "$raw"
        name=caps_lock_boot; [ "$key" = capsboot ] || name=num_lock_boot
        # Unset leaves the lamp as the keyboard had it; Blit takes no null,
        # so once set it is off or on.
        if [ -n "${cfg[$name]+x}" ]; then BCP_CHOICES=(off on); BCP_CHOICE_CURRENT=off
            [ "${cfg[$name]}" != true ] || BCP_CHOICE_CURRENT=on
        else BCP_CHOICES=(unset off on); BCP_CHOICE_CURRENT=unset; fi ;;
    kbcurrent)
        blit_kb_list
        for ((i = 0; i < ${#BCP_KBL[@]}; i++)); do
            name := blit_kb_name "${BCP_KBL[$i]}" "${BCP_KBV[$i]}"; BCP_CHOICES+=("$name")
        done
        BCP_CHOICE_CURRENT := blit_kb_name "${BCP_KBL[$BCP_KBC]}" "${BCP_KBV[$BCP_KBC]}" ;;
    kbaddlayout)
        while [ -n "${BCP_KBAVAIL[layouts][$i][layout]}" ]; do
            BCP_CHOICES+=("${BCP_KBAVAIL[layouts][$i][name]}"); i=$((i + 1))
        done
        BCP_CHOICE_CURRENT := blit_kb_name "$BCP_KBADD_LAYOUT" "" ;;
    kbaddvariant)
        BCP_CHOICES=(Standard)
        while [ -n "${BCP_KBVARS[variants][$i][variant]}" ]; do
            BCP_CHOICES+=("${BCP_KBVARS[variants][$i][name]}"); i=$((i + 1))
        done
        BCP_CHOICE_CURRENT=Standard
        if [ -n "$BCP_KBADD_VARIANT" ]; then BCP_CHOICE_CURRENT := blit_kb_name "$BCP_KBADD_LAYOUT" "$BCP_KBADD_VARIANT"; fi ;;
    capskey | superkey)
        i := blit_keyboard_index; [ "$i" -ge 0 ] || return 0
        raw := blit_keyboard_raw "$i"; json parse cfg "$raw"
        if [ "$key" = capskey ]; then
            BCP_CHOICES=("Caps Lock" Control Alt Super Nothing)
            BCP_CHOICE_CURRENT := blit_role_word "${cfg[modifiers][58]:-caps_lock}"
        else
            BCP_CHOICES=(Super Control Alt Nothing)
            BCP_CHOICE_CURRENT := blit_role_word "${cfg[modifiers][125]:-meta}"
        fi ;;
    acceleration)
        i := blit_mouse_index; [ "$i" -ge 0 ] || return 0
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"; fi
        json parse cfg "$raw"
        BCP_CHOICES=(flat adaptive); BCP_CHOICE_CURRENT=${cfg[acceleration][profile]:-flat} ;;
    esac
    return 0
}

fn blit_cp_choose(key, value) {
    local option valid=0 body
    local -A payload
    # Only a choice that sends a request waits for the one in flight; the
    # rest change the staged draft, which a background refresh leaves alone
    # once it has been edited. Refusing them all while a quiet refresh ran
    # dropped a click on a dropdown for as long as the refresh took.
    [ "$BCP_BUSY" = 0 ] || { [ "$key" != font ] && [ "$key" != hinting ] && [ "$key" != kbcurrent ] && [ "$key" != kbaddlayout ]; } || return 0
    blit_cp_choices "$key"
    for option in "${BCP_CHOICES[@]}"; do [ "$option" != "$value" ] || valid=1; done
    [ "$valid" = 1 ] || return 0
    case $key in
    primary)
        if [ "$value" = auto ]; then json set BCP_DRAFT .login.preferred_pane_id null;
        else json set BCP_DRAFT .login.preferred_pane_id "$value" -s; fi
        BCP_DIRTY=1 ;;
    fallback) json set BCP_DRAFT .login.fallback "$value" -s; BCP_DIRTY=1 ;;
    compositor) json set BCP_DRAFT .server.kms_compositor "$value" -s; BCP_DIRTY=1 ;;
    frame_timing) json set BCP_DRAFT .server.kms_frame_timing "$value" -s; BCP_DIRTY=1 ;;
    hud_corner) blit_cp_hud_apply corner "$value" string ;;
    update_restart) blit_cp_live_apply server restart_after_update "$value" ;;
    fxcolor:*)
        for option in "${BCP_PHOSPHORS[@]}"; do
            [ "${option%%:*}" != "$value" ] || { blit_cp_effect 0 "$key" "${option#*:}"; break; }
        done ;;
    fxkind:*)
        option=0
        while [ -n "${BCP_MASKS[$option]}" ]; do
            [ "${BCP_MASKS[$option]}" != "$value" ] || { blit_cp_effect 0 "$key" "$option"; break; }
            option=$((option + 1))
        done ;;
    font)
        json parse payload '{}'; json set payload .font_id "$value" -s
        body := json emit payload; blit_cp_start font PUT /v1/fonts "$body" ;;
    hinting)
        json parse payload '{}'; json set payload .hinting "$value" -s
        body := json emit payload; blit_cp_start font PUT /v1/fonts "$body" ;;
    shape | palette) json set BCP_DRAFT ".pointer.$key" "$value" -s; BCP_DIRTY=1 ;;
    device) BCP_POINTER_ID=$value ;;
    kbdevice) BCP_KEYBOARD_ID=$value ;;
    capsboot | numboot)
        [ "$value" != unset ] || return 0
        option=false; [ "$value" != on ] || option=true
        if [ "$key" = capsboot ]; then blit_keyboard_put caps_lock_boot "$option";
        else blit_keyboard_put num_lock_boot "$option"; fi ;;
    kbcurrent)
        blit_kb_list
        for ((option = 0; option < ${#BCP_KBL[@]}; option++)); do
            body := blit_kb_name "${BCP_KBL[$option]}" "${BCP_KBV[$option]}"
            [ "$body" != "$value" ] || { BCP_KBC=$option; blit_kb_store 1; break; }
        done ;;
    kbaddlayout)
        option=0
        while [ -n "${BCP_KBAVAIL[layouts][$option][layout]}" ]; do
            if [ "${BCP_KBAVAIL[layouts][$option][name]}" = "$value" ]; then
                BCP_KBADD_LAYOUT=${BCP_KBAVAIL[layouts][$option][layout]}; BCP_KBADD_VARIANT=
                json parse BCP_KBVARS '{}'
                blit_cp_start kbvariants GET "/v1/input/keyboards/available?layout=$BCP_KBADD_LAYOUT"
                break
            fi
            option=$((option + 1))
        done ;;
    kbaddvariant)
        BCP_KBADD_VARIANT=
        option=0
        while [ -n "${BCP_KBVARS[variants][$option][variant]}" ]; do
            [ "${BCP_KBVARS[variants][$option][name]}" != "$value" ] ||
                { BCP_KBADD_VARIANT=${BCP_KBVARS[variants][$option][variant]}; break; }
            option=$((option + 1))
        done ;;
    capskey) option := blit_role_value "$value"; blit_keyboard_put modifiers.58 "$option" -s ;;
    superkey) option := blit_role_value "$value"
        blit_keyboard_put modifiers.125 "$option" -s; blit_keyboard_put modifiers.126 "$option" -s ;;
    acceleration) option=0; [ "$value" != adaptive ] || option=1; blit_mouse_slide 0 acceleration "$option" ;;
    esac
    return 0
}

fn blit_cp_selected(int w, value) {
    blit_cp_choose "${BCP_DROP_KEY[$w]}" "$value"
}
fn blit_drop(int w, int r, int c, key) {
    [ "$BCP_BUSY" = 0 ] || { [ "$key" != font ] && [ "$key" != hinting ] && [ "$key" != kbcurrent ] && [ "$key" != kbaddlayout ]; } || return 0
    blit_cp_choices "$key"
    [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
    BCP_DROP_KEY[$w]=$key
    dt_droplist "$w" "$r" "$c" blit_cp_selected "${BCP_CHOICES[@]}"
}
fn blit_mouse_drop(int w, int r, int c, key) {
    blit_drop "$w" "$r" "$c" "$key"
}

fn blit_do(int w, key, int dir) {
    local raw body pane=auto i=0 value tenths output ordinal
    local -A payload
    # What sends a request waits for the one in flight (blit_cp_start
    # refuses a second anyway); what only edits the draft never waits.
    case $key in reload | apply | retry | save | zap | restart | hud | hud_hibr) [ "$BCP_BUSY" = 0 ] || return 0 ;; esac
    case $key in
    url | token) blit_cp_edit "$key"; return 0 ;;
    reload) BCP_CONNECTION_READY=0; BCP_DIRTY=0; BCP_BASE_REV=-1; blit_cp_start refresh; return 0 ;;
    zap)
        # Saved by Blit itself (PUT /v1/control/shutdown-key keeps the
        # chord and its modifiers; only enabled changes here).
        value=true; [ "${BCP_ZAP[enabled]}" = true ] && value=false
        blit_cp_start zap PUT /v1/control/shutdown-key "{\"enabled\":$value}" ;;
    hud)
        value=true; [ "${BCP_SNAPSHOT[settings][document][hud][enabled]}" = true ] && value=false
        blit_cp_hud_apply enabled "$value" ;;
    hud_hibr)
        value := blit_cp_hud_sections hibr
        blit_cp_hud_apply sections "$value" json ;;
    restart)
        dt_confirm "Restart Blit now? Every session on it ends, and you log in again." blit_cp_restart ;;
    enabled)
        value=true; [ "${BCP_DRAFT[login][enabled]:-true}" = true ] && value=false
        json set BCP_DRAFT .login.enabled "$value"; BCP_DIRTY=1 ;;
    primary | fallback | font | compositor | frame_timing | hud_corner | update_restart | fxcolor:* | fxkind:*)
        blit_cp_choices "$key"
        [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
        value := cp_next "$BCP_CHOICE_CURRENT" "$dir" "${BCP_CHOICES[@]}"
        blit_cp_choose "$key" "$value" ;;
    aux:*) output=${key#aux:}; ordinal=${output##*:}; output=${output%:*}; blit_cp_toggle "$output" "$ordinal" ;;
    apply | retry)
        raw := blit_cp_auxiliary_json
        json parse payload '{}'; json parse 'payload[bindings]' "$raw"
        [ "$key" != retry ] || json set payload .retry_stopped true
        body := json emit payload
        blit_cp_start "$key" POST /v1/auxiliary-displays/apply "$body" "${BCP_LIVE[revision]}" ;;
    save)
        raw := json emit BCP_DRAFT
        json parse payload '{}'; json parse 'payload[document]' "$raw"
        body := json emit payload
        blit_cp_start save PUT /v1/settings "$body" "$BCP_BASE_REV" ;;
    zoom:*)
        value := blit_cp_zoom_of "${key#zoom:}"
        blit_slide "$w" "$key" "$((value + dir * 25))" ;;
    hud_opacity)
        value=${BCP_HUD_HELD:-${BCP_SNAPSHOT[settings][effective][hud][opacity]}}
        [ -n "$value" ] || return 0
        blit_slide "$w" hud_opacity "$((value + dir * 10))" ;;
    font_size)
        value=${BCP_FONT_HELD:-${BCP_FONT_SIZE_PENDING:-${BCP_FONT_SIZE_REQUESTED:-${BCP_SNAPSHOT[fonts][active][size_px]}}}}
        [ -n "$value" ] && [ "$value" != null ] || return 0
        blit_slide "$w" font_size "$((value + dir))" ;;
    columns:* | rows:*)
        output=${key#*:}; value=${key%%:*}
        tenths=$(( ${BCP_DRAFT[display_layouts][$output][$value]:-1} + dir ))
        blit_slide "$w" "$key" "$tenths" ;;
    fxall) value=1; [ "${BCP_FX[enabled]:-true}" = false ] || value=0; blit_cp_effect 0 fxall "$value" ;;
    fxpane:*)
        output=${key#fxpane:}; ordinal=${output##*:}; output=${output%:*}
        value=1; [ "${BCP_FX[$output][$ordinal][enabled]:-true}" = false ] || value=0
        blit_cp_effect 0 "$key" "$value" ;;
    fx:*)
        output=${key#fx:}; value=${output%%:*}; output=${output#*:}
        ordinal=${output##*:}; output=${output%:*}
        local spec param step=5
        spec := blit_cp_effect_spec "$value" || return 0
        param=${spec%% *}
        [ "$param" != radius_px ] || step=1
        blit_cp_effect 0 "$key" "$(( ${BCP_FX[$output][$ordinal][$value][$param]:-0} + dir * step ))" ;;
    export) dt_filepick save "Export Blit Configuration" "JSON:*.json" "$HOME" blit.json blit_cp_exported "" ;;
    import) dt_filepick open "Import Blit Configuration" "JSON:*.json" "$HOME" "" blit_cp_imported "" ;;
    esac
    return 0
}

# The restart, once confirmed: Blit stops cleanly and starts again in place
# (POST /v1/control/restart), with no reboot.
fn blit_cp_restart() {
    blit_cp_start restart POST /v1/control/restart "{}"
    return 0
}

fn blit_slide(int w, key, int value) {
    local body output field
    local -A payload grid
    case $key in
    font_size)
        [ -n "${BCP_SNAPSHOT[fonts][active][size_px]}" ] && [ "${BCP_SNAPSHOT[fonts][active][size_px]}" != null ] || return 0
        [ "$value" -ge 8 ] && [ "$value" -le 64 ] || return 0
        # While the slider is held the size is only shown: applying each
        # step reflowed the screen under the pointer, and the next step
        # landed somewhere else on the slider (#368). The release applies it.
        if [ "$w" != 0 ] && [ -n "${CP_MSLIDE[$w]:-}" ]; then
            BCP_FONT_HELD=$value
            BCP_FONT_HELDW=$w
            command -v dt_want > /dev/null && dt_want 50
            return 0
        fi
        if [ "$BCP_BUSY" = 1 ]; then BCP_FONT_SIZE_PENDING=$value; return 0; fi
        BCP_FONT_SIZE_REQUESTED=$value
        json parse payload '{}'
        json set payload .size_px "$value"
        body := json emit payload
        blit_cp_start font PUT /v1/fonts "$body" ;;
    columns:* | rows:*)
        [ -n "${BCP_SNAPSHOT[topology][outputs][0][layout][columns]}" ] || {
            BCP_STATUS="Independent grids require Blit 0.1.545"; return 0
        }
        [ "$value" -ge 1 ] && [ "$value" -le 8 ] || return 0
        output=${key#*:}; field=${key%%:*}
        json parse grid '{}'
        json set grid .columns "${BCP_DRAFT[display_layouts][$output][columns]:-1}"
        json set grid .rows "${BCP_DRAFT[display_layouts][$output][rows]:-1}"
        json set grid ".$field" "$value"
        body := json emit grid
        json parse "BCP_DRAFT[display_layouts][$output]" "$body"
        BCP_DIRTY=1 ;;
    fx:*) blit_cp_effect "$w" "$key" "$value" ;;
    zoom:*)
        value := blit_cp_zoom_snap "$value"
        # Shown while held, applied when let go, like the font size: each
        # step resizes that display's sessions.
        if [ "$w" != 0 ] && [ -n "${CP_MSLIDE[$w]:-}" ]; then
            BCP_ZOOM_HELD=$value; BCP_ZOOM_HELDID=${key#zoom:}; BCP_ZOOM_HELDW=$w
            command -v dt_want > /dev/null && dt_want 50
            return 0
        fi
        if [ "$BCP_BUSY" = 1 ]; then
            BCP_ZOOM_HELD=$value; BCP_ZOOM_HELDID=${key#zoom:}; BCP_ZOOM_HELDW=0
            return 0
        fi
        BCP_ZOOM_HELD=
        blit_cp_start zoom PATCH "/v1/displays/${key#zoom:}" "{\"configuration\":{\"zoom\":$value}}" ;;
    hud_opacity)
        [ "$value" -ge 10 ] || value=10
        [ "$value" -le 100 ] || value=100
        # Shown while held, applied when let go, like the font size.
        if [ "$w" != 0 ] && [ -n "${CP_MSLIDE[$w]:-}" ]; then
            BCP_HUD_HELD=$value
            BCP_HUD_HELDW=$w
            command -v dt_want > /dev/null && dt_want 50
            return 0
        fi
        [ "$BCP_BUSY" = 0 ] || { BCP_HUD_HELD=$value; BCP_HUD_HELDW=0; return 0; }
        blit_cp_hud_apply opacity "$value" ;;
    esac
    return 0
}

# A second native pane in the same bundle, sharing the existing connection,
# worker, snapshot and revision-protected settings draft. Hibr's own Mouse
# pane continues to own window-manager behaviour, not physical Blit devices.
fn blit_mouse_is_pointer(int i) {
    local j=0
    [ "${BCP_SNAPSHOT[input_devices][devices][$i][state][present]}" = true ] || return 1
    while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][kinds][$j]}" ]; do
        [ "${BCP_SNAPSHOT[input_devices][devices][$i][kinds][$j]}" != pointer ] || return 0
        j=$((j + 1))
    done
    return 1
}
fn blit_mouse_index() {
    local i=0 first=-1
    while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" ]; do
        if blit_mouse_is_pointer "$i"; then
            [ "$first" -ge 0 ] || first=$i
            [ "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" != "$BCP_POINTER_ID" ] || { ret "$i"; return 0; }
        fi
        i=$((i + 1))
    done
    [ "$first" -lt 0 ] || BCP_POINTER_ID=${BCP_SNAPSHOT[input_devices][devices][$first][id]}
    ret "$first"
}

fn blit_mouse_rows(int w) {
    local n=0 i value raw
    local -A cfg
    blit_cp_tick "$w"
    blit_cp_row "$w" "$n" head "Blit pointer and devices"; n=$((n + 1))
    blit_cp_row "$w" "$n" action Server "$BCP_URL" url; n=$((n + 1))
    blit_cp_row "$w" "$n" action "API Token (remembered)" "" token; n=$((n + 1))
    blit_cp_row "$w" "$n" info "$BCP_STATUS"; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Reload (discard draft)" "" reload; n=$((n + 1))
    [ "$BCP_BASE_REV" -ge 0 ] || { ret "$n"; return 0; }
    if [ -z "${BCP_SNAPSHOT[settings][effective][pointer][shape]}" ]; then
        blit_cp_row "$w" "$n" info "Pointer appearance" "Not reported by server"; n=$((n + 1))
    else
        blit_cp_row "$w" "$n" head "Appearance (staged until Save)"; n=$((n + 1))
        blit_cp_row "$w" "$n" set Shape "${BCP_DRAFT[pointer][shape]:-arrow}" shape; n=$((n + 1))
        blit_cp_row "$w" "$n" set Palette "${BCP_DRAFT[pointer][palette]:-pearl}" palette; n=$((n + 1))
        value=${BCP_DRAFT[pointer][size_px]:-24}
        blit_cp_row "$w" "$n" set "Pointer Size" "$value" size slider
        CP[$w][$n][min]=24; CP[$w][$n][max]=64; CP[$w][$n][after]="($value px)"; n=$((n + 1))
        value=on; [ "${BCP_DRAFT[pointer][shadow]:-true}" != false ] || value=off
        blit_cp_row "$w" "$n" set Shadow "$value" shadow bool; n=$((n + 1))
        blit_cp_row "$w" "$n" info "Pointer size is independent of font scale"; n=$((n + 1))
        # Blit 0.3.102 (ADR 0234): shaking the mouse grows the pointer, the
        # harder the bigger. Offered when the server reports it.
        if [ -n "${BCP_SNAPSHOT[settings][effective][pointer][shake_to_find]}" ]; then
            blit_cp_row "$w" "$n" head "Shake to Find (staged until Save)"; n=$((n + 1))
            value := blit_mouse_shake shake_to_find
            [ "$value" != false ] && value=on || value=off
            blit_cp_row "$w" "$n" set "Shake to Find" "$value" shake bool; n=$((n + 1))
            if [ "$value" = on ]; then
                value := blit_mouse_shake shake_max_px
                blit_cp_row "$w" "$n" set "Largest When Shaken" "$value" shakemax slider
                CP[$w][$n][min]=64; CP[$w][$n][max]=256; CP[$w][$n][after]="($value px)"; n=$((n + 1))
                value := blit_mouse_shake shake_sensitivity
                blit_cp_row "$w" "$n" set "Shake Sensitivity" "$value" shakesens slider
                CP[$w][$n][min]=1; CP[$w][$n][max]=10; CP[$w][$n][after]="($value; 10 is a light shake)"; n=$((n + 1))
                # Blit 0.3.104: how long it takes to shrink back.
                if [ -n "${BCP_SNAPSHOT[settings][effective][pointer][shake_shrink_ms]}" ]; then
                    value := blit_mouse_shake shake_shrink_ms
                    blit_cp_row "$w" "$n" set "Shrink Back Over" "$value" shakeshrink slider
                    CP[$w][$n][min]=150; CP[$w][$n][max]=3000; CP[$w][$n][after]="($value ms)"; n=$((n + 1))
                fi
            fi
        fi
        # Blit 0.3.106 (ADR 0235): a program that stops answering shows the
        # busy pointer, a ring going round. Offered when the server reports it.
        if [ -n "${BCP_SNAPSHOT[settings][effective][pointer][busy_pointer]}" ]; then
            blit_cp_row "$w" "$n" head "Busy Pointer (staged until Save)"; n=$((n + 1))
            value := blit_mouse_shake busy_pointer
            [ "$value" != false ] && value=on || value=off
            blit_cp_row "$w" "$n" set "Busy Pointer" "$value" busy bool; n=$((n + 1))
            if [ "$value" = on ]; then
                value := blit_mouse_shake busy_after_ms
                blit_cp_row "$w" "$n" set "Busy After" "$value" busyafter slider
                CP[$w][$n][min]=500; CP[$w][$n][max]=10000; CP[$w][$n][after]="($value ms without an answer)"; n=$((n + 1))
            fi
            value := blit_mouse_shake busy_spin_ms
            blit_cp_row "$w" "$n" set "Spin Once Every" "$value" busyspin slider
            CP[$w][$n][min]=400; CP[$w][$n][max]=3000; CP[$w][$n][after]="($value ms)"; n=$((n + 1))
        fi
    fi
    blit_cp_row "$w" "$n" head "Physical pointer (staged until Save)"; n=$((n + 1))
    i := blit_mouse_index
    if [ "$i" -lt 0 ]; then
        blit_cp_row "$w" "$n" info "No present pointer device"; n=$((n + 1))
    else
        blit_cp_row "$w" "$n" set Device "${BCP_SNAPSHOT[input_devices][devices][$i][name]}" device; n=$((n + 1))
        blit_cp_row "$w" "$n" info "$BCP_POINTER_ID"; n=$((n + 1))
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then
            raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"
        fi
        json parse cfg "$raw"
        value=${cfg[sensitivity_percent]:-100}
        blit_cp_row "$w" "$n" set Sensitivity "$value" sensitivity slider
        CP[$w][$n][min]=10; CP[$w][$n][max]=1000; CP[$w][$n][after]="($value%)"; n=$((n + 1))
        blit_cp_row "$w" "$n" set Acceleration "${cfg[acceleration][profile]:-flat}" acceleration; n=$((n + 1))
        value=off; [ "${cfg[natural_scroll]:-false}" != true ] || value=on
        blit_cp_row "$w" "$n" set "Natural Scroll" "$value" natural bool; n=$((n + 1))
        if [ -n "${cfg[tap_to_click]+x}" ]; then
            value=off; [ "${cfg[tap_to_click]}" != true ] || value=on
            blit_cp_row "$w" "$n" set "Tap to Click" "$value" tap bool; n=$((n + 1))
        fi
        # Offered where the device says so; the saved settings keep these
        # only when switched off (Blit ADR 0193), so on is the default.
        if [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][configuration][tap_and_drag]+x}" ]; then
            value=on; [ "${cfg[tap_and_drag]:-true}" != false ] || value=off
            blit_cp_row "$w" "$n" set "Tap and Drag" "$value" tapdrag bool; n=$((n + 1))
        fi
        if [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][configuration][disable_while_typing]+x}" ]; then
            value=on; [ "${cfg[disable_while_typing]:-true}" != false ] || value=off
            blit_cp_row "$w" "$n" set "Disable While Typing" "$value" dwt bool; n=$((n + 1))
        fi
        value=${cfg[scroll_step]:-1}
        blit_cp_row "$w" "$n" set "Device Wheel Step" "$value" wheel slider
        CP[$w][$n][min]=1; CP[$w][$n][max]=10; CP[$w][$n][after]="($value)"; n=$((n + 1))
    fi
    blit_cp_row "$w" "$n" action "Save all staged Blit settings" "rev $BCP_BASE_REV" save; n=$((n + 1))
    blit_cp_row "$w" "$n" info Storage "${BCP_SNAPSHOT[settings][storage][state]}"; n=$((n + 1))
    ret "$n"
}

# A shake setting (Blit ADR 0234): the draft's, else what Blit reports.
fn blit_mouse_shake(field) {
    local value=${BCP_DRAFT[pointer][$field]}
    [ -n "$value" ] && [ "$value" != null ] || value=${BCP_SNAPSHOT[settings][effective][pointer][$field]}
    ret "$value"
}

fn blit_mouse_slide(int w, key, int value) {
    local i raw field flag
    local -A cfg
    if [ "$key" = size ]; then
        [ -n "${BCP_SNAPSHOT[settings][effective][pointer][shape]}" ] || return 0
        [ "$value" -ge 24 ] && [ "$value" -le 64 ] || return 0
        json set BCP_DRAFT .pointer.size_px "$value"
    elif [ "$key" = busy ] || [ "$key" = busyafter ] || [ "$key" = busyspin ]; then
        [ -n "${BCP_SNAPSHOT[settings][effective][pointer][busy_pointer]}" ] || return 0
        case $key in
        busy) flag=false; [ "$value" != 1 ] || flag=true; json set BCP_DRAFT .pointer.busy_pointer "$flag" ;;
        busyafter) [ "$value" -ge 500 ] && [ "$value" -le 10000 ] || return 0; json set BCP_DRAFT .pointer.busy_after_ms "$value" ;;
        busyspin) [ "$value" -ge 400 ] && [ "$value" -le 3000 ] || return 0; json set BCP_DRAFT .pointer.busy_spin_ms "$value" ;;
        esac
    elif [ "$key" = shake ] || [ "$key" = shakemax ] || [ "$key" = shakesens ] || [ "$key" = shakeshrink ]; then
        [ -n "${BCP_SNAPSHOT[settings][effective][pointer][shake_to_find]}" ] || return 0
        case $key in
        shake) flag=false; [ "$value" != 1 ] || flag=true; json set BCP_DRAFT .pointer.shake_to_find "$flag" ;;
        shakemax) [ "$value" -ge 64 ] && [ "$value" -le 256 ] || return 0; json set BCP_DRAFT .pointer.shake_max_px "$value" ;;
        shakesens) [ "$value" -ge 1 ] && [ "$value" -le 10 ] || return 0; json set BCP_DRAFT .pointer.shake_sensitivity "$value" ;;
        shakeshrink) [ -n "${BCP_SNAPSHOT[settings][effective][pointer][shake_shrink_ms]}" ] || return 0
            [ "$value" -ge 150 ] && [ "$value" -le 3000 ] || return 0; json set BCP_DRAFT .pointer.shake_shrink_ms "$value" ;;
        esac
    else
        i := blit_mouse_index; [ "$i" -ge 0 ] || return 0
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"; fi
        json parse cfg "$raw"
        case $key in
        sensitivity) [ "$value" -ge 10 ] && [ "$value" -le 1000 ] || return 0; json set cfg .sensitivity_percent "$value" ;;
        wheel) [ "$value" -ge 1 ] && [ "$value" -le 10 ] || return 0; json set cfg .scroll_step "$value" ;;
        natural) flag=false; [ "$value" != 1 ] || flag=true; json set cfg .natural_scroll "$flag" ;;
        tap) [ -n "${cfg[tap_to_click]+x}" ] || return 0
            flag=false; [ "$value" != 1 ] || flag=true; json set cfg .tap_to_click "$flag" ;;
        tapdrag) [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][configuration][tap_and_drag]+x}" ] || return 0
            flag=false; [ "$value" != 1 ] || flag=true; json set cfg .tap_and_drag "$flag" ;;
        dwt) [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][configuration][disable_while_typing]+x}" ] || return 0
            flag=false; [ "$value" != 1 ] || flag=true; json set cfg .disable_while_typing "$flag" ;;
        acceleration) field=flat; [ "$value" != 1 ] || field=adaptive; json set cfg .acceleration.profile "$field" -s ;;
        *) return 0 ;;
        esac
        raw := json emit cfg
        json parse "BCP_DRAFT[input_devices][$BCP_POINTER_ID]" "$raw"
    fi
    BCP_DIRTY=1
    return 0
}

fn blit_mouse_do(int w, key, int dir) {
    local value raw i
    case $key in
    shape | palette | device | acceleration)
        blit_cp_choices "$key"
        [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
        value := cp_next "$BCP_CHOICE_CURRENT" "$dir" "${BCP_CHOICES[@]}"
        blit_cp_choose "$key" "$value" ;;
    shadow) value=true; [ "${BCP_DRAFT[pointer][shadow]:-true}" != true ] || value=false
        json set BCP_DRAFT .pointer.shadow "$value"; BCP_DIRTY=1 ;;
    size) blit_mouse_slide "$w" size "$(( ${BCP_DRAFT[pointer][size_px]:-24} + dir ))" ;;
    shake) value := blit_mouse_shake shake_to_find
        [ "$value" = false ] && value=1 || value=0
        blit_mouse_slide "$w" shake "$value" ;;
    shakemax) value := blit_mouse_shake shake_max_px
        blit_mouse_slide "$w" shakemax "$(( value + dir * 8 ))" ;;
    shakesens) value := blit_mouse_shake shake_sensitivity
        blit_mouse_slide "$w" shakesens "$(( value + dir ))" ;;
    shakeshrink) value := blit_mouse_shake shake_shrink_ms
        blit_mouse_slide "$w" shakeshrink "$(( value + dir * 50 ))" ;;
    busy) value := blit_mouse_shake busy_pointer
        [ "$value" = false ] && value=1 || value=0
        blit_mouse_slide "$w" busy "$value" ;;
    busyafter) value := blit_mouse_shake busy_after_ms
        blit_mouse_slide "$w" busyafter "$(( value + dir * 250 ))" ;;
    busyspin) value := blit_mouse_shake busy_spin_ms
        blit_mouse_slide "$w" busyspin "$(( value + dir * 100 ))" ;;
    sensitivity | wheel | natural | tap | tapdrag | dwt)
        i := blit_mouse_index; [ "$i" -ge 0 ] || return 0
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"; fi
        local -A cfg; json parse cfg "$raw"
        case $key in
        sensitivity) value=$(( ${cfg[sensitivity_percent]:-100} + dir * 5 )) ;;
        wheel) value=$(( ${cfg[scroll_step]:-1} + dir )) ;;
        natural) value=1; [ "${cfg[natural_scroll]:-false}" != true ] || value=0 ;;
        tap) value=1; [ "${cfg[tap_to_click]:-false}" != true ] || value=0 ;;
        tapdrag) value=1; [ "${cfg[tap_and_drag]:-true}" = false ] || value=0 ;;
        dwt) value=1; [ "${cfg[disable_while_typing]:-true}" = false ] || value=0 ;;
        esac
        blit_mouse_slide "$w" "$key" "$value" ;;
    *) blit_do "$w" "$key" "$dir" ;;
    esac
    return 0
}

# A third native pane in the same bundle: the physical keyboard, as Blit
# keeps it per device (repeat, the lock lamps at start, which key is which
# modifier). Hibr's own Keyboard pane keeps how keys reach a terminal and
# its Shortcuts pane what the desktop does with them; neither is here.
fn blit_keyboard_is_keyboard(int i) {
    local j=0
    [ "${BCP_SNAPSHOT[input_devices][devices][$i][state][present]}" = true ] || return 1
    while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][kinds][$j]}" ]; do
        [ "${BCP_SNAPSHOT[input_devices][devices][$i][kinds][$j]}" != keyboard ] || return 0
        j=$((j + 1))
    done
    return 1
}
fn blit_keyboard_index() {
    local i=0 first=-1
    while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" ]; do
        if blit_keyboard_is_keyboard "$i"; then
            [ "$first" -ge 0 ] || first=$i
            [ "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" != "$BCP_KEYBOARD_ID" ] || { ret "$i"; return 0; }
        fi
        i=$((i + 1))
    done
    [ "$first" -lt 0 ] || BCP_KEYBOARD_ID=${BCP_SNAPSHOT[input_devices][devices][$first][id]}
    ret "$first"
}
# The chosen keyboard's configuration: the staged draft's, else Blit's.
fn blit_keyboard_raw(int i) {
    local raw
    raw := json get BCP_DRAFT ".input_devices[$BCP_KEYBOARD_ID]" 2> /dev/null || raw=null
    if [ "$raw" = null ] || [ -z "$raw" ]; then raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"; fi
    ret "$raw"
}
# Stage one field of the chosen keyboard's configuration, the rest kept.
fn blit_keyboard_put(field, value, kind = "") {
    local i raw
    local -A cfg
    i := blit_keyboard_index; [ "$i" -ge 0 ] || return 0
    raw := blit_keyboard_raw "$i"; json parse cfg "$raw"
    if [ "$kind" = -s ]; then json set cfg ".$field" "$value" -s; else json set cfg ".$field" "$value"; fi
    raw := json emit cfg
    json parse "BCP_DRAFT[input_devices][$BCP_KEYBOARD_ID]" "$raw"
    BCP_DIRTY=1
    return 0
}

# The keyboards as Blit has them now (GET /v1/input/keyboards, Blit
# 0.3.93): BCP_KBL layouts, BCP_KBV variants, BCP_KBC the current one.
# They are live, like the font: a change goes to Blit at once.
fn blit_kb_list() {
    local i=0
    BCP_KBL=(); BCP_KBV=(); BCP_KBC=${BCP_KBLIVE[current]:-0}
    while [ -n "${BCP_KBLIVE[keyboards][$i][layout]}" ]; do
        BCP_KBL+=("${BCP_KBLIVE[keyboards][$i][layout]}")
        BCP_KBV+=("${BCP_KBLIVE[keyboards][$i][variant]}")
        i=$((i + 1))
    done
    [ "${#BCP_KBL[@]}" -gt 0 ] || { BCP_KBL=(us); BCP_KBV=(""); BCP_KBC=0; }
    [ "$BCP_KBC" -lt "${#BCP_KBL[@]}" ] || BCP_KBC=0
    return 0
}
# BCP_KBL, BCP_KBV and BCP_KBC to Blit at once (PUT /v1/input/keyboards);
# `current` alone when only the one in use changed.
fn blit_kb_store(only_current = 0) {
    local i text='{"keyboards":['
    if [ "$only_current" = 1 ]; then
        text="{\"current\":$BCP_KBC}"
    else
        for ((i = 0; i < ${#BCP_KBL[@]}; i++)); do
            [ "$i" = 0 ] || text+=','
            text+="{\"layout\":\"${BCP_KBL[$i]}\",\"variant\":\"${BCP_KBV[$i]}\"}"
        done
        text+="],\"current\":$BCP_KBC}"
    fi
    blit_cp_start kbput PUT /v1/input/keyboards "$text"
    return 0
}
# A keyboard's name: as Blit names the ones it has, else the system's
# layout (with the variant's name when listed), else its own names.
fn blit_kb_name(layout, variant = "") {
    local i=0
    while [ -n "${BCP_KBLIVE[keyboards][$i][layout]}" ]; do
        if [ "${BCP_KBLIVE[keyboards][$i][layout]}" = "$layout" ] &&
           [ "${BCP_KBLIVE[keyboards][$i][variant]}" = "$variant" ]; then
            ret "${BCP_KBLIVE[keyboards][$i][name]}"; return 0
        fi
        i=$((i + 1))
    done
    if [ -n "$variant" ] && [ "${BCP_KBVARS[layout]}" = "$layout" ]; then
        i=0
        while [ -n "${BCP_KBVARS[variants][$i][variant]}" ]; do
            [ "${BCP_KBVARS[variants][$i][variant]}" != "$variant" ] ||
                { ret "${BCP_KBVARS[variants][$i][name]}"; return 0; }
            i=$((i + 1))
        done
    fi
    if [ -z "$variant" ]; then
        i=0
        while [ -n "${BCP_KBAVAIL[layouts][$i][layout]}" ]; do
            [ "${BCP_KBAVAIL[layouts][$i][layout]}" != "$layout" ] ||
                { ret "${BCP_KBAVAIL[layouts][$i][name]}"; return 0; }
            i=$((i + 1))
        done
    fi
    if [ -n "$variant" ]; then ret "$layout $variant"; else ret "$layout"; fi
    return 0
}

# A modifier role in the desktop's words (Super, not meta), and back.
fn blit_role_word(role) {
    case $role in
    caps_lock) ret "Caps Lock" ;; control) ret Control ;; alt) ret Alt ;; meta) ret Super ;;
    altgr) ret AltGr ;; shift) ret Shift ;; num_lock) ret "Num Lock" ;; none) ret Nothing ;;
    *) ret "$role" ;;
    esac
}
fn blit_role_value(word) {
    case $word in
    "Caps Lock") ret caps_lock ;; Control) ret control ;; Alt) ret alt ;; Super) ret meta ;;
    AltGr) ret altgr ;; Shift) ret shift ;; "Num Lock") ret num_lock ;; Nothing) ret none ;;
    *) ret "$word" ;;
    esac
}

fn blit_keyboard_rows(int w) {
    local n=0 i value raw
    local -A cfg
    blit_cp_tick "$w"
    blit_cp_row "$w" "$n" head "Blit keyboards"; n=$((n + 1))
    # One rule: this pane says what each key is and what it types; what a
    # combination of keys does is the desktop's Shortcuts pane.
    blit_cp_row "$w" "$n" info "What keys are and type. What shortcuts do: Shortcuts"; n=$((n + 1))
    blit_cp_row "$w" "$n" action Server "$BCP_URL" url; n=$((n + 1))
    blit_cp_row "$w" "$n" action "API Token (remembered)" "" token; n=$((n + 1))
    blit_cp_row "$w" "$n" info "$BCP_STATUS"; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Reload (discard draft)" "" reload; n=$((n + 1))
    [ "$BCP_BASE_REV" -ge 0 ] || { ret "$n"; return 0; }
    blit_cp_row "$w" "$n" head "Physical keyboard (staged until Save)"; n=$((n + 1))
    i := blit_keyboard_index
    if [ "$i" -lt 0 ]; then
        blit_cp_row "$w" "$n" info "No present keyboard"; n=$((n + 1))
    else
        blit_cp_row "$w" "$n" set Device "${BCP_SNAPSHOT[input_devices][devices][$i][name]}" kbdevice; n=$((n + 1))
        blit_cp_row "$w" "$n" info "$BCP_KEYBOARD_ID"; n=$((n + 1))
        raw := blit_keyboard_raw "$i"; json parse cfg "$raw"
        # Blit reports repeat only for a keyboard that repeats, as the
        # kernel holds it, so the rows read back what took effect.
        if [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][configuration][repeat_delay_ms]+x}" ]; then
            value=${cfg[repeat_delay_ms]:-250}
            blit_cp_row "$w" "$n" set "Repeat Delay" "$value" delay slider
            CP[$w][$n][min]=100; CP[$w][$n][max]=2000; CP[$w][$n][after]="($value ms)"; n=$((n + 1))
            value=${cfg[repeat_rate_hz]:-33}
            blit_cp_row "$w" "$n" set "Repeat Rate" "$value" rate slider
            CP[$w][$n][min]=1; CP[$w][$n][max]=100; CP[$w][$n][after]="($value a second)"; n=$((n + 1))
        else
            blit_cp_row "$w" "$n" info "This keyboard does not repeat keys"; n=$((n + 1))
        fi
        value=unset; [ -z "${cfg[caps_lock_boot]+x}" ] || { value=off; [ "${cfg[caps_lock_boot]}" != true ] || value=on; }
        blit_cp_row "$w" "$n" set "Caps Lock at Start" "$value" capsboot; n=$((n + 1))
        value=unset; [ -z "${cfg[num_lock_boot]+x}" ] || { value=off; [ "${cfg[num_lock_boot]}" != true ] || value=on; }
        blit_cp_row "$w" "$n" set "Num Lock at Start" "$value" numboot; n=$((n + 1))
        value := blit_role_word "${cfg[modifiers][58]:-caps_lock}"
        blit_cp_row "$w" "$n" set "Caps Lock Key Is" "$value" capskey; n=$((n + 1))
        value := blit_role_word "${cfg[modifiers][125]:-meta}"
        blit_cp_row "$w" "$n" set "Super Key Is" "$value" superkey; n=$((n + 1))
        blit_cp_row "$w" "$n" info "Super is the Search key on a Chromebook"; n=$((n + 1))
        # Super made another key here takes the Super tap that opens the
        # Start Menu, and every super- shortcut in the desktop's Shortcuts
        # pane, with it.
        [ "${cfg[modifiers][125]:-meta}" = meta ] ||
            { blit_cp_row "$w" "$n" info "The Start Menu's Super tap and super- shortcuts need Super"; n=$((n + 1)); }
    fi
    # The keyboards (layouts) Blit types with, one list for every keyboard,
    # staged like the rest (Blit 0.3.93, ADR 0231).
    blit_cp_row "$w" "$n" head "Keyboards (live)"; n=$((n + 1))
    if [ -z "${BCP_KBLIVE[current]}" ]; then
        blit_cp_row "$w" "$n" info "Keyboards" "Not reported by server"; n=$((n + 1))
    else
        blit_kb_list
        value := blit_kb_name "${BCP_KBL[$BCP_KBC]}" "${BCP_KBV[$BCP_KBC]}"
        blit_cp_row "$w" "$n" set "In Use" "$value" kbcurrent; n=$((n + 1))
        for ((i = 0; i < ${#BCP_KBL[@]}; i++)); do
            value := blit_kb_name "${BCP_KBL[$i]}" "${BCP_KBV[$i]}"
            if [ "${#BCP_KBL[@]}" -gt 1 ]; then
                blit_cp_row "$w" "$n" action "Remove $value" "" "kbremove:$i"; n=$((n + 1))
            else
                blit_cp_row "$w" "$n" info "$value"; n=$((n + 1))
            fi
        done
        value := blit_kb_name "$BCP_KBADD_LAYOUT" ""
        blit_cp_row "$w" "$n" set "Add Layout" "${value:-choose}" kbaddlayout; n=$((n + 1))
        if [ -n "$BCP_KBADD_LAYOUT" ]; then
            value=Standard
            if [ -n "$BCP_KBADD_VARIANT" ]; then value := blit_kb_name "$BCP_KBADD_LAYOUT" "$BCP_KBADD_VARIANT"; fi
            blit_cp_row "$w" "$n" set Variant "$value" kbaddvariant; n=$((n + 1))
            blit_cp_row "$w" "$n" action "Add Keyboard" "" kbadd; n=$((n + 1))
        fi
    fi
    blit_cp_row "$w" "$n" action "Save all staged Blit settings" "rev $BCP_BASE_REV" save; n=$((n + 1))
    blit_cp_row "$w" "$n" info Storage "${BCP_SNAPSHOT[settings][storage][state]}"; n=$((n + 1))
    ret "$n"
}

fn blit_keyboard_slide(int w, key, int value) {
    case $key in
    delay) [ "$value" -ge 100 ] && [ "$value" -le 2000 ] || return 0; blit_keyboard_put repeat_delay_ms "$value" ;;
    rate) [ "$value" -ge 1 ] && [ "$value" -le 100 ] || return 0; blit_keyboard_put repeat_rate_hz "$value" ;;
    esac
    return 0
}

fn blit_keyboard_do(int w, key, int dir) {
    local value raw i
    local -A cfg
    case $key in
    kbremove:*)
        [ "$BCP_BUSY" = 0 ] || return 0
        blit_kb_list
        value=${key#kbremove:}
        [ "${#BCP_KBL[@]}" -gt 1 ] && [ "$value" -lt "${#BCP_KBL[@]}" ] || return 0
        BCP_KBL=("${BCP_KBL[@]:0:$value}" "${BCP_KBL[@]:$((value + 1))}")
        BCP_KBV=("${BCP_KBV[@]:0:$value}" "${BCP_KBV[@]:$((value + 1))}")
        [ "$BCP_KBC" -lt "$value" ] || [ "$BCP_KBC" = 0 ] || BCP_KBC=$((BCP_KBC - 1))
        blit_kb_store ;;
    kbadd)
        [ "$BCP_BUSY" = 0 ] && [ -n "$BCP_KBADD_LAYOUT" ] || return 0
        blit_kb_list
        [ "${#BCP_KBL[@]}" -lt 16 ] || return 0
        BCP_KBL+=("$BCP_KBADD_LAYOUT"); BCP_KBV+=("$BCP_KBADD_VARIANT")
        BCP_KBADD_LAYOUT=; BCP_KBADD_VARIANT=
        blit_kb_store ;;
    kbcurrent | kbaddlayout | kbaddvariant)
        blit_cp_choices "$key"
        [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
        value := cp_next "$BCP_CHOICE_CURRENT" "$dir" "${BCP_CHOICES[@]}"
        blit_cp_choose "$key" "$value" ;;
    kbdevice | capsboot | numboot | capskey | superkey)
        blit_cp_choices "$key"
        [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
        value := cp_next "$BCP_CHOICE_CURRENT" "$dir" "${BCP_CHOICES[@]}"
        blit_cp_choose "$key" "$value" ;;
    delay | rate)
        i := blit_keyboard_index; [ "$i" -ge 0 ] || return 0
        raw := blit_keyboard_raw "$i"; json parse cfg "$raw"
        if [ "$key" = delay ]; then value=$(( ${cfg[repeat_delay_ms]:-250} + dir * 25 ));
        else value=$(( ${cfg[repeat_rate_hz]:-33} + dir )); fi
        blit_keyboard_slide "$w" "$key" "$value" ;;
    *) blit_do "$w" "$key" "$dir" ;;
    esac
    return 0
}
fn blit_keyboard_drop(int w, int r, int c, key) {
    blit_drop "$w" "$r" "$c" "$key"
}

fn blit_cp_exported(path, context = "") {
    [ -n "$path" ] || return 0
    umask 077
    if json emit BCP_DRAFT -p > "$path"; then BCP_STATUS="Exported configuration (no connection secrets)";
    else BCP_STATUS="Export failed"; fi
}
fn blit_cp_imported(path, context = "") {
    local -A doc
    [ -n "$path" ] || return 0
    if ! json parse doc < "$path" 2> /dev/null || [ "${doc[version]}" != 1 ]; then
        BCP_STATUS="Import needs a version 1 Blit settings document"; return 0
    fi
    local raw
    raw := json emit doc; json parse BCP_DRAFT "$raw"
    BCP_DIRTY=1
    BCP_STATUS="Imported draft; Apply auxiliaries or Save as Default"
}

# The server's address and the token are each the desktop's one-line
# question (dt_ask); the token's field is masked.
fn blit_cp_edit(key) {
    BCP_EDITKEY=$key
    if [ "$key" = token ]; then
        dt_ask "Blit Connection" "API Token:" "$BCP_TOKEN" blit_cp_answer \
            "Kept privately for this server; never exported." 1 64
    else
        dt_ask "Blit Connection" "Server:" "$BCP_URL" blit_cp_answer \
            "An http(s) address and port, without a path." "" 64
    fi
}

# What was typed: the token kept, or the server changed. Refused, the
# question stays open.
fn blit_cp_answer(value, int id) {
    [ "$BCP_BUSY" = 0 ] || return 1
    if [ "$BCP_EDITKEY" = token ]; then
        case "$value" in *[!a-zA-Z0-9._~+/=-]*) BCP_CREDENTIAL_STATUS="Invalid bearer token characters"; return 1 ;; esac
        BCP_TOKEN=$value
        blit_cp_credentials 0 || return 1
    else
        BCP_URL=${value%/}; BCP_DIRTY=0; BCP_BASE_REV=-1
        blit_cp_credentials
        json parse BCP_SNAPSHOT '{}'; json parse BCP_DRAFT '{}'; json parse BCP_LIVE '{}'
    fi
    command -v cp_save > /dev/null && cp_save
    BCP_LAST=0
    blit_cp_start refresh
    return 0
}
