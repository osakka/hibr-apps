#!/usr/bin/env hibr
# blit -- API configuration and diagnostics for the Blit display server.
#
# Auxiliary Apply
# changes the running policy; Save as Default writes Blit's existing settings
# resource with revision protection. Login preferences take effect at restart.
# Font changes use Blit's live-and-saved font API. Hibr Displays continues to
# own native desktop arrangement after initial attachment.
# Every network request is hibr's own dav request, in a bounded background
# job of the desktop's (dt_job); no curl, and the token never on a command
# line. The connection token is kept in a private user file, is masked in its
# editor, and is excluded from configuration exports. The privileged updater
# token is never requested. The source of this pane is this file, in the
# hibr catalogue (itdlabs/hibr-apps), not the Blit tree.
strict
app blit "API configuration and diagnostics for the Blit display server" 0.1.10
command -v cp_pane > /dev/null && cp_pane blit "Blit" "▦" hardware
command -v cp_pane > /dev/null && cp_pane blit_mouse "Blit Mouse" "◎" hardware

BCP_URL=${BCP_URL:-${BLIT_CP_URL:-http://127.0.0.1:8080}}
command -v dt_keep > /dev/null && dt_keep BCP_URL
BCP_TOKEN=
BCP_CREDENTIAL_STATUS=
BCP_CONNECTION_READY=0
BCP_CREDENTIAL_URL=
BCP_FONT_SIZE_PENDING=
BCP_FONT_SIZE_REQUESTED=
BCP_POINTER_ID=
BCP_DIR=
BCP_BUSY=0
BCP_STATUS="Connect to read the server"
BCP_LAST=0
BCP_NEXT=0
BCP_FAILURES=0
BCP_REFRESH_SECONDS=15
BCP_DIRTY=0
BCP_BASE_REV=-1
BCP_OPERATION=
BCP_HTTP_CODE=000
BCP_REPLY=
BCP_EDITKEY=
DAV_CODE=
declare -gA BCP_SNAPSHOT BCP_LIVE BCP_DRAFT BCP_HTTP
declare -gA BCP_DROP_KEY
declare -ga BCP_CHOICES
BCP_CHOICE_CURRENT=
json parse BCP_SNAPSHOT '{}'
json parse BCP_LIVE '{}'
json parse BCP_DRAFT '{}'

# Desktop settings use executable text and no secret permissions. Keep only
# the URL there; this data-only credential is scoped to that exact URL.
fn blit_cp_credentials(load = "1") {
    local dir=${XDG_CONFIG_HOME:-$HOME/.config}/hibr/blit file tmp mode
    local -A saved
    file=$dir/connection.json
    BCP_CREDENTIAL_STATUS=
    BCP_CONNECTION_READY=1
    BCP_CREDENTIAL_URL=$BCP_URL
    if [ "$load" = 1 ]; then
        BCP_TOKEN=
        [ -e "$file" ] || return 0
        if [ -L "$dir" ] || [ -L "$file" ] || [ ! -O "$dir" ] || [ ! -O "$file" ]; then
            BCP_CREDENTIAL_STATUS="Unsafe credential owner or symlink"; return 1
        fi
        mode := blit_cp_mode "$dir" || mode=
        if [ "${mode:0:10}" != drwx------ ]; then
            BCP_CREDENTIAL_STATUS="Credential permissions must be 0700/0600"; return 1
        fi
        mode := blit_cp_mode "$file" || mode=
        if [ "${mode:0:10}" != -rw------- ]; then
            BCP_CREDENTIAL_STATUS="Credential permissions must be 0700/0600"; return 1
        fi
        json parse saved < "$file" 2> /dev/null || { BCP_CREDENTIAL_STATUS="Invalid connection credential file"; return 1; }
        [ "${saved[url]}" != "$BCP_URL" ] || BCP_TOKEN=${saved[token]}
        return 0
    fi
    # Made under umask 077, so the folder is 0700 and the file 0600 with no
    # chmod; a folder that already exists with another mode is the one case
    # that needs one. The file is written new (noclobber) and moved over.
    (
        umask 077
        [ ! -L "$dir" ] && [ ! -L "$file" ] || exit 1
        mkdir -p "$dir" && [ -O "$dir" ] || exit 1
        mode := blit_cp_mode "$dir" || exit 1
        [ "${mode:0:10}" = drwx------ ] || command chmod 0700 "$dir" || exit 1
        tmp="$dir/.connection-$$-$RANDOM"
        json parse saved '{}'
        json set saved .url "$BCP_URL" -s
        json set saved .token "$BCP_TOKEN" -s
        set -C
        if json emit saved > "$tmp" && mv -f "$tmp" "$file"; then exit 0; fi
        rm -f "$tmp"
        exit 1
    ) || { BCP_CREDENTIAL_STATUS="Could not save API token"; return 1; }
    BCP_CREDENTIAL_STATUS="API token saved privately"
    return 0
}

# A file's mode as ls -l writes it (drwx------), from hibr's own ls module:
# in this process, and the same on Linux and macOS, where stat(1) is not.
fn blit_cp_mode(path) {
    local l
    need ls 2> /dev/null || return 1
    blit_cp_ready || return 1
    ls -ld "$path" > "$BCP_DIR/mode" 2> /dev/null || return 1
    read -r l _ < "$BCP_DIR/mode"
    ret "$l"
}
# cp_panes loads this bundle before dt_open calls dt_load. Read credentials
# on first use, after the saved URL exists, never against a guessed default.

fn blit_cp_ready() {
    [ -n "$BCP_DIR" ] && [ -d "$BCP_DIR" ] && return 0
    BCP_DIR=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/hibr-blit-$UID/$$
    ( umask 077; mkdir -p "$BCP_DIR" ) 2> /dev/null || return 1
}

# One request, through hibr's dav module: the token is a header on a
# builtin, so no command line ever holds it. HIBR_DAV_TIMEOUT bounds the
# connect and every read; the job that calls this sets it. The reply is in
# BCP_HTTP, its status in BCP_HTTP_CODE (000 when no server answered).
fn blit_cp_http(method, path, body = "", revision = "") {
    local -a o
    o=(-H "Content-Type: application/json")
    [ -z "$BCP_TOKEN" ] || o+=(-H "Authorization: Bearer $BCP_TOKEN")
    [ -z "$revision" ] || o+=(-H "If-Match: $revision")
    [ "$method" != POST ] || o+=(-H "Idempotency-Key: blit-panel-$$-$EPOCHREALTIME")
    [ -z "$body" ] || o+=(-d "$body")
    DAV_CODE=
    BCP_REPLY=
    BCP_INVALID=0
    json parse BCP_HTTP '{}'
    BCP_REPLY := dav request "${o[@]}" "$method" "$BCP_URL$path" 2> /dev/null || :
    # dav says 0 when no server answered at all, which is 000 here.
    case ${DAV_CODE:-0} in 0 | 000) BCP_HTTP_CODE=000; return 1 ;; esac
    BCP_HTTP_CODE=$DAV_CODE
    json parse BCP_HTTP "${BCP_REPLY:-"{}"}" 2> /dev/null || { BCP_INVALID=1; json parse BCP_HTTP '{}'; return 1; }
    case $BCP_HTTP_CODE in 2??) return 0 ;; *) return 1 ;; esac
}

# The job's own work, in the background: the requests an operation makes,
# and one JSON document on standard output for blit_cp_done --
# {"ok":..,"code":..,"invalid":..,"reply":{..}}.
fn blit_cp_work(what, method = "GET", path = "", body = "", revision = "") {
    local ok=0 raw
    local -A envelope reply
    export HIBR_DAV_TIMEOUT=6
    json parse reply '{}'
    if [ "$what" = refresh ]; then
        if blit_cp_http GET /v1/diagnostics/observation; then
            raw := json emit BCP_HTTP
            json parse 'reply[snapshot]' "$raw"
            if blit_cp_http GET /v1/auxiliary-displays; then
                raw := json emit BCP_HTTP
                json parse 'reply[auxiliary]' "$raw"
                ok=1
            fi
        fi
        if [ "$ok" = 0 ]; then raw := json emit BCP_HTTP; json parse reply "$raw"; fi
    else
        blit_cp_http "$method" "$path" "$body" "$revision" && ok=1
        raw := json emit BCP_HTTP
        json parse reply "$raw"
    fi
    json parse envelope '{}'
    json set envelope .ok "$ok"
    json set envelope .code "$BCP_HTTP_CODE" -s
    json set envelope .invalid "${BCP_INVALID:-0}"
    raw := json emit reply
    json parse 'envelope[reply]' "$raw"
    json emit envelope
}

fn blit_cp_schedule(failed = "0") {
    local seconds=$BCP_REFRESH_SECONDS i=1
    if [ "$failed" = 1 ]; then
        [ "$BCP_FAILURES" -ge 3 ] || BCP_FAILURES=$((BCP_FAILURES + 1))
        while [ "$i" -lt "$BCP_FAILURES" ]; do seconds=$((seconds * 2)); i=$((i + 1)); done
    else BCP_FAILURES=0; fi
    BCP_NEXT=$((EPOCHSECONDS + seconds))
}

fn blit_cp_start(what, method = "GET", path = "", body = "", revision = "", quiet = "0") {
    local n
    [ "$BCP_BUSY" = 0 ] || return 1
    # Schedule before validation too: a failed start must not retry per draw.
    BCP_NEXT=$((EPOCHSECONDS + BCP_REFRESH_SECONDS))
    if ! need dav 2> /dev/null; then BCP_STATUS="The dav module is required"; blit_cp_schedule 1; return 1; fi
    if ! command -v dt_job > /dev/null; then BCP_STATUS="Needs hibr 0.99.297 or later"; blit_cp_schedule 1; return 1; fi
    BCP_URL=${BCP_URL%/}
    if [ "$BCP_CONNECTION_READY" != 1 ] || [ "$BCP_CREDENTIAL_URL" != "$BCP_URL" ]; then
        blit_cp_credentials
    fi
    if ! match "$BCP_URL" '^https?://([A-Za-z0-9._-]+|\[[0-9A-Fa-f:]+\])(:[0-9]+)?$'; then
        BCP_STATUS="Use an http(s) server URL without a path"; blit_cp_schedule 1; return 1
    fi
    case "$BCP_TOKEN" in *[!a-zA-Z0-9._~+/=-]*) BCP_STATUS="Invalid bearer token characters"; blit_cp_schedule 1; return 1 ;; esac
    if ! n := dt_job blit "$what" blit_cp_done blit_cp_work "$what" "$method" "$path" "$body" "$revision"; then
        BCP_STATUS="Cannot create private job directory"; blit_cp_schedule 1; return 1
    fi
    BCP_BUSY=1
    BCP_OPERATION=$what
    [ "$quiet" = 1 ] || BCP_STATUS="Working: $what"
    command -v dt_want > /dev/null && dt_want 250
    return 0
}

# Finished work is handed on by the desktop's job runner after a frame; a
# caller with no desktop loop (a test) calls this to look now.
fn blit_cp_poll() {
    command -v dt_jobtick > /dev/null && dt_jobtick
    return 0
}

# A request has finished: what it read, into the pane.
fn blit_cp_done(int n, int st) {
    local ok code raw f
    local -A envelope reply
    BCP_BUSY=0
    BCP_LAST=$EPOCHSECONDS
    f := dt_jobfile "$n"
    if ! json parse envelope < "$f" 2> /dev/null; then
        blit_cp_schedule 1
        BCP_FONT_SIZE_PENDING=
        BCP_FONT_SIZE_REQUESTED=
        BCP_STATUS="HTTP 000: invalid JSON response"; return 0
    fi
    ok=${envelope[ok]}
    code=${envelope[code]:-000}
    raw := json get envelope .reply
    json parse reply "${raw:-"{}"}"
    if [ "${envelope[invalid]}" = 1 ]; then
        blit_cp_schedule 1
        BCP_FONT_SIZE_PENDING=
        BCP_FONT_SIZE_REQUESTED=
        BCP_STATUS="HTTP $code: invalid JSON response"; return 0
    fi
    if [ "$ok" != 1 ]; then
        BCP_FONT_SIZE_PENDING=
        BCP_FONT_SIZE_REQUESTED=
        blit_cp_schedule 1
        if [ "$code" = 000 ]; then BCP_STATUS="Offline or request timed out";
        else BCP_STATUS="HTTP $code: ${reply[code]:-${reply[title]:-request failed}}"; fi
        return 0
    fi
    blit_cp_schedule
    case $BCP_OPERATION in
    refresh)
        raw := json get reply .snapshot
        json parse BCP_SNAPSHOT "$raw"
        raw := json get reply .auxiliary
        json parse BCP_LIVE "$raw"
        if [ "$BCP_DIRTY" = 0 ]; then
            raw := json get BCP_SNAPSHOT .settings.document
            json parse BCP_DRAFT "$raw"
            BCP_BASE_REV=${BCP_SNAPSHOT[settings][revision]}
        fi
        BCP_STATUS="Connected: ${BCP_SNAPSHOT[version][server_version]}"
        if [ "$BCP_DIRTY" = 1 ] && [ "$BCP_BASE_REV" != "${BCP_SNAPSHOT[settings][revision]}" ]; then
            BCP_STATUS="Saved settings changed; reload before saving"
        fi
        ;;
    apply | retry)
        raw := json emit reply
        json parse BCP_LIVE "$raw"
        BCP_STATUS="Apply accepted; inspect auxiliary state"
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    save)
        raw := json emit reply
        json parse 'BCP_SNAPSHOT[settings]' "$raw"
        raw := json get reply .document
        json parse BCP_DRAFT "$raw"
        BCP_BASE_REV=${reply[revision]}
        BCP_DIRTY=0
        BCP_STATUS="Save: ${reply[storage][state]} (revision ${reply[storage][saved_revision]})"
        ;;
    font)
        BCP_FONT_SIZE_REQUESTED=
        raw := json emit reply
        json parse 'BCP_SNAPSHOT[fonts]' "$raw"
        # Update only the font in the shared draft. Never rebase unrelated edits.
        local -A font_draft
        json parse font_draft '{}'
        json set font_draft .font_id "${reply[active][id]}" -s
        if [ "${reply[active][sizing]}" = pixels ]; then
            json set font_draft .size_px "${reply[active][size_px]}"
        else
            json set font_draft .scale "${reply[active][scale]}"
        fi
        raw := json emit font_draft
        json parse 'BCP_DRAFT[font]' "$raw"
        BCP_STATUS="Font applied; settings save queued"
        BCP_LAST=0
        BCP_NEXT=0
        ;;
    esac
    if [ -n "$BCP_FONT_SIZE_PENDING" ]; then
        local wanted=$BCP_FONT_SIZE_PENDING
        BCP_FONT_SIZE_PENDING=
        blit_slide 0 font_size "$wanted"
    fi
    return 0
}

fn blit_cp_auxiliary_json() {
    local raw
    raw := json get BCP_DRAFT .auxiliary_displays 2> /dev/null || raw='[]'
    [ -n "$raw" ] && [ "$raw" != null ] || raw='[]'
    ret "$raw"
}

fn blit_cp_toggle(output, ordinal) {
    local i=0 raw n=0 found=0
    local -A old fresh
    raw := blit_cp_auxiliary_json
    json parse old "$raw"
    json parse fresh '[]'
    while [ -n "${old[$i][output]}" ]; do
        if [ "${old[$i][output]}" = "$output" ] && [ "${old[$i][pane_ordinal]}" = "$ordinal" ]; then
            found=1
        else
            raw := json get old ".[$i]"
            json parse "fresh[$n]" "$raw"
            n=$((n + 1))
        fi
        i=$((i + 1))
    done
    if [ "$found" = 0 ]; then
        json set fresh ".[$n].output" "$output" -s
        json set fresh ".[$n].pane_ordinal" "$ordinal"
    fi
    raw := json emit fresh
    json parse 'BCP_DRAFT[auxiliary_displays]' "$raw"
    BCP_DIRTY=1
}

fn blit_cp_row(int w, int n, kind, text, value = "", key = "", wtype = "") {
    CP[$w][$n][kind]=$kind; CP[$w][$n][text]=$text
    CP[$w][$n][val]=$value; CP[$w][$n][key]=$key; CP[$w][$n][wtype]=$wtype
}

fn blit_cp_tick(int w) {
    local left
    # Hibr asks every pane for scratch rows during search; that is not a
    # visible pane and must not start I/O or wake the desktop.
    if [ "$w" != 999999 ]; then
        blit_cp_poll
        if [ "$BCP_BUSY" = 0 ] && [ "$EPOCHSECONDS" -ge "$BCP_NEXT" ]; then
            blit_cp_start refresh GET "" "" "" 1
        fi
        if [ "$BCP_BUSY" = 1 ]; then left=250;
        else
            left=$(((BCP_NEXT - EPOCHSECONDS) * 1000))
            [ "$left" -gt 0 ] || left=1000
        fi
        command -v dt_want > /dev/null && dt_want "$left"
    fi
    return 0
}

fn blit_rows(int w) {
    local n=0 i=0 j output ordinal pane on state raw left
    local -A desired
    blit_cp_tick "$w"
    blit_cp_row "$w" "$n" head Connection; n=$((n + 1))
    blit_cp_row "$w" "$n" action Server "$BCP_URL" url; n=$((n + 1))
    state=unset; [ -n "$BCP_TOKEN" ] && state=set
    blit_cp_row "$w" "$n" action "API Token (remembered)" "$state" token; n=$((n + 1))
    if [ -n "$BCP_CREDENTIAL_STATUS" ]; then
        blit_cp_row "$w" "$n" info "$BCP_CREDENTIAL_STATUS"; n=$((n + 1))
    fi
    blit_cp_row "$w" "$n" info "$BCP_STATUS"; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Reload (discard draft)" "" reload; n=$((n + 1))
    [ "$BCP_BASE_REV" -ge 0 ] || { ret "$n"; return 0; }
    blit_cp_row "$w" "$n" head "Per-display grid (Save applies)"; n=$((n + 1))
    i=0
    if [ -z "${BCP_SNAPSHOT[topology][outputs][0][layout][columns]}" ]; then
        blit_cp_row "$w" "$n" info "Independent grids require Blit 0.1.545"; n=$((n + 1))
    fi
    while [ -n "${BCP_SNAPSHOT[topology][outputs][0][layout][columns]}" ] &&
          [ -n "${BCP_SNAPSHOT[displays][displays][$i][id]}" ]; do
        output=${BCP_SNAPSHOT[displays][displays][$i][state][connector]:-${BCP_SNAPSHOT[displays][displays][$i][name]}}
        blit_cp_row "$w" "$n" info "$output"; n=$((n + 1))
        blit_cp_row "$w" "$n" set Columns "${BCP_DRAFT[display_layouts][$output][columns]:-1}" "columns:$output" slider
        CP[$w][$n][after]="(${BCP_DRAFT[display_layouts][$output][columns]:-1})"
        CP[$w][$n][min]=1; CP[$w][$n][max]=8; n=$((n + 1))
        blit_cp_row "$w" "$n" set Rows "${BCP_DRAFT[display_layouts][$output][rows]:-1}" "rows:$output" slider
        CP[$w][$n][after]="(${BCP_DRAFT[display_layouts][$output][rows]:-1})"
        CP[$w][$n][min]=1; CP[$w][$n][max]=8; n=$((n + 1)); i=$((i + 1))
    done
    blit_cp_row "$w" "$n" head "Startup Login (save, then restart)"; n=$((n + 1))
    on=off; [ "${BCP_DRAFT[login][enabled]:-true}" = true ] && on=on
    blit_cp_row "$w" "$n" set "Login enabled" "$on" enabled bool; n=$((n + 1))
    blit_cp_row "$w" "$n" set "Preferred primary pane" "${BCP_DRAFT[login][preferred_pane_id]:-auto}" primary; n=$((n + 1))
    blit_cp_row "$w" "$n" set Fallback "${BCP_DRAFT[login][fallback]:-first_available}" fallback; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Native desktop" "${BCP_SNAPSHOT[login][desktop][state]}"; n=$((n + 1))
    blit_cp_row "$w" "$n" head "Auxiliary panes (staged)"; n=$((n + 1))
    raw := blit_cp_auxiliary_json; json parse desired "$raw"
    while [ -n "${BCP_SNAPSHOT[topology][panes][$i][id]}" ]; do
        pane=${BCP_SNAPSHOT[topology][panes][$i][id]}
        ordinal=${pane##*-}
        output=
        j=0
        while [ -n "${BCP_SNAPSHOT[displays][displays][$j][id]}" ]; do
            if [ "${BCP_SNAPSHOT[displays][displays][$j][id]}" = "${BCP_SNAPSHOT[topology][panes][$i][display_id]}" ]; then
                output=${BCP_SNAPSHOT[displays][displays][$j][state][connector]:-${BCP_SNAPSHOT[displays][displays][$j][name]}}
                break
            fi
            j=$((j + 1))
        done
        on=off; j=0
        while [ -n "${desired[$j][output]}" ]; do
            [ "${desired[$j][output]}" = "$output" ] && [ "${desired[$j][pane_ordinal]}" = "$ordinal" ] && on=on
            j=$((j + 1))
        done
        blit_cp_row "$w" "$n" set "$output pane $ordinal (${BCP_SNAPSHOT[topology][panes][$i][bounds][width]}x${BCP_SNAPSHOT[topology][panes][$i][bounds][height]})" "$on" "aux:$output:$ordinal" bool
        n=$((n + 1)); i=$((i + 1))
    done
    blit_cp_row "$w" "$n" action "Apply auxiliaries now" "" apply; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Retry stopped auxiliaries" "" retry; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Save as Default" "rev $BCP_BASE_REV" save; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Storage" "${BCP_SNAPSHOT[settings][storage][state]}"; n=$((n + 1))
    blit_cp_row "$w" "$n" head "Live auxiliary status"; n=$((n + 1))
    i=0
    while [ -n "${BCP_LIVE[bindings][$i][output]}" ]; do
        blit_cp_row "$w" "$n" info "${BCP_LIVE[bindings][$i][output]}/${BCP_LIVE[bindings][$i][pane_ordinal]}: ${BCP_LIVE[bindings][$i][state]}" "${BCP_LIVE[bindings][$i][reason]}"
        n=$((n + 1)); i=$((i + 1))
    done
    blit_cp_row "$w" "$n" head "Font (live with automatic save)"; n=$((n + 1))
    blit_cp_row "$w" "$n" set Font "${BCP_SNAPSHOT[fonts][active][id]}" font; n=$((n + 1))
    local size=${BCP_SNAPSHOT[fonts][active][size_px]}
    if [ -n "$size" ] && [ "$size" != null ]; then
        [ -z "$BCP_FONT_SIZE_PENDING" ] || size=$BCP_FONT_SIZE_PENDING
        blit_cp_row "$w" "$n" set "Font size" "$size" font_size slider
        CP[$w][$n][min]=8; CP[$w][$n][max]=64; CP[$w][$n][after]="($size px)"
    else
        blit_cp_row "$w" "$n" info "Font size" "Requires Blit 0.1.561+"
    fi
    n=$((n + 1))
    blit_cp_row "$w" "$n" head Diagnostics; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Measured frame rate" "${BCP_SNAPSHOT[runtime][performance][frame_rate_hz]} Hz"; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Last render" "${BCP_SNAPSHOT[runtime][performance][last_render_ms]} ms"; n=$((n + 1))
    blit_cp_row "$w" "$n" head "Presentation (API settings own intent)"; n=$((n + 1))
    local backend=${BCP_SNAPSHOT[settings][effective][display_backend_active]}
    [ -n "$backend" ] || backend=${BCP_SNAPSHOT[server][display_backend][name]}
    blit_cp_row "$w" "$n" info "Active backend" "$backend"; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Requested backend" "${BCP_SNAPSHOT[settings][effective][display_backend_requested]}"; n=$((n + 1))
    local source=${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_source]:-"Not reported by server"}
    blit_cp_row "$w" "$n" info "Backend source" "$source"; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Active renderer" "${BCP_SNAPSHOT[settings][effective][renderer_active]}"; n=$((n + 1))
    local driver=${BCP_SNAPSHOT[settings][effective][presentation_configuration][video_driver_active]}
    [ -n "$driver" ] || driver=${BCP_SNAPSHOT[diagnostics][render][video_driver]:-"Not reported by server"}
    [ "$backend" != drm-kms ] || driver=not-applicable
    blit_cp_row "$w" "$n" info "SDL video driver" "$driver"; n=$((n + 1))
    local startup="Not reported by server"
    if [ "${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment_valid]}" = false ]; then
        startup="Invalid; display disabled"
        [ "${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment_overridden]}" != true ] || startup="Invalid; saved settings win"
    elif [ "${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment_valid]}" = true ]; then
        startup=${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment]}
        [ -n "$startup" ] && [ "$startup" != null ] || startup=unset
        [ "${BCP_SNAPSHOT[settings][effective][presentation_configuration][backend_environment_overridden]}" != true ] || startup="$startup (fallback only)"
    fi
    blit_cp_row "$w" "$n" info "Startup default" "$startup"; n=$((n + 1))
    blit_cp_row "$w" "$n" info "Restart required" "${BCP_SNAPSHOT[settings][effective][presentation_restart_required]}"; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Export staged configuration" "" export; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Import configuration (stage only)" "" import; n=$((n + 1))
    ret "$n"
}

# One choice source and selection path for native popups and keyboard stepping.
fn blit_cp_choices(key) {
    local i=0 raw
    local -A cfg
    BCP_CHOICES=(); BCP_CHOICE_CURRENT=
    case $key in
    primary)
        BCP_CHOICES=(auto)
        while [ -n "${BCP_SNAPSHOT[topology][panes][$i][id]}" ]; do
            BCP_CHOICES+=("${BCP_SNAPSHOT[topology][panes][$i][id]}"); i=$((i + 1))
        done
        BCP_CHOICE_CURRENT=${BCP_DRAFT[login][preferred_pane_id]:-auto}
        [ "$BCP_CHOICE_CURRENT" != null ] || BCP_CHOICE_CURRENT=auto ;;
    fallback) BCP_CHOICES=(first_available wait); BCP_CHOICE_CURRENT=${BCP_DRAFT[login][fallback]:-first_available} ;;
    font)
        while [ -n "${BCP_SNAPSHOT[fonts][profiles][$i][id]}" ]; do
            [ "${BCP_SNAPSHOT[fonts][profiles][$i][available]}" != true ] || BCP_CHOICES+=("${BCP_SNAPSHOT[fonts][profiles][$i][id]}")
            i=$((i + 1))
        done
        BCP_CHOICE_CURRENT=${BCP_SNAPSHOT[fonts][active][id]} ;;
    shape) BCP_CHOICES=(arrow hand precision); BCP_CHOICE_CURRENT=${BCP_DRAFT[pointer][shape]:-arrow} ;;
    palette) BCP_CHOICES=(pearl obsidian neon amber); BCP_CHOICE_CURRENT=${BCP_DRAFT[pointer][palette]:-pearl} ;;
    device)
        i := blit_mouse_index
        i=0
        while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" ]; do
            if blit_mouse_is_pointer "$i"; then BCP_CHOICES+=("${BCP_SNAPSHOT[input_devices][devices][$i][id]}"); fi
            i=$((i + 1))
        done
        BCP_CHOICE_CURRENT=$BCP_POINTER_ID ;;
    acceleration)
        i := blit_mouse_index; [ "$i" -ge 0 ] || return 0
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"; fi
        json parse cfg "$raw"
        BCP_CHOICES=(flat adaptive); BCP_CHOICE_CURRENT=${cfg[acceleration][profile]:-flat} ;;
    esac
    return 0
}

fn blit_cp_choose(key, value) {
    local option valid=0 body
    local -A payload
    # Only a choice that sends a request waits for the one in flight; the
    # rest change the staged draft, which a background refresh leaves alone
    # once it has been edited. Refusing them all while a quiet refresh ran
    # dropped a click on a dropdown for as long as the refresh took.
    [ "$BCP_BUSY" = 0 ] || [ "$key" != font ] || return 0
    blit_cp_choices "$key"
    for option in "${BCP_CHOICES[@]}"; do [ "$option" != "$value" ] || valid=1; done
    [ "$valid" = 1 ] || return 0
    case $key in
    primary)
        if [ "$value" = auto ]; then json set BCP_DRAFT .login.preferred_pane_id null;
        else json set BCP_DRAFT .login.preferred_pane_id "$value" -s; fi
        BCP_DIRTY=1 ;;
    fallback) json set BCP_DRAFT .login.fallback "$value" -s; BCP_DIRTY=1 ;;
    font)
        json parse payload '{}'; json set payload .font_id "$value" -s
        body := json emit payload; blit_cp_start font PUT /v1/fonts "$body" ;;
    shape | palette) json set BCP_DRAFT ".pointer.$key" "$value" -s; BCP_DIRTY=1 ;;
    device) BCP_POINTER_ID=$value ;;
    acceleration) option=0; [ "$value" != adaptive ] || option=1; blit_mouse_slide 0 acceleration "$option" ;;
    esac
    return 0
}

fn blit_cp_selected(int w, value) {
    blit_cp_choose "${BCP_DROP_KEY[$w]}" "$value"
}
fn blit_drop(int w, int r, int c, key) {
    [ "$BCP_BUSY" = 0 ] || [ "$key" != font ] || return 0
    blit_cp_choices "$key"
    [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
    BCP_DROP_KEY[$w]=$key
    dt_droplist "$w" "$r" "$c" blit_cp_selected "${BCP_CHOICES[@]}"
}
fn blit_mouse_drop(int w, int r, int c, key) {
    blit_drop "$w" "$r" "$c" "$key"
}

fn blit_do(int w, key, int dir) {
    local raw body pane=auto i=0 value tenths output ordinal
    local -A payload
    # What sends a request waits for the one in flight (blit_cp_start
    # refuses a second anyway); what only edits the draft never waits.
    case $key in reload | apply | retry | save) [ "$BCP_BUSY" = 0 ] || return 0 ;; esac
    case $key in
    url | token) blit_cp_edit "$key"; return 0 ;;
    reload) BCP_CONNECTION_READY=0; BCP_DIRTY=0; BCP_BASE_REV=-1; blit_cp_start refresh; return 0 ;;
    enabled)
        value=true; [ "${BCP_DRAFT[login][enabled]:-true}" = true ] && value=false
        json set BCP_DRAFT .login.enabled "$value"; BCP_DIRTY=1 ;;
    primary | fallback | font)
        blit_cp_choices "$key"
        [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
        value := cp_next "$BCP_CHOICE_CURRENT" "$dir" "${BCP_CHOICES[@]}"
        blit_cp_choose "$key" "$value" ;;
    aux:*) output=${key#aux:}; ordinal=${output##*:}; output=${output%:*}; blit_cp_toggle "$output" "$ordinal" ;;
    apply | retry)
        raw := blit_cp_auxiliary_json
        json parse payload '{}'; json parse 'payload[bindings]' "$raw"
        [ "$key" != retry ] || json set payload .retry_stopped true
        body := json emit payload
        blit_cp_start "$key" POST /v1/auxiliary-displays/apply "$body" "${BCP_LIVE[revision]}" ;;
    save)
        raw := json emit BCP_DRAFT
        json parse payload '{}'; json parse 'payload[document]' "$raw"
        body := json emit payload
        blit_cp_start save PUT /v1/settings "$body" "$BCP_BASE_REV" ;;
    font_size)
        value=${BCP_FONT_SIZE_PENDING:-${BCP_FONT_SIZE_REQUESTED:-${BCP_SNAPSHOT[fonts][active][size_px]}}}
        [ -n "$value" ] && [ "$value" != null ] || return 0
        blit_slide "$w" font_size "$((value + dir))" ;;
    columns:* | rows:*)
        output=${key#*:}; value=${key%%:*}
        tenths=$(( ${BCP_DRAFT[display_layouts][$output][$value]:-1} + dir ))
        blit_slide "$w" "$key" "$tenths" ;;
    export) dt_filepick save "Export Blit Configuration" "JSON:*.json" "$HOME" blit.json blit_cp_exported "" ;;
    import) dt_filepick open "Import Blit Configuration" "JSON:*.json" "$HOME" "" blit_cp_imported "" ;;
    esac
    return 0
}

fn blit_slide(int w, key, int value) {
    local body output field
    local -A payload grid
    case $key in
    font_size)
        [ -n "${BCP_SNAPSHOT[fonts][active][size_px]}" ] && [ "${BCP_SNAPSHOT[fonts][active][size_px]}" != null ] || return 0
        [ "$value" -ge 8 ] && [ "$value" -le 64 ] || return 0
        if [ "$BCP_BUSY" = 1 ]; then BCP_FONT_SIZE_PENDING=$value; return 0; fi
        BCP_FONT_SIZE_REQUESTED=$value
        json parse payload '{}'
        json set payload .size_px "$value"
        body := json emit payload
        blit_cp_start font PUT /v1/fonts "$body" ;;
    columns:* | rows:*)
        [ -n "${BCP_SNAPSHOT[topology][outputs][0][layout][columns]}" ] || {
            BCP_STATUS="Independent grids require Blit 0.1.545"; return 0
        }
        [ "$value" -ge 1 ] && [ "$value" -le 8 ] || return 0
        output=${key#*:}; field=${key%%:*}
        json parse grid '{}'
        json set grid .columns "${BCP_DRAFT[display_layouts][$output][columns]:-1}"
        json set grid .rows "${BCP_DRAFT[display_layouts][$output][rows]:-1}"
        json set grid ".$field" "$value"
        body := json emit grid
        json parse "BCP_DRAFT[display_layouts][$output]" "$body"
        BCP_DIRTY=1 ;;
    esac
    return 0
}

# A second native pane in the same bundle, sharing the existing connection,
# worker, snapshot and revision-protected settings draft. Hibr's own Mouse
# pane continues to own window-manager behaviour, not physical Blit devices.
fn blit_mouse_is_pointer(int i) {
    local j=0
    [ "${BCP_SNAPSHOT[input_devices][devices][$i][state][present]}" = true ] || return 1
    while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][kinds][$j]}" ]; do
        [ "${BCP_SNAPSHOT[input_devices][devices][$i][kinds][$j]}" != pointer ] || return 0
        j=$((j + 1))
    done
    return 1
}
fn blit_mouse_index() {
    local i=0 first=-1
    while [ -n "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" ]; do
        if blit_mouse_is_pointer "$i"; then
            [ "$first" -ge 0 ] || first=$i
            [ "${BCP_SNAPSHOT[input_devices][devices][$i][id]}" != "$BCP_POINTER_ID" ] || { ret "$i"; return 0; }
        fi
        i=$((i + 1))
    done
    [ "$first" -lt 0 ] || BCP_POINTER_ID=${BCP_SNAPSHOT[input_devices][devices][$first][id]}
    ret "$first"
}

fn blit_mouse_rows(int w) {
    local n=0 i value raw
    local -A cfg
    blit_cp_tick "$w"
    blit_cp_row "$w" "$n" head "Blit pointer and devices"; n=$((n + 1))
    blit_cp_row "$w" "$n" action Server "$BCP_URL" url; n=$((n + 1))
    blit_cp_row "$w" "$n" action "API Token (remembered)" "" token; n=$((n + 1))
    blit_cp_row "$w" "$n" info "$BCP_STATUS"; n=$((n + 1))
    blit_cp_row "$w" "$n" action "Reload (discard draft)" "" reload; n=$((n + 1))
    [ "$BCP_BASE_REV" -ge 0 ] || { ret "$n"; return 0; }
    if [ -z "${BCP_SNAPSHOT[settings][effective][pointer][shape]}" ]; then
        blit_cp_row "$w" "$n" info "Pointer appearance requires Blit 0.1.549"; n=$((n + 1))
    else
        blit_cp_row "$w" "$n" head "Appearance (staged until Save)"; n=$((n + 1))
        blit_cp_row "$w" "$n" set Shape "${BCP_DRAFT[pointer][shape]:-arrow}" shape; n=$((n + 1))
        blit_cp_row "$w" "$n" set Palette "${BCP_DRAFT[pointer][palette]:-pearl}" palette; n=$((n + 1))
        value=${BCP_DRAFT[pointer][size_px]:-24}
        blit_cp_row "$w" "$n" set "Pointer Size" "$value" size slider
        CP[$w][$n][min]=24; CP[$w][$n][max]=64; CP[$w][$n][after]="($value px)"; n=$((n + 1))
        value=on; [ "${BCP_DRAFT[pointer][shadow]:-true}" != false ] || value=off
        blit_cp_row "$w" "$n" set Shadow "$value" shadow bool; n=$((n + 1))
        blit_cp_row "$w" "$n" info "Pointer size is independent of font scale"; n=$((n + 1))
    fi
    blit_cp_row "$w" "$n" head "Physical pointer (staged until Save)"; n=$((n + 1))
    i := blit_mouse_index
    if [ "$i" -lt 0 ]; then
        blit_cp_row "$w" "$n" info "No present pointer device"; n=$((n + 1))
    else
        blit_cp_row "$w" "$n" set Device "${BCP_SNAPSHOT[input_devices][devices][$i][name]}" device; n=$((n + 1))
        blit_cp_row "$w" "$n" info "$BCP_POINTER_ID"; n=$((n + 1))
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then
            raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"
        fi
        json parse cfg "$raw"
        value=${cfg[sensitivity_percent]:-100}
        blit_cp_row "$w" "$n" set Sensitivity "$value" sensitivity slider
        CP[$w][$n][min]=10; CP[$w][$n][max]=1000; CP[$w][$n][after]="($value%)"; n=$((n + 1))
        blit_cp_row "$w" "$n" set Acceleration "${cfg[acceleration][profile]:-flat}" acceleration; n=$((n + 1))
        value=off; [ "${cfg[natural_scroll]:-false}" != true ] || value=on
        blit_cp_row "$w" "$n" set "Natural Scroll" "$value" natural bool; n=$((n + 1))
        if [ -n "${cfg[tap_to_click]+x}" ]; then
            value=off; [ "${cfg[tap_to_click]}" != true ] || value=on
            blit_cp_row "$w" "$n" set "Tap to Click" "$value" tap bool; n=$((n + 1))
        fi
        value=${cfg[scroll_step]:-1}
        blit_cp_row "$w" "$n" set "Device Wheel Step" "$value" wheel slider
        CP[$w][$n][min]=1; CP[$w][$n][max]=10; CP[$w][$n][after]="($value)"; n=$((n + 1))
    fi
    blit_cp_row "$w" "$n" action "Save all staged Blit settings" "rev $BCP_BASE_REV" save; n=$((n + 1))
    blit_cp_row "$w" "$n" info Storage "${BCP_SNAPSHOT[settings][storage][state]}"; n=$((n + 1))
    ret "$n"
}

fn blit_mouse_slide(int w, key, int value) {
    local i raw field flag
    local -A cfg
    if [ "$key" = size ]; then
        [ -n "${BCP_SNAPSHOT[settings][effective][pointer][shape]}" ] || return 0
        [ "$value" -ge 24 ] && [ "$value" -le 64 ] || return 0
        json set BCP_DRAFT .pointer.size_px "$value"
    else
        i := blit_mouse_index; [ "$i" -ge 0 ] || return 0
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"; fi
        json parse cfg "$raw"
        case $key in
        sensitivity) [ "$value" -ge 10 ] && [ "$value" -le 1000 ] || return 0; json set cfg .sensitivity_percent "$value" ;;
        wheel) [ "$value" -ge 1 ] && [ "$value" -le 10 ] || return 0; json set cfg .scroll_step "$value" ;;
        natural) flag=false; [ "$value" != 1 ] || flag=true; json set cfg .natural_scroll "$flag" ;;
        tap) [ -n "${cfg[tap_to_click]+x}" ] || return 0
            flag=false; [ "$value" != 1 ] || flag=true; json set cfg .tap_to_click "$flag" ;;
        acceleration) field=flat; [ "$value" != 1 ] || field=adaptive; json set cfg .acceleration.profile "$field" -s ;;
        *) return 0 ;;
        esac
        raw := json emit cfg
        json parse "BCP_DRAFT[input_devices][$BCP_POINTER_ID]" "$raw"
    fi
    BCP_DIRTY=1
    return 0
}

fn blit_mouse_do(int w, key, int dir) {
    local value raw i
    case $key in
    shape | palette | device | acceleration)
        blit_cp_choices "$key"
        [ "${#BCP_CHOICES[@]}" -gt 0 ] || return 0
        value := cp_next "$BCP_CHOICE_CURRENT" "$dir" "${BCP_CHOICES[@]}"
        blit_cp_choose "$key" "$value" ;;
    shadow) value=true; [ "${BCP_DRAFT[pointer][shadow]:-true}" != true ] || value=false
        json set BCP_DRAFT .pointer.shadow "$value"; BCP_DIRTY=1 ;;
    size) blit_mouse_slide "$w" size "$(( ${BCP_DRAFT[pointer][size_px]:-24} + dir ))" ;;
    sensitivity | wheel | natural | tap)
        i := blit_mouse_index; [ "$i" -ge 0 ] || return 0
        raw := json get BCP_DRAFT ".input_devices[$BCP_POINTER_ID]" 2> /dev/null || raw=null
        if [ "$raw" = null ] || [ -z "$raw" ]; then raw := json get BCP_SNAPSHOT ".input_devices.devices[$i].configuration"; fi
        local -A cfg; json parse cfg "$raw"
        case $key in
        sensitivity) value=$(( ${cfg[sensitivity_percent]:-100} + dir * 5 )) ;;
        wheel) value=$(( ${cfg[scroll_step]:-1} + dir )) ;;
        natural) value=1; [ "${cfg[natural_scroll]:-false}" != true ] || value=0 ;;
        tap) value=1; [ "${cfg[tap_to_click]:-false}" != true ] || value=0 ;;
        esac
        blit_mouse_slide "$w" "$key" "$value" ;;
    *) blit_do "$w" "$key" "$dir" ;;
    esac
    return 0
}

fn blit_cp_exported(path, context = "") {
    [ -n "$path" ] || return 0
    umask 077
    if json emit BCP_DRAFT -p > "$path"; then BCP_STATUS="Exported configuration (no connection secrets)";
    else BCP_STATUS="Export failed"; fi
}
fn blit_cp_imported(path, context = "") {
    local -A doc
    [ -n "$path" ] || return 0
    if ! json parse doc < "$path" 2> /dev/null || [ "${doc[version]}" != 1 ]; then
        BCP_STATUS="Import needs a version 1 Blit settings document"; return 0
    fi
    local raw
    raw := json emit doc; json parse BCP_DRAFT "$raw"
    BCP_DIRTY=1
    BCP_STATUS="Imported draft; Apply auxiliaries or Save as Default"
}

# The server's address and the token are each the desktop's one-line
# question (dt_ask); the token's field is masked.
fn blit_cp_edit(key) {
    BCP_EDITKEY=$key
    if [ "$key" = token ]; then
        dt_ask "Blit Connection" "API Token:" "$BCP_TOKEN" blit_cp_answer \
            "Kept privately for this server; never exported." 1 64
    else
        dt_ask "Blit Connection" "Server:" "$BCP_URL" blit_cp_answer \
            "An http(s) address and port, without a path." "" 64
    fi
}

# What was typed: the token kept, or the server changed. Refused, the
# question stays open.
fn blit_cp_answer(value, int id) {
    [ "$BCP_BUSY" = 0 ] || return 1
    if [ "$BCP_EDITKEY" = token ]; then
        case "$value" in *[!a-zA-Z0-9._~+/=-]*) BCP_CREDENTIAL_STATUS="Invalid bearer token characters"; return 1 ;; esac
        BCP_TOKEN=$value
        blit_cp_credentials 0 || return 1
    else
        BCP_URL=${value%/}; BCP_DIRTY=0; BCP_BASE_REV=-1
        blit_cp_credentials
        json parse BCP_SNAPSHOT '{}'; json parse BCP_DRAFT '{}'; json parse BCP_LIVE '{}'
    fi
    command -v cp_save > /dev/null && cp_save
    BCP_LAST=0
    blit_cp_start refresh
    return 0
}
