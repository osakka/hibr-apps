#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# wiretap -- the Control Panel pane for wiretap, the network monitor: whether the engine is up, what it can see, what the
# machine is sending and receiving, and who is talking. It is also the node reader: the Tap (menubar/wiretap.hibr) and the
# Control Strip module call wtp_poll / wtp_get / wtp_series from here, so the desktop asks the node once a second however many
# faces are showing (docs/adr/0005-the-pane-owns-the-node-reader.md). Read-only: it never starts a firewall or asks for privilege.

strict

app wiretap "The Control Panel pane for wiretap: see every byte" 0.5.1
# modules: wiretap
# needs: cli/wiretap

# Whether the menu bar item (menubar/wiretap.hibr, in the same bundle) is shown.
DT_WTBAR="${DT_WTBAR-1}"; DT_WTGAUGE="${DT_WTGAUGE-0}"; DT_WTRATE="${DT_WTRATE-0}"
command -v dt_keep > /dev/null && { dt_keep DT_WTBAR; dt_keep DT_WTGAUGE; dt_keep DT_WTRATE; }

# --- one colour per program (ADR 0019) ----------------------------------------------------------------------------------------------------
# A categorical palette in a fixed order: the first program seen gets the first hue, the next the next, after eight they repeat. A colour follows
# the program for as long as the desktop runs, not its rank in the list. The eight hues are the validated default of the dataviz method (adjacent
# colour-blind distance >= 8, normal-vision >= 15, in both modes); the light column is for a light desktop face, the dark for a dark one. The buckets in
# brackets ((unattributed), (root), (user N), (other)) never get a hue: they are DIM, so they cannot be mistaken for a program.
# A mark carries identity and the name beside it is text in the ordinary ink; the palette is not used for words.
declare -ga WTP_PALL=("#2a78d6" "#eb6834" "#1baf7a" "#eda100" "#e87ba4" "#008300" "#6250d6" "#e34948")
declare -ga WTP_PALD=("#3987e5" "#d95926" "#199e70" "#c98500" "#d55181" "#008300" "#9085e9" "#e66767")
declare -gA WTP_HUE
declare -gi WTP_HUEN=0 WTP_DARK=-1

# Is the desktop's face dark? From its own colour (#rrggbb); anything else is taken as dark.
fn wtp_isdark() {
	local f=${DT_FACE-} r g b

	if [ "$WTP_DARK" -lt 0 ]; then
		WTP_DARK=1
		if [ "${#f}" = 7 ] && [ "${f:0:1}" = "#" ]; then
			r=$((16#${f:1:2})); g=$((16#${f:3:2})); b=$((16#${f:5:2}))
			[ $(((299 * r + 587 * g + 114 * b) / 1000)) -ge 128 ] && WTP_DARK=0
		fi
	fi
	[ "$WTP_DARK" = 1 ]
}

# The colour for a program name.
fn wtp_hue(name) {
	local slot

	case $name in "" | "("*) ret "${DT_DIM-#888888}"; return 0 ;; esac
	if [ -z "${WTP_HUE["$name"]-}" ]; then
		WTP_HUE["$name"]=$((WTP_HUEN % 8 + 1))
		WTP_HUEN=$((WTP_HUEN + 1))
	fi
	slot=$((WTP_HUE["$name"] - 1))
	if wtp_isdark; then ret "${WTP_PALD[$slot]}"; else ret "${WTP_PALL[$slot]}"; fi
}

# The tap, Blit's colour badge of two cells (ids wiretap-left/-right for a node that answers, wiretap-off-left/-right for none; Blit 0.3.52, ADR 0013).
# Named by id, never by code point: dt_bg looks the id up in Blit's own catalogue and leaves the name alone where this Blit has no such id, and
# the badge is only in force under the Blit glyph set. Under Blit with no such id (an older Blit) it prints "" and the caller keeps what it had; the
# unicode and nerd sets get 🚰 and ascii gets "T" (Blit's own suggestion).
# The busiest programs' last 60 seconds, for the colour ribbon (ADR 0020): WTP_ASN the names, WTP_ASRX / WTP_ASTX the bytes, program j's
# second i at index j*60+i (oldest second first). At most once a second; WTP_ASCNT is how many programs there are.
declare -ga WTP_ASN=() WTP_ASRX=() WTP_ASTX=()
declare -gi WTP_ASCNT=0 WTP_ASAT=-100
fn wtp_appseries() {
	local r j i name v AS

	[ "$WTP_UP" = 1 ] || { WTP_ASCNT=0; return 1; }
	[ $((SECONDS - WTP_ASAT)) -ge 1 ] || return 0
	WTP_ASAT=$SECONDS
	WTP_ASN=(); WTP_ASRX=(); WTP_ASTX=(); WTP_ASCNT=0
	r := wt appseries 8 2> /dev/null || return 1
	json parse AS "$r" 2> /dev/null || return 1
	for ((j = 0; j < 8; j++)); do
		name := json get AS ".apps[$j].name" 2> /dev/null || break
		WTP_ASN+=("$name")
		for ((i = 0; i < 60; i++)); do
			v := json get AS ".apps[$j].rx[$i]"; WTP_ASRX+=("${v:-0}")
			v := json get AS ".apps[$j].tx[$i]"; WTP_ASTX+=("${v:-0}")
		done
	done
	WTP_ASCNT=${#WTP_ASN[@]}
	return 0
}

# The remote addresses (ADR 0016), asked for at most every two seconds: WTP_H holds the reply.
declare -g WTP_H="" WTP_HAT=-100
fn wtp_hosts() {
	local h

	[ "$WTP_UP" = 1 ] || return 1
	[ $((SECONDS - WTP_HAT)) -ge 2 ] || return 0
	WTP_HAT=$SECONDS
	if h := wt hosts 200 2> /dev/null; then json parse WTP_H "$h" 2> /dev/null || WTP_H=""; fi
	return 0
}

declare -g WTP_LOGOREAD=0
fn wtp_logo(state = on, int cells = 2) {
	local g=

	if [ "$WTP_LOGOREAD" = 0 ] && [ "${DT_GLYPHSET-}" = blit ] && dt_has dt_bg; then
		WTP_LOGOREAD=1
		dt_blitread
		dt_bg wiretapon wiretap-left wiretap-right
		dt_bg wiretapoff wiretap-off-left wiretap-off-right
		dt_bg wiretap1on wiretap-1
		dt_bg wiretap1off wiretap-1-off
	fi
	case ${DT_GLYPHSET-unicode} in
	blit) if [ "$cells" = 1 ]; then g=${GL["wiretap1$state"]-}; else g=${GL["wiretap$state"]-}; fi ;;
	ascii) g="T" ;;
	*) if [ "$cells" = 1 ]; then g="T"; else g="🚰"; fi ;;		# U+1F6B0 POTABLE WATER, a tap: the unicode and nerd sets' two-cell spot
	esac
	ret "$g"
}

# The pane tile wears the one-cell tap (Blit 0.3.53: wiretap-1, wiretap-1-off), a "T" elsewhere: the glyph is read once, when the pane is registered.
if command -v cp_pane > /dev/null; then
	tile := wtp_logo off 1
	cp_pane wiretap "Wiretap" "${tile:-T}" app
fi

# The module is the package's (`mod load wiretap`); WT_MOD names a file for a build tree. Nothing here hardcodes build/ (the rule longwire writes as its adr/0046).
WTP_LOADED=0
fn wtp_load() {
	[ "$WTP_LOADED" = 1 ] && return 0
	mod load "${WT_MOD:-wiretap}" 2> /dev/null || return 1
	WTP_LOADED=1
}

# Where the node's control socket is: WT_SOCK; else the system service's; else this user's own (as the command).
fn wtp_sock() {
	if [ -n "${WT_SOCK:-}" ]; then
		ret "$WT_SOCK"
	elif [ -S /run/wiretap/ctl ]; then
		ret /run/wiretap/ctl
	elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
		ret "$XDG_RUNTIME_DIR/wiretap/ctl"
	else
		ret "$HOME/.wiretap/ctl"
	fi
}

# --- alerts (ADR 0014): read from the same poll, said through the desktop's notifications, nothing in the engine -----------------------------
# Two, each a setting of the pane: a program the machine has never heard talking before (DT_WTNEW), and one uploading a lot (DT_WTBIG: at least WT_BIG
# bytes a second, 4 MB by default, averaged over the engine's last 5 s: rx5 and tx5 are rates). The names already known are kept in a file of their own ($XDG_STATE_HOME/wiretap/known); the first
# run takes everything talking now as known, so it does not announce the whole desktop. A program is told about once, an upload once in ten minutes.
DT_WTNEW="${DT_WTNEW-1}"
DT_WTBIG="${DT_WTBIG-1}"
DT_WTHOST="${DT_WTHOST-0}"
command -v dt_keep > /dev/null && { dt_keep DT_WTNEW; dt_keep DT_WTBIG; dt_keep DT_WTHOST; }
declare -gA WTA_KNOWN WTA_BIGAT
declare -g WTA_READ=0 WTA_SCANT=-1 WTA_FILE=""

declare -g WTP_OPENVIEW=""

# Say a note. With a view (usage, hosts) clicking the note opens the window on that tab, where b blocks or allows what the note is about
# (ADR 0030); with none, or without the window, it opens the pane.
fn wta_say(text, view = "") {
	if ! dt_has dt_notify; then echo "alert: $text" >&2
	elif [ -n "$view" ] && dt_has dt_launch; then dt_notify "$text" wta_open "$view"
	else dt_notify "$text" dt_panelpane wiretap; fi
}

fn wta_open(view) {
	WTP_OPENVIEW=$view
	dt_launch wtview
}

fn wta_file() {
	ret "${WT_KNOWN:-${XDG_STATE_HOME:-$HOME/.local/state}/wiretap/known}"
}

# Is this a public address? Private, loopback, link-local and multicast ones are the local network's own business and never a "new host".
fn wta_public(a) {
	case $a in
	10.* | 127.* | 192.168.* | 169.254.* | 224.* | 225.* | 226.* | 227.* | 228.* | 229.* | 23?.* | 24?.* | 25?.*) return 1 ;;
	172.1[6-9].* | 172.2?.* | 172.3[01].*) return 1 ;;
	::1 | fe[89abAB]?:* | f[cdCD]??:* | [fF][fF]??:*) return 1 ;;
	esac
	return 0
}

# New hosts (DT_WTHOST, off by default: addresses change all the time). A pair of the program that last spoke to an address and the address,
# not seen before, public, after the first run (which takes everything as known). Told in one note a minute at most, with how many; the pairs are kept
# in a file beside the known programs, up to 5000, after which it stops learning and stops telling. ADR 0021.
declare -gA WTA_HKNOWN
declare -g WTA_HREAD=0 WTA_HFULL=0 WTA_HLAST=-1000
declare -gi WTA_HN=0
fn wta_hosts() {
	local f i n a app key first=0 hn=0 hsample=

	[ "$DT_WTHOST" = 1 ] && [ "$WTA_HFULL" = 0 ] || return 0
	wtp_hosts || return 0
	f := wta_file
	f="${f%/*}/hosts"
	if [ "$WTA_HREAD" = 0 ]; then
		WTA_HREAD=1
		if [ -r "$f" ]; then
			while IFS= read -r key; do [ -n "$key" ] && { WTA_HKNOWN["$key"]=1; WTA_HN=$((WTA_HN + 1)); }; done < "$f"
		else
			first=1
		fi
	fi
	for ((i = 0; i < 200; i++)); do
		a := json get WTP_H ".hosts[$i].addr" 2> /dev/null || break
		[ -n "$a" ] || break
		app := json get WTP_H ".hosts[$i].app" ""
		key="$app $a"
		[ -z "${WTA_HKNOWN["$key"]-}" ] || continue
		if [ "$WTA_HN" -ge 5000 ]; then WTA_HFULL=1; break; fi
		WTA_HKNOWN["$key"]=1; WTA_HN=$((WTA_HN + 1))
		mkdir -p "${f%/*}" 2> /dev/null && printf '%s\n' "$key" >> "$f"
		[ "$first" = 1 ] && continue
		wta_public "$a" || continue
		case $app in "(unattributed)") continue ;; esac
		hn=$((hn + 1))
		[ -n "$hsample" ] || hsample="$app to $a"
	done
	if [ "$hn" -gt 0 ] && [ $((SECONDS - WTA_HLAST)) -ge 60 ]; then
		WTA_HLAST=$SECONDS
		if [ "$hn" = 1 ]; then wta_say "New host: $hsample" hosts; else wta_say "$hn new hosts, the first $hsample" hosts; fi
	fi
}

# Called after each poll; looks at the apps once per poll. Returns nothing.
fn wta_scan() {
	local i name tx rx f first=0 big=${WT_BIG:-4000000}

	[ "$WTP_UP" = 1 ] || return 0
	[ "$WTP_T" != "$WTA_SCANT" ] || return 0
	WTA_SCANT=$WTP_T
	f := wta_file
	if [ "$WTA_READ" = 0 ]; then
		WTA_READ=1
		if [ -r "$f" ]; then
			while IFS= read -r name; do [ -n "$name" ] && WTA_KNOWN["$name"]=1; done < "$f"
		else
			first=1
		fi
	fi
	for ((i = 0; i < 64; i++)); do
		name := wtp_app ".apps[$i].name" ""
		[ -n "$name" ] || break
		case $name in "("*) continue ;; esac
		rx := wtp_app ".apps[$i].rx5" 0
		tx := wtp_app ".apps[$i].tx5" 0
		if [ -z "${WTA_KNOWN["$name"]-}" ] && [ $((${rx:-0} + ${tx:-0})) -gt 0 ]; then
			WTA_KNOWN["$name"]=1
			mkdir -p "${f%/*}" 2> /dev/null && printf '%s\n' "$name" >> "$f"
			[ "$first" = 1 ] || [ "$DT_WTNEW" != 1 ] || wta_say "New on the network: $name" usage
		fi
		if [ "$DT_WTBIG" = 1 ] && [ "${tx:-0}" -ge "$big" ] && [ $((SECONDS - ${WTA_BIGAT["$name"]--1000000})) -ge 600 ]; then
			WTA_BIGAT["$name"]=$SECONDS
			rx := wtp_rate "$tx"
			wta_say "$name is uploading: $rx/s" usage
		fi
	done
	wta_hosts
}

declare -g WT_SOCK="${WT_SOCK:-}"
declare -g WTP_S="" WTP_A="" WTP_SER=""	# parsed status, apps, series
declare -gi WTP_T=-1 WTP_UP=0 WTP_MOD=1	# last poll (SECONDS), whether a node answered, whether the module loaded

# Read the node at most once a second: status, apps and the last minute of series. WTP_UP says whether a node answered; WTP_MOD
# whether the module is installed at all (the pane says which of the two is wrong).
fn wtp_poll() {
	local st ap se

	[ "$WTP_T" -lt 0 ] || [ $((SECONDS - WTP_T)) -ge 1 ] || return 0
	WTP_T=$SECONDS
	WT_SOCK := wtp_sock		# looked for every poll: a service started after the desktop is found without a restart
	export WT_SOCK
	if ! wtp_load; then
		WTP_MOD=0; WTP_UP=0
		return 0
	fi
	WTP_MOD=1
	if st := wt status 2> /dev/null && json parse WTP_S "$st" 2> /dev/null; then
		WTP_UP=1
		if ap := wt apps 2> /dev/null; then json parse WTP_A "$ap" 2> /dev/null || WTP_A=""; fi
		if se := wt series 1 60 2> /dev/null; then json parse WTP_SER "$se" 2> /dev/null || WTP_SER=""; fi
		return 0
	fi
	WTP_UP=0
}

# A timescale as the node's resolution and sample count: seconds per sample, samples, and seconds per sample as a rate divisor.
# 1m: 60 one-second samples; 1h: 60 one-minute; 24h: 1440 one-minute; 7d: 168 one-hour.
fn wtp_scale(sc) {
	case $sc in
	1m) ret "1 60" ;;
	1h) ret "60 60" ;;
	24h) ret "60 1440" ;;
	7d) ret "3600 168" ;;
	*) return 1 ;;
	esac
}

declare -ag WTP_RI=() WTP_RO=()		# the last wtp_range: bytes per second, oldest first, at most `cols` of them
declare -g WTP_RKEY="" WTP_RNG="" WTP_RSEEN=-1000000

# The traffic over a timescale (1m, 1h, 24h, 7d), as at most `cols` rates in WTP_RI (down) and WTP_RO (up), oldest first. The
# one-minute scale is read every second, the others every ten. More samples than columns are averaged into columns.
fn wtp_range(sc, int cols) {
	local sp secs cnt body n i j v lo hi sumi sumo grp key every=10

	sp := wtp_scale "$sc" || return 1
	secs=${sp% *}; cnt=${sp#* }
	[ "$sc" = 1m ] && every=1
	key="$sc/$cols"
	if [ "$key" = "$WTP_RKEY" ] && [ $((SECONDS - WTP_RSEEN)) -lt "$every" ]; then return 0; fi
	WTP_RKEY=$key; WTP_RSEEN=$SECONDS
	WTP_RI=(); WTP_RO=()
	[ "$WTP_UP" = 1 ] || return 0
	body := wt series "$secs" "$cnt" 2> /dev/null || return 0
	json parse WTP_RNG "$body" 2> /dev/null || return 0
	n := json get WTP_RNG .count 2> /dev/null || return 0
	[ "${n:-0}" -gt 0 ] || return 0
	[ "$cols" -ge 1 ] || return 0
	grp=$(((n + cols - 1) / cols))
	for ((i = 0; i < n; i += grp)); do
		sumi=0; sumo=0; hi=$((i + grp)); [ "$hi" -gt "$n" ] && hi=$n
		for ((j = i; j < hi; j++)); do
			v := json get WTP_RNG ".in[$j]"; sumi=$((sumi + ${v:-0}))
			v := json get WTP_RNG ".out[$j]"; sumo=$((sumo + ${v:-0}))
		done
		WTP_RI+=($((sumi / ((hi - i) * secs))))
		WTP_RO+=($((sumo / ((hi - i) * secs))))
	done
}

# One value from the status, by path (".in", ".capture"), or the default.
fn wtp_get(path, def = "") {
	local v

	if v := json get WTP_S "$path" 2> /dev/null; then ret "$v"; else ret "$def"; fi
}

# One value from the apps list, by path (".apps[0].name"), or the default.
fn wtp_app(path, def = "") {
	local v

	if v := json get WTP_A "$path" 2> /dev/null; then ret "$v"; else ret "$def"; fi
}

# One value from the last minute of series, by path, or the default.
fn wtp_series(path, def = "") {
	local v

	if v := json get WTP_SER "$path" 2> /dev/null; then ret "$v"; else ret "$def"; fi
}

# The newest value of the series "in" or "out" (bytes in the last second); 0 when there is none yet.
fn wtp_last(dir) {
	local n v

	n := wtp_series .count 0
	[ "${n:-0}" -gt 0 ] || { ret 0; return 0; }
	v := wtp_series ".$dir[$((n - 1))]" 0
	ret "${v:-0}"
}

# 12.3K, 1.2M ...
fn wtp_rate(int b) {
	if [ "$b" -ge 1048576 ]; then ret "$((b / 1048576)).$((b % 1048576 * 10 / 1048576))M"
	elif [ "$b" -ge 1024 ]; then ret "$((b / 1024)).$((b % 1024 * 10 / 1024))K"
	else ret "${b}B"; fi
}

# ---- the firewall section (M2, ADR 0027) ------------------------------------------------------------------------------
# The rules are the file /etc/wiretap/rules (anyone may read it); changing them is `wiretap fw` and the root helper behind pkexec.
# The pane shows them and has one switch: apply them (on) or remove the table (off). WT_FW_STATE (a file that exists when on) is for tests.
fn wtp_fw_rules() {
	local f
	f=${WT_RULES:-/etc/wiretap/rules}
	[ -r "$f" ] && cat "$f"
	return 0
}

fn wtp_fw_active() {
	if [ -n "${WT_FW_STATE:-}" ]; then [ -e "$WT_FW_STATE" ]; return $?; fi
	command -v systemctl > /dev/null 2>&1 && systemctl is-active --quiet wiretap-rules.service 2> /dev/null
}

fn wtp_fw_set(verb) {
	local h
	h=${WT_RULES_HELPER:-/usr/libexec/wiretap-rules}
	if [ ! -x "$h" ]; then wta_say "Wiretap: the firewall helper is not installed"; return 1; fi
	if [ -n "${WT_RULES_HELPER:-}" ]; then "$h" "$verb" < /dev/null > /dev/null 2>&1
	else (pkexec "$h" "$verb" < /dev/null > /dev/null 2>&1 &); fi
}

# adds the Firewall rows at CP[$w][$n..] and returns the new n
fn wtp_fw_rows(int w, int n) {
	local l t k cnt on
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Firewall"; n=$((n + 1))
	cnt=0
	while IFS= read -r l; do
		t=${l%%#*}
		[ -n "${t//[[:space:]]/}" ] || continue
		cnt=$((cnt + 1))
	done < <(wtp_fw_rules)
	if [ "$cnt" = 0 ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Rules"; CP[$w][$n]["val"]="none: everything is allowed (wiretap fw block HOST PORT --tcp)"; n=$((n + 1))
		ret "$n"; return 0
	fi
	on=off; wtp_fw_active && on=on
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Firewall"; CP[$w][$n]["val"]=$on; CP[$w][$n]["key"]=DT_WTFW; n=$((n + 1))
	k=0
	while IFS= read -r l; do
		t=${l%%#*}
		[ -n "${t//[[:space:]]/}" ] || continue
		k=$((k + 1))
		[ "$k" -le 5 ] || break
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="  $k"; CP[$w][$n]["val"]=$t; n=$((n + 1))
	done < <(wtp_fw_rules)
	if [ "$cnt" -gt 5 ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="  ..."; CP[$w][$n]["val"]="$((cnt - 5)) more (wiretap fw)"; n=$((n + 1))
	fi
	ret "$n"
}

# ---- block and allow from the window (ADR 0028, 0029) ------------------------------------------------------------------
# What the kept rules say about the things the window shows. A host row is marked by the rule "ACTION out any any ADDR any" and a program
# by "ACTION out any cgroup:PATH any any": exactly the rules the window writes, so a rule you wrote by hand with a port or a protocol is
# listed in the Firewall tab but does not put a mark on a row (it blocks only part of what the row stands for).
declare -gA WTP_BLK WTP_ALW WTP_BLKG WTP_ALWG WTP_CG
fn wtp_fw_blocked() {
	local l t f1 f2 f3 f4 f5 f6 f7
	WTP_BLK=(); WTP_ALW=(); WTP_BLKG=(); WTP_ALWG=()
	while IFS= read -r l; do
		t=${l%%#*}
		f7=""
		read -r f1 f2 f3 f4 f5 f6 f7 <<< "$t"
		[ -z "$f7" ] && [ "$f2 $f3" = "out any" ] || continue
		if [ "$f4" = any ] && [ "$f6" = any ] && [ "$f5" != any ] && [ -n "$f5" ]; then
			[ "$f1" = block ] && WTP_BLK[$f5]=1
			[ "$f1" = allow ] && WTP_ALW[$f5]=1
		elif [ "$f5 $f6" = "any any" ] && [ "${f4:0:7}" = "cgroup:" ]; then
			[ "$f1" = block ] && WTP_BLKG[${f4:7}]=1
			[ "$f1" = allow ] && WTP_ALWG[${f4:7}]=1
		fi
	done < <(wtp_fw_rules)
	return 0
}

# The cgroup of a process, when it is one a rule can name on its own: its own scope or service, not a login session, the user manager
# or a slice (blocking those would block everything in them), and only characters the rule accepts. Empty when it is not.
fn wtp_fw_cgroup(pid) {
	local l p b
	case $pid in ''|*[!0-9]*) return 1 ;; esac
	[ -r "/proc/$pid/cgroup" ] || return 1
	p=""
	while IFS= read -r l; do
		case $l in 0::*) p=${l#0::} ;; esac
	done < "/proc/$pid/cgroup"
	p=${p% (deleted)}
	[ -n "$p" ] || return 1
	b=${p##*/}
	case $b in
	session-*.scope | user@*.service | init.scope | *.slice) return 1 ;;
	*.scope | *.service) ;;
	*) return 1 ;;
	esac
	case $p in *[!A-Za-z0-9_.@:/-]*) return 1 ;; esac
	echo "$p"
}

# The same, remembered by pid (a process does not change its cgroup scope; the table is emptied when it grows).
fn wtp_fw_cg(pid) {
	local c
	if [ -z "${WTP_CG[$pid]+x}" ]; then
		[ "${#WTP_CG[@]}" -gt 400 ] && WTP_CG=()
		c=$(wtp_fw_cgroup "$pid") || c=""
		WTP_CG[$pid]=$c
	fi
	echo "${WTP_CG[$pid]}"
}

# The whole new rules text, checked by the engine and handed to the helper (pkexec, in the background; a test helper runs at once).
# Returns 1 with a notification when it cannot.
fn wtp_fw_commit(text) {
	local h f
	h=${WT_RULES_HELPER:-/usr/libexec/wiretap-rules}
	if [ ! -x "$h" ]; then wta_say "Wiretap: the firewall helper is not installed"; return 1; fi
	wtp_load || { wta_say "Wiretap: the module is not installed"; return 1; }
	f=$(mktemp) || return 1
	printf '%s\n' "$text" > "$f"
	if ! wt fwrender "$f" > /dev/null; then
		wta_say "Wiretap: ${ERRMSG:-the rule is not valid}"
		rm -f "$f"
		return 1
	fi
	rm -f "$f"
	if [ -n "${WT_RULES_HELPER:-}" ]; then printf '%s\n' "$text" | "$h" apply > /dev/null 2>&1
	else (printf '%s\n' "$text" | pkexec "$h" apply > /dev/null 2>&1 &); fi
}

fn wtp_fw_add(rule) {
	local old
	old=$(wtp_fw_rules)
	if [ -z "$old" ]; then wtp_fw_commit "$rule"; else wtp_fw_commit "$old
$rule"; fi
}

# Take out every line that is exactly this rule (spacing aside), keeping the other rules and the comments.
fn wtp_fw_del(rule) {
	local l t new f1 f2 f3 f4 f5 f6 f7
	new=""
	while IFS= read -r l; do
		t=${l%%#*}
		f7=""
		read -r f1 f2 f3 f4 f5 f6 f7 <<< "$t"
		if [ -z "$f7" ] && [ "$f1 $f2 $f3 $f4 $f5 $f6" = "$rule" ]; then continue; fi
		new="$new$l
"
	done < <(wtp_fw_rules)
	wtp_fw_commit "$new"
}

# Take out the Nth rule (comments and blank lines are not counted), as the Firewall tab numbers them.
fn wtp_fw_remove(n) {
	local l t k new
	case $n in ''|*[!0-9]*) return 1 ;; esac
	k=0; new=""
	while IFS= read -r l; do
		t=${l%%#*}
		if [ -n "${t//[[:space:]]/}" ]; then
			k=$((k + 1))
			[ "$k" = "$n" ] && continue
		fi
		new="$new$l
"
	done < <(wtp_fw_rules)
	[ "$n" -ge 1 ] && [ "$n" -le "$k" ] || return 1
	wtp_fw_commit "$new"
}

# Block ADDR for every program, or take that rule out if it is there (ADR 0028).
fn wtp_fw_host(addr) {
	wtp_fw_blocked
	if [ -n "${WTP_BLK[$addr]:-}" ]; then wtp_fw_del "block out any any $addr any"
	else wtp_fw_add "block out any any $addr any"; fi
}

fn wiretap_rows(int w) {
	local n=0 i k name

	wtp_poll
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Engine"; n=$((n + 1))
	if [ "$WTP_MOD" = 0 ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Module"; CP[$w][$n]["val"]="not installed (apt install wiretap)"; n=$((n + 1))
		ret "$n"; return 0
	fi
	if [ "$WTP_UP" = 0 ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Service"; CP[$w][$n]["val"]="not running (wiretap on, or join the group wiretap and log in again)"; n=$((n + 1))
		n := wtp_fw_rows "$w" "$n"
		ret "$n"; return 0
	fi
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Service"; CP[$w][$n]["val"] := wtp_get .version "?"; n=$((n + 1))
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Capture"; CP[$w][$n]["val"] := wtp_get .capture_note "$(wtp_get .capture)"; n=$((n + 1))
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Unreadable processes"; CP[$w][$n]["val"] := wtp_get .processes_unreadable 0; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Right now"; n=$((n + 1))
	k := wtp_last in
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Down"; CP[$w][$n]["val"] := wtp_rate "$k"; n=$((n + 1))
	k := wtp_last out
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Up"; CP[$w][$n]["val"] := wtp_rate "$k"; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Top apps (down, last 5 s)"; n=$((n + 1))
	for ((i = 0; i < 5; i++)); do
		name := wtp_app ".apps[$i].name" ""
		[ -n "$name" ] || break
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="$name"
		k := wtp_app ".apps[$i].rx5" 0; CP[$w][$n]["val"] := wtp_rate "${k:-0}"
		n=$((n + 1))
	done
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Alerts"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="A program talks for the first time"; CP[$w][$n]["val"]=$([ "$DT_WTNEW" = 1 ] && echo on || echo off); CP[$w][$n]["key"]=DT_WTNEW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="A program uploads a lot"; CP[$w][$n]["val"]=$([ "$DT_WTBIG" = 1 ] && echo on || echo off); CP[$w][$n]["key"]=DT_WTBIG; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="A program reaches a new public host"; CP[$w][$n]["val"]=$([ "$DT_WTHOST" = 1 ] && echo on || echo off); CP[$w][$n]["key"]=DT_WTHOST; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Menu Bar Item"; CP[$w][$n]["val"]=$([ "$DT_WTBAR" = 1 ] && echo on || echo off); CP[$w][$n]["key"]=DT_WTBAR; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="  with a graph beside the tap"; CP[$w][$n]["val"]=$([ "$DT_WTGAUGE" = 1 ] && echo on || echo off); CP[$w][$n]["key"]=DT_WTGAUGE; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="  with the download rate"; CP[$w][$n]["val"]=$([ "$DT_WTRATE" = 1 ] && echo on || echo off); CP[$w][$n]["key"]=DT_WTRATE; n=$((n + 1))
	n := wtp_fw_rows "$w" "$n"
	ret "$n"
}

fn wiretap_do(int? w = "", k = "", int? dir = "") {
	case $k in
	DT_WTBAR | DT_WTGAUGE | DT_WTRATE | DT_WTNEW | DT_WTBIG | DT_WTHOST) cp_toggle "$k" ;;
	DT_WTFW) if wtp_fw_active; then wtp_fw_set off; else wtp_fw_set on; fi ;;
	esac
	cp_save
}

fn wiretap_drop(int? w = "", int? r = "", int? c = "", k = "") { :; }
