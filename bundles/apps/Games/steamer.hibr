#!/usr/bin/env hibr
#
# steamer -- your Steam games on the hibr desktop: the ones installed here and
# the ones your account owns, as a tree of Installed and Not installed. Each
# row says what it does: Install or Play, and a store page arrow. The Steam
# client does the work. Settings are in Control Panel > Steamer.
# See docs/PLAN.md and docs/decisions/.
#
# The API key is never stored here, in the settings, or on a command line. It
# is read from its own file, and the owned-games call runs inside fetch.

strict

app steamer "Your Steam games as a tree: install, play, and the store page" 0.5.6
# modules: fetch
# part: control-panel/steamerset.hibr
command -v dt_app > /dev/null && dt_app steamer "Steamer" 24 70 once "▶"

# The Steam folder: ~/.local/share/Steam, or ~/.steam/steam if that one is missing.
stm_defroot() {
	if [ -d "$HOME/.local/share/Steam/steamapps" ]; then echo "$HOME/.local/share/Steam"
	else echo "$HOME/.steam/steam"; fi
}
declare -g STM_ID="${STM_ID-}" STM_ROOT="${STM_ROOT-}"
[ -n "$STM_ROOT" ] || STM_ROOT=$(stm_defroot)
STM_LINUXONLY="${STM_LINUXONLY-0}"
command -v dt_keep > /dev/null && dt_keep STM_ID STM_ROOT STM_LINUXONLY
command -v dt_ticker > /dev/null && dt_ticker stm_tick

# fetch sets this for the caller; under strict it must be declared (fetch README).
declare -g FETCH_STATUS=""
declare -g STM_KEYFILE="${XDG_CONFIG_HOME:-$HOME/.config}/hibr/steamer-key"
declare -g STM_KEY="" STM_WIN="${STM_WIN-}" STM_NOTE="" STM_STATUS=""
declare -g STM_TOP=0 STM_SEL=0 STM_VER=0 STM_BUILT=-1 STM_SEEN=-1
declare -g STM_BUILTQ="" STM_VIS_ROWS=10 STM_OPEN_INST=1 STM_OPEN_NOT=1
declare -g STM_N_INST=0 STM_N_NOT=0 STM_BUSY=""
declare -g STM_NEXT=0 STM_PJOB=0 STM_PLAY="" STM_PROG="" STM_PROGOLD=""
declare -g STM_PEND="" STM_PENDNAME="" STM_PENDT=0 STM_PENDSEEN=0 STM_PLATJOB=0
declare -g STM_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hibr/steamer/linux.tsv"
declare -gA STM_LINUX=() STM_PL=()
declare -ga STM_IDS=() STM_NAMES=() STM_INST=() STM_SCAN=()
declare -ga STM_OIDS=() STM_ONAMES=() STM_ROWK=() STM_ROWR=()
declare -gA STM_OWN STM_RT=() STM_PT=()
# Steam collections (decision 0020): id, name and the games of each, and which are open.
declare -ga STM_CATID=() STM_CATNAME=() STM_CATGAMES=()
declare -gA STM_CATOPEN=() STM_HIDDEN=() STM_CATN=()

# The key, read into STM_KEY. Nothing is printed. For callbacks only.
stm_apikey() {
	STM_KEY=""
	[ -r "$STM_KEYFILE" ] && read -r STM_KEY < "$STM_KEYFILE"
	return 0
}

# Every Steam folder that holds games: the main one, and each library folder
# listed in its steamapps/libraryfolders.vdf (a second drive, for example).
stm_libroots() {
	local line p
	local -A seen=()
	{
		printf '%s\n' "$STM_ROOT"
		[ -r "$STM_ROOT/steamapps/libraryfolders.vdf" ] &&
			while IFS= read -r line; do
				case $line in
				*'"path"'*) p=${line#*\"path\"}; p=${p#*\"}; p=${p%\"*}; [ -n "$p" ] && printf '%s\n' "$p" ;;
				esac
			done < "$STM_ROOT/steamapps/libraryfolders.vdf"
	} | while IFS= read -r p; do
		[ -n "${seen[$p]-}" ] && continue
		seen[$p]=1
		printf '%s\n' "$p"
	done
}

# Read one appmanifest (Valve KeyValues: lines of "key" "value") into ACF_ID,
# ACF_NAME (the first of each), ACF_D (BytesDownloaded), ACF_T (BytesToDownload)
# and ACF_SF (StateFlags). No program is started. Hibr has no KeyValues reader.
declare -g ACF_ID="" ACF_NAME="" ACF_D=0 ACF_T=0 ACF_SF=0
declare -ga M=()
stm_acf() {
	local l
	ACF_ID=""; ACF_NAME=""; ACF_D=0; ACF_T=0; ACF_SF=0
	while IFS= read -r l; do
		match "$l" '^\s*"([^"]*)"\s*"([^"]*)"' || continue
		case ${M[1]} in
		appid) [ -n "$ACF_ID" ] || ACF_ID=${M[2]} ;;
		name) [ -n "$ACF_NAME" ] || ACF_NAME=${M[2]} ;;
		BytesDownloaded) ACF_D=${M[2]} ;;
		BytesToDownload) ACF_T=${M[2]} ;;
		StateFlags) ACF_SF=${M[2]} ;;
		esac
	done < "$1"
}

# A job: the installed games, one "appid<TAB>name" a line.
stm_scan() {
	local f root
	while IFS= read -r root; do
		for f in "$root"/steamapps/appmanifest_*.acf; do
			[ -r "$f" ] || continue
			stm_acf "$f"
			[ -n "$ACF_ID" ] && printf '%s\t%s\n' "$ACF_ID" "$ACF_NAME"
		done
	done < <(stm_libroots)
}

# A job: the user's Steam collections, one "id TAB name TAB appid appid ..." a
# line. They are in userdata/<account>/config/cloudstorage/cloud-storage-namespace-1.json,
# a list of [key, {value: "<json text>"}] pairs; the account number is the Steam ID
# less 76561197960265728. Deleted entries have no value; dynamic collections
# (with a filterSpec) have no fixed games and are left out. Read only.
stm_collections() {
	local f n i key val ids name dyn d
	local -A C=() V=()
	for d in "$STM_ROOT"/userdata/$((STM_ID - 76561197960265728)) "$STM_ROOT"/userdata/*; do
		f=$d/config/cloudstorage/cloud-storage-namespace-1.json
		[ -r "$f" ] && break
		f=""
	done
	[ -n "$f" ] || return 0
	json parse C < "$f" 2> /dev/null || return 0
	n := json len C .
	for ((i = 0; i < ${n:-0}; i++)); do
		key := json get C ".[$i][0]" 2> /dev/null
		case $key in user-collections.*) ;; *) continue ;; esac
		val := json get C ".[$i][1].value" 2> /dev/null
		[ -n "$val" ] || continue
		json parse V "$val" 2> /dev/null || continue
		dyn := json type V .filterSpec 2> /dev/null
		[ -z "$dyn" ] || [ "$dyn" = null ] || continue
		name := json get V .name 2> /dev/null
		ids := json get V .added 2> /dev/null
		ids=${ids#[}; ids=${ids%]}; ids=${ids//,/ }
		printf '%s\t%s\t%s\n' "${key#user-collections.}" "$name" "$ids"
	done
}

# A job: the owned games as the Web API's JSON. The key stays inside fetch,
# and a failure says nothing that would show the URL.
stm_owned() {
	local key
	need fetch || { echo "fetch is not available"; return 2; }
	read -r key 2> /dev/null < "$STM_KEYFILE" || { echo "no API key"; return 2; }
	[ -n "$STM_ID" ] || { echo "no Steam ID"; return 2; }
	fetch get "https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key=$key&steamid=$STM_ID&include_appinfo=1&include_played_free_games=1&format=json" 2> /dev/null || { echo "could not reach Steam"; return 1; }
}

# A job: start a Steam URL. setsid -f detaches it, so the job ends at once.
stm_launch() {
	command -v steam > /dev/null 2>&1 || { echo "steam is not installed here"; return 1; }
	setsid -f steam "$1" > /dev/null 2>&1
}

# Build the one list: installed games first, then owned games not installed.
stm_merge() {
	local i id
	local -A seen=()
	STM_IDS=(); STM_NAMES=(); STM_INST=()
	for i in "${!STM_SCAN[@]}"; do
		id=${STM_SCAN[$i]%%$'\t'*}
		seen["$id"]=1
		STM_IDS+=("$id"); STM_NAMES+=("${STM_SCAN[$i]#*$'\t'}"); STM_INST+=(1)
	done
	for i in "${!STM_OIDS[@]}"; do
		id=${STM_OIDS[$i]}
		[ -n "${seen[$id]-}" ] && continue
		STM_IDS+=("$id"); STM_NAMES+=("${STM_ONAMES[$i]}"); STM_INST+=(0)
	done
	STM_VER=$((STM_VER + 1))
	return 0
}

# Read the Linux answers kept from earlier runs, so a known game is not asked again.
stm_loadlinux() {
	local id v
	[ -r "$STM_CACHE" ] || return 0
	while IFS=$'\t' read -r id v; do
		[ -n "$id" ] && STM_LINUX[$id]=$v
	done < "$STM_CACHE"
	return 0
}

# A job: does each game run on Linux? One line per game: appid TAB 1, 0 or ?.
# The store answers one game a request, and not several at once, so this asks
# one at a time with a pause between, in batches the callback starts again.
stm_platforms() {
	local id v url reply
	local nap=sleep
	need sys 2> /dev/null && nap=sleepms
	reply="${STM_CACHE%/*}/platform-reply.json"
	mkdir -p "${STM_CACHE%/*}" 2> /dev/null
	for id in "$@"; do
		url="https://store.steampowered.com/api/appdetails?appids=$id&filters=platforms"
		v=?
		if fetch get "$url" > "$reply" 2> /dev/null; then
			if json parse STM_PL < "$reply" 2> /dev/null; then
				v := json get STM_PL "$id.data.platforms.linux" 2> /dev/null
			fi
		fi
		case $v in
		true) printf '%s\t1\n' "$id" ;;
		false) printf '%s\t0\n' "$id" ;;
		*) printf '%s\t?\n' "$id" ;;
		esac
		if [ "$nap" = sleepms ]; then sleepms 1000; else sleep 1; fi
	done
	rm -f "$reply"
}

# Ask for the Linux answers of owned games that have none yet, when the filter is on.
stm_platform_need() {
	local id n
	local -a unknown=()
	[ "$STM_LINUXONLY" = 1 ] || return 0
	[ "$STM_PLATJOB" = 0 ] || return 0
	for id in "${STM_IDS[@]}"; do
		[ -n "${STM_LINUX[$id]-}" ] || unknown+=("$id")
	done
	[ "${#unknown[@]}" -gt 0 ] || return 0
	[ "${#unknown[@]}" -gt 40 ] && unknown=("${unknown[@]:0:40}")
	STM_PLATJOB=1
	n := dt_job steamer:platforms "$STM_WIN" steamer_platforms_done stm_platforms "${unknown[@]}"
	return 0
}

fn steamer_platforms_done(int n, int st) {
	local f id v
	STM_PLATJOB=0
	[ "$st" = 0 ] || { dt_want 0; return 0; }
	f := dt_jobfile "$n" out
	mkdir -p "${STM_CACHE%/*}" 2> /dev/null
	while IFS=$'\t' read -r id v; do
		[ -n "$id" ] || continue
		STM_LINUX[$id]=$v
		[ "$v" = "?" ] || printf '%s\t%s\n' "$id" "$v" >> "$STM_CACHE" 2> /dev/null
	done < "$f"
	stm_visible_reset
	stm_platform_need
	dt_want 0
}

stm_visible_reset() {
	STM_BUILT=-1
}

# The tree: two branches, Installed and Not installed, each with its games as
# leaves. The search leaves only the games it matches. Rebuilt only when the
# data, the query or the open branches changed.
stm_visible() {
	local i q lq name k c g
	local -a inst=() notin=() cm=() gl=()
	local -A idx=() ok=()
	q := dt_searchq "$STM_WIN"
	[ "$STM_BUILT" = "$STM_VER" ] && [ "$STM_BUILTQ" = "$q" ] && return 0
	if [ "$STM_BUILTQ" != "$q" ] && [ "$STM_BUILT" != -1 ]; then STM_SEL=0; STM_TOP=0; fi
	lq=${q,,}
	for i in "${!STM_IDS[@]}"; do
		[ -n "${STM_HIDDEN[${STM_IDS[$i]}]-}" ] && continue
		if [ "$STM_LINUXONLY" = 1 ] && [ "${STM_LINUX[${STM_IDS[$i]}]-}" = 0 ]; then continue; fi
		if [ -n "$lq" ]; then
			name=${STM_NAMES[$i],,}
			case $name in *"$lq"*) ;; *) continue ;; esac
		fi
		ok[${STM_IDS[$i]}]=1; idx[${STM_IDS[$i]}]=$i
		if [ "${STM_INST[$i]}" = 1 ]; then inst+=("$i"); else notin+=("$i"); fi
	done
	STM_ROWK=(); STM_ROWR=()
	# Collections first, each with the owned games that pass the search and filters;
	# an empty one is left out while a search is on. A game in two collections shows in both.
	for c in "${!STM_CATID[@]}"; do
		cm=()
		read -ra gl <<< "${STM_CATGAMES[$c]}"
		for g in "${gl[@]}"; do
			[ -n "${ok[$g]-}" ] && cm+=("${idx[$g]}")
		done
		[ -n "$lq" ] && [ "${#cm[@]}" = 0 ] && continue
		STM_CATN[$c]=${#cm[@]}
		STM_ROWK+=(B); STM_ROWR+=("c$c")
		if [ "${STM_CATOPEN[$c]-0}" = 1 ]; then
			for k in "${cm[@]}"; do STM_ROWK+=(L); STM_ROWR+=("$k"); done
		fi
	done
	STM_ROWK+=(B); STM_ROWR+=(inst)
	if [ "$STM_OPEN_INST" = 1 ]; then
		for k in "${inst[@]}"; do STM_ROWK+=(L); STM_ROWR+=("$k"); done
	fi
	STM_ROWK+=(B); STM_ROWR+=(notin)
	if [ "$STM_OPEN_NOT" = 1 ]; then
		for k in "${notin[@]}"; do STM_ROWK+=(L); STM_ROWR+=("$k"); done
	fi
	STM_N_INST=${#inst[@]}
	STM_N_NOT=${#notin[@]}
	[ "$STM_SEL" -ge "${#STM_ROWK[@]}" ] && STM_SEL=$(( ${#STM_ROWK[@]} > 0 ? ${#STM_ROWK[@]} - 1 : 0 ))
	STM_BUILT=$STM_VER; STM_BUILTQ=$q
	return 0
}

# Start both jobs: the scan always, the owned list when a key and ID are set.
stm_start() {
	local n
	n := dt_job steamer:scan "$STM_WIN" steamer_scanned stm_scan
	n := dt_job steamer:cats "$STM_WIN" steamer_cats_done stm_collections
	stm_apikey
	if [ -n "$STM_ID" ] && [ -n "$STM_KEY" ]; then
		n := dt_job steamer:owned "$STM_WIN" steamer_owned_done stm_owned
	else
		STM_NOTE="Set your Steam ID and API key in Control Panel > Steamer"
	fi
	return 0
}

fn steamer_scanned(int n, int st) {
	local f line
	STM_SCAN=()
	if [ "$st" = 0 ]; then
		f := dt_jobfile "$n" out
		while IFS= read -r line; do
			[ -n "$line" ] && STM_SCAN+=("$line")
		done < "$f"
	else
		STM_STATUS="could not read the library"
	fi
	stm_merge
	dt_want 0
}

fn steamer_cats_done(int n, int st) {
	local f cid cname cgames g
	local -a gl=()
	STM_CATID=(); STM_CATNAME=(); STM_CATGAMES=(); STM_HIDDEN=()
	if [ "$st" = 0 ]; then
		f := dt_jobfile "$n" out
		while IFS=$'\t' read -r cid cname cgames; do
			[ -n "$cid" ] || continue
			if [ "$cid" = hidden ]; then
				read -ra gl <<< "$cgames"
				for g in "${gl[@]}"; do STM_HIDDEN[$g]=1; done
				continue
			fi
			[ -n "$cgames" ] || continue
			STM_CATID+=("$cid"); STM_CATNAME+=("$cname"); STM_CATGAMES+=("$cgames")
		done < "$f"
	fi
	stm_merge
	dt_want 0
}

fn steamer_owned_done(int n, int st) {
	local f cnt i gid gname grt gpt
	if [ "$st" != 0 ]; then
		STM_NOTE="could not load owned games"
		dt_want 0
		return 0
	fi
	f := dt_jobfile "$n" out
	json parse STM_OWN < "$f" 2> /dev/null || { STM_NOTE="Steam replied with something that is not JSON"; dt_want 0; return 0; }
	cnt := json len STM_OWN response.games
	STM_OIDS=(); STM_ONAMES=(); STM_RT=(); STM_PT=()
	for ((i = 0; i < ${cnt:-0}; i++)); do
		gid := json get STM_OWN "response.games.$i.appid"
		gname := json get STM_OWN "response.games.$i.name"
		grt := json get STM_OWN "response.games.$i.rtime_last_played"
		gpt := json get STM_OWN "response.games.$i.playtime_forever"
		STM_OIDS+=("$gid")
		STM_ONAMES+=("$gname")
		STM_RT[$gid]=${grt:-0}
		STM_PT[$gid]=${gpt:-0}
	done
	STM_NOTE="${#STM_OIDS[@]} owned"
	stm_merge
	stm_platform_need
	dt_want 0
}

fn steamer_launched(int n, int st) {
	[ "$st" = 0 ] || dt_notep high "Steam could not start"
	dt_want 0
}

# Send a Steam URL to the client through a job.
stm_do() {
	local n
	n := dt_job steamer:launch "$STM_WIN" steamer_launched stm_launch "$1"
}

# A job: what is downloading (dl TAB appid TAB name TAB percent) and what is
# running (run TAB appid), read from the manifests and from /proc. Runs off
# the desktop's own process, so the ticker never reads a file or forks.
stm_progress() {
	local root f blob
	local -A seen=()
	while IFS= read -r root; do
		for f in "$root"/steamapps/appmanifest_*.acf; do
			[ -r "$f" ] || continue
			stm_acf "$f"
			[ -n "$ACF_ID" ] || continue
			if [ "$ACF_T" -gt 0 ] && [ "$ACF_D" -lt "$ACF_T" ]; then
				printf 'dl\t%s\t%s\t%d\n' "$ACF_ID" "$ACF_NAME" $(( ACF_D * 100 / ACF_T ))
			fi
			[ "$ACF_SF" = 4 ] && printf 'ok\t%s\t%s\t0\n' "$ACF_ID" "$ACF_NAME"
		done
	done < <(stm_libroots)
	# The running game: SteamAppId in a process's environment. Each file is read whole
	# (about 9 ms for all of /proc); registry.vdf's RunningAppID is not there until Steam has run.
	for f in /proc/[0-9]*/environ; do
		blob=""
		read -r -N 1000000 blob 2> /dev/null < "$f"
		case $blob in
		*SteamAppId=*)
			match "$blob" 'SteamAppId=([1-9][0-9]*)' || continue
			[ -n "${seen[${M[1]}]-}" ] && continue
			seen[${M[1]}]=1
			printf 'run\t%s\n' "${M[1]}" ;;
		esac
	done 2> /dev/null
}

# The ticker, on every pass of the desktop. It returns at once unless this
# window is open and its time has come; the reading itself is a job.
stm_tick() {
	local now=$EPOCHSECONDS n
	[ -n "$STM_WIN" ] || return 0
	dt_hidden "$STM_WIN" && return 0
	dt_away "$STM_WIN" && return 0
	[ "$STM_PJOB" = 0 ] || return 0
	[ "$now" -ge "$STM_NEXT" ] || return 0
	STM_NEXT=$((now + 3))
	n := dt_job steamer:progress "$STM_WIN" steamer_progress_done stm_progress
	STM_PJOB=1
}

fn steamer_progress_done(int n, int st) {
	local f kind id name pct text="" k play="" ok=0 seen=0 nowt
	STM_PJOB=0
	[ "$st" = 0 ] || return 0
	f := dt_jobfile "$n" out
	while IFS=$'\t' read -r kind id name pct; do
		case $kind in
		dl)
			text="Installing $name  ${pct}%"
			[ "$id" = "$STM_PEND" ] && seen=1 ;;
		ok) [ "$id" = "$STM_PEND" ] && ok=1 ;;
		run) play=$id ;;
		esac
	done < "$f"
	if [ -n "$play" ]; then
		for k in "${!STM_IDS[@]}"; do
			[ "${STM_IDS[$k]}" = "$play" ] && { text="${text:+$text   }Playing ${STM_NAMES[$k]}"; break; }
		done
	fi
	STM_PLAY=$play
	nowt=$EPOCHSECONDS
	if [ -n "$STM_PEND" ]; then
		if [ "$seen" = 1 ]; then
			STM_PENDSEEN=1
		elif [ "$ok" = 1 ] || { [ "$STM_PENDSEEN" = 1 ] && [ "$seen" = 0 ]; }; then
			STM_STATUS="Installed: $STM_PENDNAME"
			STM_PEND=""; STM_PENDSEEN=0
			n := dt_job steamer:scan "$STM_WIN" steamer_scanned stm_scan
		elif [ $((nowt - STM_PENDT)) -gt 180 ]; then
			STM_STATUS="Steam has not started ${STM_PENDNAME}: check Steam"
			STM_PEND=""; STM_PENDSEEN=0
		fi
	fi
	if [ "$text" != "$STM_PROGOLD" ]; then
		STM_PROGOLD=$text
		STM_BUSY=$text
		dt_want 0
	fi
	[ -n "$STM_BUSY" ] || [ -n "$STM_PEND" ] && dt_want 3000
}

# Steam is a graphical program, and this desktop has no display server for it.
# Until the display hand-over exists (decision 0019), starting Steam from here
# cannot work, and tried twice it broke Steam's first start. Say so, and stop.
stm_can_launch() {
	if [ -z "${DISPLAY-}" ] && [ -z "${WAYLAND_DISPLAY-}" ]; then
		STM_STATUS="Steam can't start here yet: waiting for blit's display hand-over"
		dt_notep high "Steam can't start here yet: waiting for blit's display hand-over"
		dt_want 30
		return 1
	fi
	return 0
}

# The action a leaf offers: Play when installed, Install when not.
stm_act_leaf() {
	local idx=$1 id=${STM_IDS[$1]}
	stm_can_launch || return 0
	if [ "${STM_INST[$idx]}" = 1 ]; then
		stm_do "steam://rungameid/$id"
		STM_STATUS="Starting ${STM_NAMES[$idx]} in Steam"
	else
		stm_do "steam://install/$id"
		STM_PEND=$id; STM_PENDNAME=${STM_NAMES[$idx]}; STM_PENDT=$EPOCHSECONDS; STM_PENDSEEN=0
		STM_STATUS="Install requested: ${STM_NAMES[$idx]}"
		dt_want 3000
	fi
}

# The store page, in the desktop's browser, or copied when no browser is here.
stm_store() {
	local idx=$1
	dt_openlink "https://store.steampowered.com/app/${STM_IDS[$idx]}"
	STM_STATUS="store page for ${STM_NAMES[$idx]}"
}

# Enter or a click on a branch opens or closes it.
stm_toggle() {
	case $1 in
	inst) [ "$STM_OPEN_INST" = 1 ] && STM_OPEN_INST=0 || STM_OPEN_INST=1 ;;
	notin) [ "$STM_OPEN_NOT" = 1 ] && STM_OPEN_NOT=0 || STM_OPEN_NOT=1 ;;
	c*) [ "${STM_CATOPEN[${1:1}]-0}" = 1 ] && STM_CATOPEN[${1:1}]=0 || STM_CATOPEN[${1:1}]=1 ;;
	esac
	STM_BUILT=-1
}

fn steamer_open(id, arg) {
	STM_WIN=$id
	stm_loadlinux
	stm_start
}

fn steamer_draw(id, int h, int w, row, col) {
	local r i n vis end line hrs act lead mark ref k last tick avail idx
	local stxt rw tk rt
	STM_WIN=$id
	tk=${GL[tick]-}
	rt=${GL[right]-}
	dt_wclear "$id"
	stm_visible
	n=${#STM_ROWK[@]}
	end=$((h - 3))
	vis=$((end - 2))
	[ "$vis" -lt 1 ] && vis=1
	STM_VIS_ROWS=$vis
	if [ "$STM_SEL" != "$STM_SEEN" ]; then
		STM_TOP := dt_scrollfit "$STM_TOP" "$n" "$vis" "$STM_SEL"
		STM_SEEN=$STM_SEL
	else
		STM_TOP := dt_scrollfit "$STM_TOP" "$n" "$vis"
	fi

	console pen "$DT_DIM" "$DT_FACE"
	stxt="${STM_STATUS:-$STM_NOTE}"
	if [ -n "$stxt" ] && [ $((w - ${#stxt} - 1)) -gt 2 ]; then
		console put -p "w$id" 1 $((w - ${#stxt} - 1)) "$stxt"
	fi

	r=2
	i=$STM_TOP
	while [ "$i" -lt "$n" ] && [ "$r" -le "$end" ]; do
		k=${STM_ROWK[$i]}
		ref=${STM_ROWR[$i]}
		if [ "$k" = B ]; then
			if [ "${ref:0:1}" = c ]; then
				mark := dt_treepre 0 1 "${STM_CATOPEN[${ref:1}]-0}" 0 ""
				line="${mark}${STM_CATNAME[${ref:1}]} (${STM_CATN[${ref:1}]-0})"
			elif [ "$ref" = inst ]; then
				mark := dt_treepre 0 1 "$STM_OPEN_INST" 0 ""
				line="${mark}Installed ($STM_N_INST)"
			else
				mark := dt_treepre 0 1 "$STM_OPEN_NOT" 0 ""
				line="${mark}Not installed ($STM_N_NOT)"
			fi
			console pen "$DT_INK" "$DT_FACE"
			console put -p "w$id" "$r" 2 "${line:0:$((w - 4))}"
			dt_wreg "$id" "$r" 1 $((w - 2)) "br:$ref"
		else
			idx=$ref
			last=0
			if [ $((i + 1)) -ge "$n" ] || [ "${STM_ROWK[$((i + 1))]}" = B ]; then last=1; fi
			lead := dt_treelead 1 "$last" ""
			hrs=0
			[ -n "${STM_PT[${STM_IDS[$idx]}]-}" ] && hrs=$(( ${STM_PT[${STM_IDS[$idx]}]} / 60 ))
			if [ "${STM_INST[$idx]}" = 1 ]; then
				act=Play; tick="$tk "
			else
				act=Install; tick=""
			fi
			line="${lead}${tick}${STM_NAMES[$idx]}"
			[ "$hrs" -gt 0 ] && line="$line  ${hrs} h"
			rw="$act  $rt"
			avail=$((w - ${#rw} - 4))
			line=${line:0:$avail}
			if [ "$i" = "$STM_SEL" ]; then
				console pen "$DT_SELINK" "$DT_ACTIVE"
			else
				console pen "$DT_INK" "$DT_FACE"
			fi
			[ -n "$STM_PLAY" ] && [ "${STM_IDS[$idx]}" = "$STM_PLAY" ] && line="$line  [playing]"
			console put -p "w$id" "$r" 2 "$line"
			console put -p "w$id" "$r" $((w - ${#rw} - 1)) "$rw"
			dt_wreg "$id" "$r" 2 $((w - 4 - ${#rw})) "row:$i"
			dt_wreg "$id" "$r" $((w - ${#rw} - 1)) "${#act}" "act:$idx"
			dt_wreg "$id" "$r" $((w - 2)) 1 "store:$idx"
			dt_tip "$id" "act:$idx" "$act ${STM_NAMES[$idx]}"
			dt_tip "$id" "store:$idx" "Store page"
		fi
		r=$((r + 1)); i=$((i + 1))
	done
	if [ "$n" = 0 ]; then
		console pen "$DT_DIM" "$DT_FACE"
		console put -p "w$id" 2 2 "No games here. Press r to refresh, or / to search."
	fi

	dt_scrollbar "$id" 2 $((w - 1)) "$vis" "$n" "$vis" "$STM_TOP" list 1

	console pen "$DT_DIM" "$DT_FACE"
	console put -p "w$id" $((h - 2)) 2 "${STM_BUSY:-}"

	dt_searchdraw "$id" $((h - 1)) "$w"
}

fn steamer_key(id, key) {
	if dt_searchkey "$id" "$key"; then
		dt_want 0
		return 0
	fi
	case $key in
	up) [ "$STM_SEL" -gt 0 ] && STM_SEL=$((STM_SEL - 1)) ;;
	down) [ "$STM_SEL" -lt $((${#STM_ROWK[@]} - 1)) ] && STM_SEL=$((STM_SEL + 1)) ;;
	enter)
		if [ "${STM_ROWK[$STM_SEL]-}" = B ]; then stm_toggle "${STM_ROWR[$STM_SEL]}"
		elif [ "${STM_ROWK[$STM_SEL]-}" = L ]; then stm_act_leaf "${STM_ROWR[$STM_SEL]}"; fi ;;
	o) [ "${STM_ROWK[$STM_SEL]-}" = L ] && stm_store "${STM_ROWR[$STM_SEL]}" ;;
	c) stm_can_launch && stm_do "steam://open/" ;;
	r) stm_start; STM_STATUS="refreshing" ;;
	/) dt_searchopen "$id" ;;
	esac
	dt_want 0
}

fn steamer_click(id, int row, int col, button) {
	local tag idx
	tag := dt_hit "$id" "$row" "$col"
	case $tag in
	br:*) stm_toggle "${tag#br:}" ;;
	act:*) stm_act_leaf "${tag#act:}" ;;
	store:*) stm_store "${tag#store:}" ;;
	row:*) idx=${tag#row:}; STM_SEL=$((idx)) ;;
	esac
	dt_want 0
}

fn steamer_wheel(id, dir, int? r = "", int? c = "") {
	local n
	n=${#STM_ROWK[@]}
	STM_TOP := dt_scrollmove "$dir" "$STM_TOP" "$n" "$STM_VIS_ROWS" "$DT_SCROLLWHEEL"
	dt_want 0
}

fn steamer_scroll(id, key, int top) {
	STM_TOP=$top
	dt_want 0
}

fn steamer_find(int id) {
	dt_searchopen "$id"
	return 0
}

fn steamer_close(id) {
	STM_WIN=""
}

steamer_menus() {
	dt_menu "File"
	dt_item "Refresh" r stm_start
	dt_sep
	dt_item "Close" w dt_close_focused
	dt_editmenu
	dt_menu "View"
	dt_item "Installed" I steamer_branch "$DT_FOCUS" inst
	dt_item "Not Installed" N steamer_branch "$DT_FOCUS" notin
	dt_menu "Game"
	dt_item "Play or Install" p steamer_key "$DT_FOCUS" enter
	dt_item "Store Page" o steamer_key "$DT_FOCUS" o
	dt_item "Open Steam" c steamer_key "$DT_FOCUS" c
}

fn steamer_branch(int id, b) {
	stm_toggle "$b"
	dt_want 0
}
