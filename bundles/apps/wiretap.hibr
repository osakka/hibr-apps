#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# wiretap (the window) -- the big view the drop-down has no room for: a mirrored download/upload graph over a timescale you pick
# (1 minute, 1 hour, 24 hours, 7 days) and a Usage table of every app the engine has seen. It reads the node only through the
# Control Panel pane's reader (control-panel/wiretap.hibr, ADR 0005): wtp_poll, wtp_range, wtp_app. Read-only: it never changes a
# firewall. Every key is in the menus (docs/adr/0049 of longwire, the habit kept here).
#
# Called wtview: wiretap is the Control Panel pane's prefix (a pane with a wiretap_draw would be taken for one that draws itself).
#
#   1 2 3 4   timescale: 1 minute, 1 hour, 24 hours, 7 days      g  Graph      u  Usage      tab  the other one
#   up/down   in Usage, the selected row                         

strict

app wtview "Wiretap: a live graph and every app's traffic" 0.7.3
# needs: control-panel/wiretap
if command -v dt_app > /dev/null; then
	tile=
	if command -v wtp_logo > /dev/null; then tile := wtp_logo off 1; fi
	dt_app wtview "Wiretap" 26 90 once "${tile:-T}"
fi

declare -gA WV
WV_SCALES=(1m 1h 24h 7d)
WV_LABELS=("1 min" "1 hour" "24 hours" "7 days")
WV_AGE=("60 s ago" "1 h ago" "24 h ago" "7 d ago")
WV_AGESEC=(60 3600 86400 604800)
WV_AGEFMT=("" "%H:%M" "%a %H:%M" "%a %d %b")
declare -ag WV_BLK=(" " "▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")

fn wtview_open(int id, ...rest) {
	WV[$id]["view"]=graph
	case $WTP_OPENVIEW in usage | hosts) WV[$id]["view"]=$WTP_OPENVIEW ;; esac
	WTP_OPENVIEW=""
	WV[$id]["scale"]=0
	WV[$id]["sel"]=0
	WV[$id]["top"]=0
	return 0
}

fn wv_put(int id, int r, int c, text) { console put -p "w$id" "$r" "$c" "$text"; }

# eighths (0..8) of a rows-high column for v of max, for row r counted from the axis outward.
fn wv_eighths(int v, int max, int rows, int r) {
	local e=$((max > 0 ? v * rows * 8 / max : 0))

	e=$((e - r * 8))
	[ "$e" -gt 8 ] && e=8
	[ "$e" -lt 0 ] && e=0
	ret "$e"
}

# The tab row and the timescale buttons.
fn wv_head(int id, int w) {
	local s=${WV[$id]["scale"]} i col

	console pen "$DT_INK" "$DT_FACE" bold
	if [ "${WV[$id]["view"]}" = graph ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_DIM" "$DT_FACE"; fi
	wv_put "$id" 1 2 " Graph "
	if [ "${WV[$id]["view"]}" = usage ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_DIM" "$DT_FACE"; fi
	wv_put "$id" 1 10 " Usage "
	if [ "${WV[$id]["view"]}" = hosts ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_DIM" "$DT_FACE"; fi
	wv_put "$id" 1 18 " Hosts "
	if [ "${WV[$id]["view"]}" = firewall ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_DIM" "$DT_FACE"; fi
	wv_put "$id" 1 26 " Firewall "
	col=$((w - 34))
	for i in 0 1 2 3; do
		if [ "$i" = "$s" ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_DIM" "$DT_FACE"; fi
		wv_put "$id" 1 "$col" " ${WV_LABELS[$i]} "
		col=$((col + ${#WV_LABELS[$i]} + 3))
	done
}

# wv_since SCALE [NOW]: the clock time at the left edge of the graph (ADR 0035). printf's own time conversion, so no fork in a frame.
# The 1-minute graph keeps "60 s ago", which is clearer than a clock for a minute.
fn wv_since(int s, int now = 0) {
	local t
	if [ -z "${WV_AGEFMT[$s]}" ]; then ret "${WV_AGE[$s]}"; return 0; fi
	[ "$now" -gt 0 ] || printf -v now '%(%s)T' -1
	printf -v t "%(${WV_AGEFMT[$s]})T" "$((now - WV_AGESEC[s]))"
	ret "$t"
}

# One half of the ribbon (ADR 0020): the last minute, a column a second, each column stacked from the axis outwards in the colour of
# each program in rank order and the rest (the buckets and the programs that did not make the top eight) in DIM on top. dir is rx
# (above the axis, hung upwards) or tx (below it). A cell is coloured by the program at its middle, the top cell by the top of the column.
fn wv_stack(int id, dir, int half, int cols, int n, int max) {
	local i j rr row k e ht lo cum pos c tot sum seg
	local -a bound

	for ((i = 0; i < n; i++)); do
		if [ "$dir" = rx ]; then tot=${WTP_RI[$i]}; else tot=${WTP_RO[$i]}; fi
		ht=$((tot * half * 8 / max))
		cum=0; bound=()
		for ((j = 0; j < WTP_ASCNT; j++)); do
			if [ "$dir" = rx ]; then v=${WTP_ASRX[$((j * WTP_ASSTR + i))]}; else v=${WTP_ASTX[$((j * WTP_ASSTR + i))]}; fi
			cum=$((cum + v * half * 8 / max))
			bound+=("$cum")
		done
		for ((rr = 0; rr < half; rr++)); do
			e=$((ht - rr * 8)); [ "$e" -gt 8 ] && e=8
			[ "$e" -gt 0 ] || break
			pos=$((rr * 8 + 4)); [ "$pos" -ge "$ht" ] && pos=$((ht - 1))
			c=-1
			for ((j = 0; j < WTP_ASCNT; j++)); do
				if [ "$pos" -lt "${bound[$j]}" ]; then c=$j; break; fi
			done
			if [ "$c" -ge 0 ]; then hue := wtp_hue "${WTP_ASN[$c]}"; else hue=$DT_DIM; fi
			k=$((cols - n + i))
			if [ "$dir" = rx ]; then
				row=$((3 + (half - 1 - rr)))
				console pen "$hue" "$DT_FACE"; wv_put "$id" "$row" $((2 + k)) "${WV_BLK[$e]}"
			else
				row=$((4 + half + rr))
				console pen "$DT_FACE" "$hue"; wv_put "$id" "$row" $((2 + k)) "${WV_BLK[$((8 - e))]}"
			fi
		done
	done
}

fn wv_graph(int id, int h, int w) {
	local half=$(((h - 5) / 2)) cols=$((w - 4)) n i j k rr row max=1 v e line inr outr hue by=0 s=${WV[$id]["scale"]}

	wtp_range "${WV_SCALES[$s]}" "$cols"
	n=${#WTP_RI[@]}
	for v in "${WTP_RI[@]}" "${WTP_RO[@]}"; do [ "$v" -gt "$max" ] && max=$v; done
	inr=0; outr=0
	[ "$n" -gt 0 ] && { inr=${WTP_RI[$((n - 1))]}; outr=${WTP_RO[$((n - 1))]}; }
	if [ "${WV[$id]["by"]:-1}" = 1 ] && [ "$n" -gt 0 ]; then
		wtp_appseries "${WV_SCALES[$s]}" "$cols"
		if wtp_aslive "${WV_SCALES[$s]}" "$cols" && [ "$WTP_ASSTR" = "$n" ]; then by=1; fi
	fi
	console pen "$DT_GOOD" "$DT_FACE" bold
	line := wtp_rate "$inr"
	wv_put "$id" 2 2 "↓ $line/s"
	console pen "$DT_INFO" "$DT_FACE" bold
	line := wtp_rate "$outr"
	wv_put "$id" 2 18 "↑ $line/s"
	console pen "$DT_DIM" "$DT_FACE"
	line := wtp_rate "$max"
	wv_put "$id" 2 $((w - ${#line} - 8)) "scale $line/s"
	if [ "$by" = 1 ]; then
		wv_stack "$id" rx "$half" "$cols" "$n" "$max"
	else
	for ((rr = half - 1; rr >= 0; rr--)); do
		row=$((3 + (half - 1 - rr)))
		for ((i = 0; i < n; i++)); do
			k=$((cols - n + i))
			e := wv_eighths "${WTP_RI[$i]}" "$max" "$half" "$rr"
			[ "$e" -gt 0 ] && { console pen "$DT_GOOD" "$DT_FACE"; wv_put "$id" "$row" $((2 + k)) "${WV_BLK[$e]}"; }
		done
	done
	fi
	console pen "$DT_DIM" "$DT_FACE"
	line=
	for ((i = 0; i < cols; i++)); do line+="${GL[hline]:-─}"; done
	wv_put "$id" $((3 + half)) 2 "$line"
	if [ "$by" = 1 ]; then
		wv_stack "$id" tx "$half" "$cols" "$n" "$max"
	else
	for ((rr = 0; rr < half; rr++)); do
		row=$((4 + half + rr))
		for ((i = 0; i < n; i++)); do
			k=$((cols - n + i))
			e := wv_eighths "${WTP_RO[$i]}" "$max" "$half" "$rr"
			[ "$e" -gt 0 ] && { console pen "$DT_FACE" "$DT_INFO"; wv_put "$id" "$row" $((2 + k)) "${WV_BLK[$((8 - e))]}"; }
		done
	done
	fi
	console pen "$DT_DIM" "$DT_FACE"
	line := wv_since "$s"
	wv_put "$id" $((4 + 2 * half)) 2 "$line"
	wv_put "$id" $((4 + 2 * half)) $((cols - 1)) "now"
	if [ "$by" = 1 ]; then			# the legend: a swatch and the name of each program in the ribbon, in the row of the time labels
		k=12
		for ((j = 0; j < WTP_ASCNT; j++)); do
			[ $((k + ${#WTP_ASN[$j]} + 3)) -lt $((cols - 6)) ] || break
			hue := wtp_hue "${WTP_ASN[$j]}"
			console pen "$hue" "$DT_FACE"; wv_put "$id" $((4 + 2 * half)) "$k" "▌"
			console pen "$DT_INK" "$DT_FACE"; wv_put "$id" $((4 + 2 * half)) $((k + 1)) "${WTP_ASN[$j]}"
			k=$((k + ${#WTP_ASN[$j]} + 3))
		done
	fi
}

fn wv_usage(int id, int h, int w) {
	local n i name pid rx tx rx5 tx5 vis=$((h - 5)) top=${WV[$id]["top"]} sel=${WV[$id]["sel"]} line r hue cg

	wtp_fw_blocked
	n := json len WTP_A .apps 2> /dev/null || n=0
	n=${n:-0}
	WV[$id]["n"]=$n
	console pen "$DT_DIM" "$DT_FACE" bold
	printf -v line "  %-20s %7s %10s %10s %11s %11s" APP PID "DOWN/s" "UP/s" "DOWN total" "UP total"
	wv_put "$id" 2 2 "$line"
	[ "$sel" -ge "$n" ] && sel=$((n > 0 ? n - 1 : 0))
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	WV[$id]["sel"]=$sel; WV[$id]["top"]=$top
	for ((i = top; i < n && i < top + vis; i++)); do
		name := wtp_app ".apps[$i].name" ""
		pid := wtp_app ".apps[$i].pid" 0
		rx := wtp_app ".apps[$i].rx" 0; tx := wtp_app ".apps[$i].tx" 0
		rx5 := wtp_app ".apps[$i].rx5" 0; tx5 := wtp_app ".apps[$i].tx5" 0
		r=$((3 + i - top))
		if [ "$i" = "$sel" ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_INK" "$DT_FACE"; fi
		local a b c d
		a := wtp_rate "$rx5"; b := wtp_rate "$tx5"; c := wtp_rate "$rx"; d := wtp_rate "$tx"
		[ "$pid" = 0 ] && pid=-
		printf -v line "  %-20s %7s %10s %10s %11s %11s" "${name:0:20}" "$pid" "$a" "$b" "$c" "$d"
		wv_put "$id" "$r" 2 "$line"
		hue := wtp_hue "$name"
		if [ "$i" = "$sel" ]; then console pen "$hue" "$DT_INK"; else console pen "$hue" "$DT_FACE"; fi
		wv_put "$id" "$r" 2 "▌"
		wtp_fw_cg "$pid"; cg=$WTP_CGV
		if [ -n "$cg" ] && [ -n "${WTP_BLKG[$cg]:-}" ]; then console pen "$DT_WARN" "$DT_FACE"; [ "$i" = "$sel" ] && console pen "$DT_WARN" "$DT_INK"; wv_put "$id" "$r" 1 "✕"
		elif [ -n "$cg" ] && [ -n "${WTP_ALWG[$cg]:-}" ]; then console pen "$DT_GOOD" "$DT_FACE"; [ "$i" = "$sel" ] && console pen "$DT_GOOD" "$DT_INK"; wv_put "$id" "$r" 1 "✓"; fi
	done
	wv_foot "$id" "$h"
}

# Who the machine talks to (ADR 0016, 0018): one row per remote address, the program that last spoke to it, bytes each way, and how long ago.
# Addresses, until n is pressed (ADR 0036): then the names on screen are looked up in a job and kept, as `wiretap hosts --names` does in a terminal.
fn wv_hosts(int id, int h, int w) {
	local n i a app rx tx last now vis=$((h - 5)) top=${WV[$id]["top"]} sel=${WV[$id]["sel"]} line r b c hue nm

	wtp_hosts
	wtp_fw_blocked
	n := json len WTP_H .hosts 2> /dev/null || n=0
	n=${n:-0}
	WV[$id]["n"]=$n
	console pen "$DT_DIM" "$DT_FACE" bold
	printf -v line "%-39s   %-12s %10s %10s %8s" ADDRESS APP "DOWN" "UP" "AGO"
	wv_put "$id" 2 2 "$line"
	if [ "$n" = 0 ]; then
		console pen "$DT_DIM" "$DT_FACE"
		wv_put "$id" 4 2 "No remote hosts yet."
		return 0
	fi
	now := json get WTP_H .now
	if [ "${WV[$id]["names"]:-0}" = 1 ]; then		# ADR 0036: the addresses on screen that are not known yet
		local want=()
		for ((i = ${WV[$id]["top"]:-0}; i < n && i < ${WV[$id]["top"]:-0} + vis; i++)); do a := json get WTP_H ".hosts[$i].addr"; want+=("$a"); done
		wtp_names_want "${want[@]}"
	fi
	[ "$sel" -ge "$n" ] && sel=$((n > 0 ? n - 1 : 0))
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	WV[$id]["sel"]=$sel; WV[$id]["top"]=$top
	for ((i = top; i < n && i < top + vis; i++)); do
		a := json get WTP_H ".hosts[$i].addr"
		app := json get WTP_H ".hosts[$i].app"
		rx := json get WTP_H ".hosts[$i].rx"; tx := json get WTP_H ".hosts[$i].tx"
		last := json get WTP_H ".hosts[$i].last"
		r=$((3 + i - top))
		if [ "$i" = "$sel" ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_INK" "$DT_FACE"; fi
		b := wtp_rate "$rx"; c := wtp_rate "$tx"
		nm=
		[ "${WV[$id]["names"]:-0}" = 1 ] && [ "${WTP_NAME[$a]:--}" != - ] && nm=${WTP_NAME[$a]}
		printf -v line "%-39s   %-12s %10s %10s %7ss" "${nm:-$a}" "${app:0:12}" "$b" "$c" "$((now - last))"
		wv_put "$id" "$r" 2 "$line"
		hue := wtp_hue "$app"
		if [ "$i" = "$sel" ]; then console pen "$hue" "$DT_INK"; else console pen "$hue" "$DT_FACE"; fi
		wv_put "$id" "$r" 42 "▌"
		if [ -n "${WTP_BLK[$a]:-}" ]; then
			console pen "$DT_WARN" "$DT_FACE"; [ "$i" = "$sel" ] && console pen "$DT_WARN" "$DT_INK"
			wv_put "$id" "$r" 1 "✕"
		elif [ -n "${WTP_ALW[$a]:-}" ]; then
			console pen "$DT_GOOD" "$DT_FACE"; [ "$i" = "$sel" ] && console pen "$DT_GOOD" "$DT_INK"
			wv_put "$id" "$r" 1 "✓"
		fi
	done
	wv_foot "$id" "$h"
}

# The line at the foot of the Usage, Hosts and Firewall tabs: the question being asked, a note, or a hint.
fn wv_foot(int id, int h) {
	local wiz=${WV[$id]["wiz"]:-} lab=${WV[$id]["wlab"]:-} act=${WV[$id]["wact"]:-} t

	console pen "$DT_DIM" "$DT_FACE"
	case $wiz in
	act) t="$lab:  b = block   a = allow   esc = cancel" ;;
	proto) t="${act^} $lab, which protocol?  a = any   t = tcp   u = udp   esc = cancel" ;;
	port) t="${act^} $lab on which port?  digits then enter, or just enter for any   [${WV[$id]["wport"]:-}]" ;;
	del) t="$lab has a rule.  y = remove it   any other key = cancel" ;;
	rm) t="Remove rule ${WV[$id]["wnum"]}?  y = remove   any other key = cancel" ;;
	*)
		if [ -n "${WV[$id]["note"]:-}" ]; then t=${WV[$id]["note"]}
		else
			case ${WV[$id]["view"]} in
			firewall) t="x removes the rule   space turns the firewall on or off   (add rules from Usage or Hosts: b)" ;;
			usage) t="b blocks or allows the selected program (asks for a password)" ;;
			*) t="b blocks or allows the selected host (asks for a password)   n shows names (asks your name server)" ;;
			esac
		fi ;;
	esac
	case $wiz in act | proto | port | del | rm) console pen "$DT_WARN" "$DT_FACE" bold ;; esac
	wv_put "$id" $((h - 2)) 2 "${t:0:$((${WV[$id]["w"]:-90} - 4))}"
}

# The Firewall tab (ADR 0029): is it on, and the kept rules, numbered, one to a row.
fn wv_fw(int id, int h, int w) {
	local l t k=0 vis=$((h - 6)) top=${WV[$id]["top"]} sel=${WV[$id]["sel"]} line r f1 f2 f3 f4 f5 f6 f7 who cnt=0 st

	wtp_fw_read
	while IFS= read -r l; do t=${l%%#*}; [ -n "${t//[[:space:]]/}" ] && cnt=$((cnt + 1)); done <<< "$WTP_FWTXT"
	WV[$id]["n"]=$cnt
	if [ "$cnt" = 0 ]; then st="No rules: everything is allowed."; console pen "$DT_DIM" "$DT_FACE" bold
	elif wtp_fw_active; then st="Firewall ON: $cnt rules are loaded."; console pen "$DT_GOOD" "$DT_FACE" bold
	else st="Firewall OFF: $cnt rules are kept but not loaded (space turns it on)."; console pen "$DT_WARN" "$DT_FACE" bold; fi
	wv_put "$id" 2 2 "$st"
	console pen "$DT_DIM" "$DT_FACE" bold
	printf -v line "%3s  %-6s %-4s %-5s %-34s %-24s %s" "#" ACTION DIR PROTO WHO HOST PORT
	wv_put "$id" 3 2 "$line"
	[ "$sel" -ge "$cnt" ] && sel=$((cnt > 0 ? cnt - 1 : 0))
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	WV[$id]["sel"]=$sel; WV[$id]["top"]=$top
	while IFS= read -r l; do
		t=${l%%#*}
		[ -n "${t//[[:space:]]/}" ] || continue
		k=$((k + 1))
		[ $((k - 1)) -ge "$top" ] && [ $((k - 1)) -lt $((top + vis)) ] || continue
		f7=""; read -r f1 f2 f3 f4 f5 f6 f7 <<< "$t"
		who=$f4; [ "${#who}" -gt 34 ] && who="…${who: -33}"
		printf -v line "%3d  %-6s %-4s %-5s %-34s %-24s %s" "$k" "$f1" "$f2" "$f3" "$who" "${f5:0:24}" "$f6"
		r=$((4 + k - 1 - top))
		if [ $((k - 1)) = "$sel" ]; then console pen "$DT_FACE" "$DT_INK"; else console pen "$DT_INK" "$DT_FACE"; fi
		wv_put "$id" "$r" 2 "$line"
	done <<< "$WTP_FWTXT"
	wv_foot "$id" "$h"
}

# One key of the question being asked (the Block or Allow dialog, a removal).
fn wv_wiz(int id, key) {
	local wiz=${WV[$id]["wiz"]}

	case $key in escape | esc) WV[$id]["wiz"]=; return 0 ;; esac
	case $wiz in
	act)
		case $key in
		b) WV[$id]["wact"]=block; WV[$id]["wiz"]=proto ;;
		a) WV[$id]["wact"]=allow; WV[$id]["wiz"]=proto ;;
		*) WV[$id]["wiz"]= ;;
		esac ;;
	proto)
		case $key in
		a) WV[$id]["wproto"]=any; WV[$id]["wport"]=any; wv_finish "$id" ;;
		t) WV[$id]["wproto"]=tcp; WV[$id]["wport"]=; WV[$id]["wiz"]=port ;;
		u) WV[$id]["wproto"]=udp; WV[$id]["wport"]=; WV[$id]["wiz"]=port ;;
		*) WV[$id]["wiz"]= ;;
		esac ;;
	port)
		case $key in
		enter | $'\r' | $'\n') [ -n "${WV[$id]["wport"]}" ] || WV[$id]["wport"]=any; wv_finish "$id" ;;
		backspace) WV[$id]["wport"]=${WV[$id]["wport"]%?} ;;
		[0-9]) [ "${#WV[$id]["wport"]}" -lt 5 ] && WV[$id]["wport"]=${WV[$id]["wport"]}$key ;;
		*) : ;;
		esac ;;
	del)
		WV[$id]["wiz"]=
		if [ "$key" = y ]; then
			if wtp_fw_del "${WV[$id]["wrule"]}"; then WV[$id]["note"]="Asked to remove the rule; it goes when the administrator agrees."
			else WV[$id]["note"]="That did not work (see the notification)."; fi
		fi ;;
	rm)
		WV[$id]["wiz"]=
		if [ "$key" = y ]; then
			if wtp_fw_remove "${WV[$id]["wnum"]}"; then WV[$id]["note"]="Asked to remove rule ${WV[$id]["wnum"]}."
			else WV[$id]["note"]="That did not work (see the notification)."; fi
		fi ;;
	esac
	return 0
}

fn wv_finish(int id) {
	local rule
	rule="${WV[$id]["wact"]} out ${WV[$id]["wproto"]} ${WV[$id]["wwho"]} ${WV[$id]["whost"]} ${WV[$id]["wport"]}"
	WV[$id]["wiz"]=
	if wtp_fw_add "$rule"; then WV[$id]["note"]="Asked to add: $rule. The mark follows when it is applied."
	else WV[$id]["note"]="That did not work (see the notification)."; fi
}

# b: what is selected becomes the target of a rule, or, if it already has the simple rule, of its removal.
fn wv_begin(int id) {
	local v=${WV[$id]["view"]} n=${WV[$id]["n"]:-0} a pid name cg act

	wtp_fw_blocked
	WV[$id]["note"]=
	case $v in
	hosts)
		[ "$n" -gt 0 ] || return 0
		a := json get WTP_H ".hosts[${WV[$id]["sel"]}].addr"
		WV[$id]["wlab"]=$a; WV[$id]["wwho"]=any; WV[$id]["whost"]=$a
		act=""; [ -n "${WTP_BLK[$a]:-}" ] && act=block; [ -n "${WTP_ALW[$a]:-}" ] && act=allow
		if [ -n "$act" ]; then WV[$id]["wrule"]="$act out any any $a any"; WV[$id]["wlab"]="$a is on the $act list"; WV[$id]["wiz"]=del
		else WV[$id]["wiz"]=act; fi ;;
	usage)
		[ "$n" -gt 0 ] || return 0
		name := wtp_app ".apps[${WV[$id]["sel"]}].name" ""
		pid := wtp_app ".apps[${WV[$id]["sel"]}].pid" 0
		wtp_fw_cg "$pid"; cg=$WTP_CGV
		if [ -z "$cg" ]; then
			WV[$id]["note"]="$name does not run in a control group of its own, so a rule cannot name it alone (ADR 0029)."
			return 0
		fi
		WV[$id]["wlab"]=$name; WV[$id]["wwho"]="cgroup:$cg"; WV[$id]["whost"]=any
		act=""; [ -n "${WTP_BLKG[$cg]:-}" ] && act=block; [ -n "${WTP_ALWG[$cg]:-}" ] && act=allow
		if [ -n "$act" ]; then WV[$id]["wrule"]="$act out any cgroup:$cg any any"; WV[$id]["wlab"]="$name is on the $act list"; WV[$id]["wiz"]=del
		else WV[$id]["wiz"]=act; fi ;;
	*) WV[$id]["note"]="Pick a program in Usage or a host in Hosts, then b." ;;
	esac
	return 0
}

fn wtview_draw(int id, int h, int w, int row, int col) {
	WV[$id]["w"]=$w
	wtp_poll
	console pen "$DT_INK" "$DT_FACE"
	if [ "$WTP_MOD" = 0 ]; then
		wv_put "$id" 2 2 "The wiretap module is not installed. Install the package (apt install wiretap)."
		return 0
	fi
	if [ "$WTP_SEEN" = 0 ]; then		# the first reading is on its way (a job): say nothing wrong meanwhile
		dt_want 100
		return 0
	fi
	if [ "$WTP_UP" = 0 ]; then
		console pen "$DT_WARN" "$DT_FACE"
		wv_put "$id" 2 2 "No wiretap node answers."
		console pen "$DT_INK" "$DT_FACE"
		wv_put "$id" 4 2 "Start one with:  wiretap on"
		wv_put "$id" 5 2 "or, for the service, join the group wiretap and log in again."
		dt_want 2000
		return 0
	fi
	wv_head "$id" "$w"
	case ${WV[$id]["view"]} in
	usage) wv_usage "$id" "$h" "$w" ;;
	hosts) wv_hosts "$id" "$h" "$w" ;;
	firewall) wv_fw "$id" "$h" "$w" ;;
	*) wv_graph "$id" "$h" "$w" ;;
	esac
	dt_want 1000
}

fn wtview_key(int id, key) {
	local n=${WV[$id]["n"]:-0}

	if [ -n "${WV[$id]["wiz"]:-}" ]; then wv_wiz "$id" "$key"; return 0; fi
	WV[$id]["note"]=
	case $key in
	b) wv_begin "$id" ;;
	f) WV[$id]["view"]=firewall; WV[$id]["sel"]=0; WV[$id]["top"]=0 ;;
	x) if [ "${WV[$id]["view"]}" = firewall ] && [ "$n" -gt 0 ]; then WV[$id]["wnum"]=$((${WV[$id]["sel"]} + 1)); WV[$id]["wiz"]=rm; fi ;;
	" " | space) if [ "${WV[$id]["view"]}" = firewall ] && [ "$n" -gt 0 ]; then
		if wtp_fw_active; then wtp_fw_set off; WV[$id]["note"]="Asked to turn the firewall off."; else wtp_fw_set on; WV[$id]["note"]="Asked to turn the firewall on."; fi
	fi ;;
	1|2|3|4) WV[$id]["scale"]=$((key - 1)); WTP_RKEY= ;;
	g) WV[$id]["view"]=graph ;;
	u) WV[$id]["view"]=usage ;;
	h) WV[$id]["view"]=hosts ;;
	n) if [ "${WV[$id]["view"]}" = hosts ]; then
		if [ "${WV[$id]["names"]:-0}" = 1 ]; then WV[$id]["names"]=0; WV[$id]["note"]="Names off: addresses only."
		else WV[$id]["names"]=1; WV[$id]["note"]="Names on: your name server is asked about the addresses shown (n turns it off)."; fi
	fi ;;
	c) WV[$id]["by"]=$((1 - ${WV[$id]["by"]:-1})) ;;
	tab|$'\t') case ${WV[$id]["view"]} in graph) WV[$id]["view"]=usage ;; usage) WV[$id]["view"]=hosts ;; hosts) WV[$id]["view"]=firewall ;; *) WV[$id]["view"]=graph ;; esac ;;
	up) [ "${WV[$id]["sel"]}" -gt 0 ] && WV[$id]["sel"]=$((WV[$id]["sel"] - 1)) ;;
	down) [ "${WV[$id]["sel"]}" -lt $((n - 1)) ] && WV[$id]["sel"]=$((WV[$id]["sel"] + 1)) ;;
	*) return 1 ;;
	esac
	return 0
}

fn wtview_click(int id, int row, int col, button) {
	local w=${WV[$id]["w"]:-90} i c

	if [ "$row" = 1 ]; then
		if [ "$col" -ge 2 ] && [ "$col" -le 9 ]; then WV[$id]["view"]=graph; return 0; fi
		if [ "$col" -ge 10 ] && [ "$col" -le 17 ]; then WV[$id]["view"]=usage; return 0; fi
		if [ "$col" -ge 18 ] && [ "$col" -le 25 ]; then WV[$id]["view"]=hosts; return 0; fi
		if [ "$col" -ge 26 ] && [ "$col" -le 35 ]; then WV[$id]["view"]=firewall; WV[$id]["sel"]=0; WV[$id]["top"]=0; return 0; fi
		c=$((w - 34))
		for i in 0 1 2 3; do
			if [ "$col" -ge "$c" ] && [ "$col" -lt $((c + ${#WV_LABELS[$i]} + 2)) ]; then WV[$id]["scale"]=$i; WTP_RKEY=; return 0; fi
			c=$((c + ${#WV_LABELS[$i]} + 3))
		done
	elif [ "${WV[$id]["view"]}" != graph ] && [ "$row" -ge 3 ]; then
		WV[$id]["sel"]=$((${WV[$id]["top"]} + row - 3))
	fi
	return 0
}

wtview_menus() {
	local id=$DT_FOCUS

	dt_menu "File"
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
	dt_menu "View"
	dt_mark "Graph" g "$([ "${WV[$id]["view"]}" = graph ] && echo 1 || echo 0)" wtview_key "$id" g
	dt_mark "Usage" u "$([ "${WV[$id]["view"]}" = usage ] && echo 1 || echo 0)" wtview_key "$id" u
	dt_mark "Colour by Program (1 minute)" c "${WV[$id]["by"]:-1}" wtview_key "$id" c
	dt_mark "Hosts" h "$([ "${WV[$id]["view"]}" = hosts ] && echo 1 || echo 0)" wtview_key "$id" h
	dt_mark "Firewall" f "$([ "${WV[$id]["view"]}" = firewall ] && echo 1 || echo 0)" wtview_key "$id" f
	dt_sep
	dt_mark "1 Minute" 1 "$([ "${WV[$id]["scale"]}" = 0 ] && echo 1 || echo 0)" wtview_key "$id" 1
	dt_mark "1 Hour" 2 "$([ "${WV[$id]["scale"]}" = 1 ] && echo 1 || echo 0)" wtview_key "$id" 2
	dt_mark "24 Hours" 3 "$([ "${WV[$id]["scale"]}" = 2 ] && echo 1 || echo 0)" wtview_key "$id" 3
	dt_mark "7 Days" 4 "$([ "${WV[$id]["scale"]}" = 3 ] && echo 1 || echo 0)" wtview_key "$id" 4
	if dt_has panel_goto; then
		dt_sep
		dt_item "Wiretap Settings${GL[ellipsis]}" s dt_panelpane wiretap
	fi
}
